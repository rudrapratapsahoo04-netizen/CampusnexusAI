
<% layout("layouts/boilerplate") -%>

<style>
/* =========================================================
   CAMPUSNEXUS STUDENT REGISTRATION
   UI / DESIGN ONLY
   FORM LOGIC PRESERVED
   ========================================================= */

.registration-page {
    --cn-primary: #4f46e5;
    --cn-primary-dark: #3730a3;
    --cn-secondary: #7c3aed;
    --cn-accent: #06b6d4;
    --cn-pink: #ec4899;
    --cn-green: #10b981;
    --cn-text: #172033;
    --cn-muted: #64748b;
    --cn-border: rgba(148, 163, 184, 0.22);

    position: relative;
    min-height: 100vh;
    overflow: hidden;
    padding: 35px 0 80px;

    background:
        radial-gradient(
            circle at 5% 8%,
            rgba(79, 70, 229, 0.22),
            transparent 25%
        ),
        radial-gradient(
            circle at 95% 10%,
            rgba(6, 182, 212, 0.20),
            transparent 27%
        ),
        radial-gradient(
            circle at 90% 90%,
            rgba(236, 72, 153, 0.17),
            transparent 28%
        ),
        radial-gradient(
            circle at 10% 90%,
            rgba(124, 58, 237, 0.18),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            #f8fbff 0%,
            #eef2ff 40%,
            #f7f3ff 70%,
            #f0fdfa 100%
        );
}


/* =========================================================
   BACKGROUND GRID
   ========================================================= */

.registration-page::before {
    content: "";
    position: absolute;
    inset: 0;

    pointer-events: none;

    opacity: 0.32;

    background-image:
        linear-gradient(
            rgba(79, 70, 229, 0.035) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(79, 70, 229, 0.035) 1px,
            transparent 1px
        );

    background-size: 42px 42px;

    mask-image: linear-gradient(
        to bottom,
        black,
        transparent 95%
    );

    z-index: 0;
}


/* =========================================================
   FLOATING LIGHTING EFFECTS
   ========================================================= */

.registration-page::after {
    content: "";

    position: absolute;

    width: 430px;
    height: 430px;

    right: -180px;
    bottom: 8%;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(6, 182, 212, 0.20),
            rgba(124, 58, 237, 0.08) 45%,
            transparent 72%
        );

    filter: blur(5px);

    pointer-events: none;

    animation:
        registrationLightMove 10s ease-in-out infinite;

    z-index: 0;
}


/* Extra lighting elements */

.registration-page {
    isolation: isolate;
}

.registration-page .container {
    position: relative;
    z-index: 3;
}

.registration-page .container::before,
.registration-page .container::after {
    content: "";

    position: absolute;

    border-radius: 50%;

    pointer-events: none;

    z-index: -1;
}

.registration-page .container::before {
    width: 300px;
    height: 300px;

    top: 180px;
    left: -160px;

    background:
        radial-gradient(
            circle,
            rgba(99, 102, 241, 0.16),
            transparent 68%
        );

    filter: blur(4px);

    animation:
        floatingGlowOne 9s ease-in-out infinite;
}

.registration-page .container::after {
    width: 340px;
    height: 340px;

    top: 650px;
    right: -180px;

    background:
        radial-gradient(
            circle,
            rgba(236, 72, 153, 0.13),
            transparent 68%
        );

    filter: blur(5px);

    animation:
        floatingGlowTwo 11s ease-in-out infinite;
}


/* =========================================================
   PAGE HEADER
   ========================================================= */

.registration-page > .container > .text-center {
    animation:
        registrationHeaderIn
        0.85s
        cubic-bezier(.2,.8,.2,1)
        both;
}

.registration-icon {
    width: 82px;
    height: 82px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: center;

    position: relative;

    border-radius: 25px;

    color: #fff;

    font-size: 32px;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed 55%,
            #06b6d4
        );

    box-shadow:
        0 22px 50px rgba(79, 70, 229, 0.28),
        0 8px 25px rgba(124, 58, 237, 0.20),
        inset 0 1px 0 rgba(255, 255, 255, 0.35);

    animation:
        registrationIconIn 0.8s
        cubic-bezier(.2,.8,.2,1)
        both,
        registrationIconFloat 4s
        ease-in-out
        1s
        infinite;
}

.registration-icon::before {
    content: "";

    position: absolute;

    inset: -8px;

    border-radius: 31px;

    border: 1px solid rgba(79, 70, 229, 0.18);

    box-shadow:
        0 0 0 7px rgba(79, 70, 229, 0.025),
        0 0 35px rgba(79, 70, 229, 0.16);

    animation:
        registrationPulse
        2.8s
        ease-in-out
        infinite;
}

.registration-icon::after {
    content: "";

    position: absolute;

    width: 28px;
    height: 28px;

    top: 7px;
    right: 7px;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.22);

    filter: blur(2px);

    animation:
        iconShine
        3s
        ease-in-out
        infinite;
}

.registration-icon i {
    position: relative;
    z-index: 5;
}

.registration-page h1 {
    color: var(--cn-text);

    letter-spacing: -0.8px;

    text-shadow:
        0 3px 15px rgba(15, 23, 42, 0.05);
}

.registration-page > .container > .text-center p {
    color: var(--cn-muted) !important;

    font-size: 1.02rem;
}


/* =========================================================
   REGISTRATION ROLE SWITCH
   STUDENT / FACULTY / WORKER
   ========================================================= */

.registration-role-switch {
    width: fit-content;
    max-width: 100%;

    margin: 22px auto 0;

    padding: 7px;

    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 7px;

    border:
        1px solid rgba(99, 102, 241, 0.14);

    border-radius: 19px;

    background:
        rgba(255, 255, 255, 0.84);

    box-shadow:
        0 14px 32px rgba(15, 23, 42, 0.075),
        inset 0 1px 0 rgba(255, 255, 255, 0.95);

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    animation:
        roleSwitchIn
        0.75s
        cubic-bezier(.2,.8,.2,1)
        0.15s
        both;
}

.role-switch-btn {
    min-width: 185px;

    padding: 11px 18px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 11px;

    text-decoration: none !important;

    border-radius: 13px;

    color: #475569;

    background: transparent;

    transition:
        transform 0.25s ease,
        color 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.role-switch-icon {
    width: 41px;
    height: 41px;

    flex: 0 0 41px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    color: #6366f1;

    background:
        rgba(99, 102, 241, 0.08);

    font-size: 17px;

    transition:
        transform 0.25s ease,
        color 0.25s ease,
        background 0.25s ease;
}

.role-switch-btn > span:last-child {
    display: flex;
    flex-direction: column;

    align-items: flex-start;

    line-height: 1.2;
}

.role-switch-btn strong {
    font-size: 0.91rem;

    font-weight: 700;

    color: #334155;

    transition:
        color 0.25s ease;
}

.role-switch-btn small {
    margin-top: 3px;

    font-size: 0.70rem;

    color: #94a3b8;

    white-space: nowrap;

    transition:
        color 0.25s ease;
}

.role-switch-btn:hover {
    transform: translateY(-2px);

    color: #4f46e5;

    background:
        rgba(238, 242, 255, 0.78);

    box-shadow:
        0 9px 21px rgba(79, 70, 229, 0.08);
}

.role-switch-btn:hover .role-switch-icon {
    transform:
        translateY(-1px)
        scale(1.05);

    color: #4f46e5;

    background:
        rgba(99, 102, 241, 0.13);
}

.role-switch-btn:hover strong {
    color: #4f46e5;
}

.role-switch-btn:hover small {
    color: #64748b;
}


/* ACTIVE ROLE */

.role-switch-btn.active {
    color: #fff;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    box-shadow:
        0 11px 25px rgba(79, 70, 229, 0.24);
}

.role-switch-btn.active:hover {
    transform: translateY(-2px);

    color: #fff;

    background:
        linear-gradient(
            135deg,
            #4338ca,
            #6d28d9
        );

    box-shadow:
        0 15px 30px rgba(79, 70, 229, 0.30);
}

.role-switch-btn.active .role-switch-icon {
    color: #fff;

    background:
        rgba(255, 255, 255, 0.16);
}

.role-switch-btn.active strong {
    color: #fff;
}

.role-switch-btn.active small {
    color:
        rgba(255, 255, 255, 0.76);
}


/* =========================================================
   MAIN CARD
   ========================================================= */

.registration-card {
    position: relative;

    max-width: 1100px;

    margin: 0 auto;

    overflow: hidden;

    border:
        1px solid rgba(255, 255, 255, 0.85);

    border-radius: 28px;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.93),
            rgba(248, 250, 255, 0.86)
        );

    box-shadow:
        0 45px 100px rgba(15, 23, 42, 0.13),
        0 20px 45px rgba(79, 70, 229, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);

    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);

    animation:
        registrationCardIn
        0.95s
        cubic-bezier(.2,.8,.2,1)
        0.12s
        both;

    transition:
        box-shadow 0.4s ease,
        transform 0.4s ease;
}

.registration-card:hover {
    box-shadow:
        0 50px 110px rgba(15, 23, 42, 0.16),
        0 20px 55px rgba(79, 70, 229, 0.10),
        inset 0 1px 0 rgba(255, 255, 255, 0.95);
}


/* =========================================================
   ANIMATED TOP LINE
   ========================================================= */

.registration-card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    height: 5px;

    background:
        linear-gradient(
            90deg,
            #4f46e5,
            #7c3aed,
            #06b6d4,
            #ec4899,
            #4f46e5
        );

    background-size: 300% 100%;

    animation:
        gradientMove
        6s
        linear
        infinite;

    z-index: 10;
}


/* =========================================================
   FORM HEADER
   ========================================================= */

.registration-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding: 30px 32px;

    background:
        linear-gradient(
            135deg,
            rgba(79, 70, 229, 0.075),
            rgba(124, 58, 237, 0.055),
            rgba(6, 182, 212, 0.045)
        );

    border-bottom:
        1px solid rgba(148, 163, 184, 0.14);
}

.registration-header h4 {
    color: var(--cn-text);

    letter-spacing: -0.3px;
}

.registration-header p {
    font-size: 0.92rem;
}

.registration-header .badge {
    border-radius: 12px;

    font-weight: 600;

    box-shadow:
        0 9px 22px rgba(79, 70, 229, 0.10);

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.registration-header .badge:hover {
    transform: translateY(-2px);

    box-shadow:
        0 14px 28px rgba(79, 70, 229, 0.15);
}


/* =========================================================
   FORM SECTIONS
   ========================================================= */

.form-section {
    position: relative;

    margin: 23px 28px;

    padding: 27px;

    border:
        1px solid var(--cn-border);

    border-radius: 21px;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.96),
            rgba(248, 250, 255, 0.90)
        );

    box-shadow:
        0 12px 30px rgba(15, 23, 42, 0.055),
        inset 0 1px 0 rgba(255, 255, 255, 0.8);

    transition:
        transform 0.35s ease,
        box-shadow 0.35s ease,
        border-color 0.35s ease;

    animation:
        sectionReveal
        0.65s
        ease
        both;
}

.form-section::after {
    content: "";

    position: absolute;

    width: 90px;
    height: 90px;

    right: -40px;
    bottom: -45px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(99, 102, 241, 0.08),
            transparent 70%
        );

    pointer-events: none;

    transition:
        transform 0.4s ease;
}

.form-section:hover::after {
    transform: scale(1.5);
}

.form-section:nth-of-type(1) {
    animation-delay: 0.20s;
}

.form-section:nth-of-type(2) {
    animation-delay: 0.28s;
}

.form-section:nth-of-type(3) {
    animation-delay: 0.36s;
}

.form-section:nth-of-type(4) {
    animation-delay: 0.44s;
}

.form-section:nth-of-type(5) {
    animation-delay: 0.52s;
}

.form-section:nth-of-type(6) {
    animation-delay: 0.60s;
}

.form-section:hover {
    transform: translateY(-4px);

    border-color:
        rgba(99, 102, 241, 0.22);

    box-shadow:
        0 22px 42px rgba(15, 23, 42, 0.09),
        0 7px 20px rgba(79, 70, 229, 0.065),
        inset 0 1px 0 rgba(255, 255, 255, 0.95);
}


/* =========================================================
   SECTION TITLE
   ========================================================= */

.section-title {
    display: flex;
    align-items: center;

    gap: 15px;

    margin-bottom: 26px;
    padding-bottom: 17px;

    border-bottom:
        1px solid rgba(148, 163, 184, 0.16);
}

.section-icon {
    flex: 0 0 auto;

    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 15px;

    color: #fff;

    font-size: 19px;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    box-shadow:
        0 10px 23px rgba(79, 70, 229, 0.20);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.form-section:hover .section-icon {
    transform:
        translateY(-3px)
        rotate(-4deg)
        scale(1.04);

    box-shadow:
        0 15px 30px rgba(79, 70, 229, 0.26);
}

.section-title h5 {
    margin: 0 0 4px;

    color: var(--cn-text);

    font-weight: 700;

    letter-spacing: -0.2px;
}

.section-title p {
    margin: 0;

    color: var(--cn-muted);

    font-size: 0.86rem;
}


/* =========================================================
   LABELS
   ========================================================= */

.registration-page .form-label {
    color: #334155;

    font-size: 0.91rem;

    font-weight: 600;

    margin-bottom: 8px;

    transition:
        color 0.2s ease;
}

.registration-page .form-label:hover {
    color: var(--cn-primary);
}

.registration-page .text-danger {
    font-weight: 700;
}


/* =========================================================
   INPUTS
   ========================================================= */

.registration-page .form-control,
.registration-page .form-select {
    min-height: 49px;

    border:
        1px solid #dbe2ea;

    border-radius: 12px;

    color: #1e293b;

    background:
        rgba(255, 255, 255, 0.92);

    box-shadow:
        0 4px 12px rgba(15, 23, 42, 0.025);

    transition:
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        transform 0.25s ease,
        background 0.25s ease;
}

.registration-page textarea.form-control {
    min-height: auto;

    padding-top: 13px;
}

.registration-page .form-control:hover,
.registration-page .form-select:hover {
    border-color:
        rgba(99, 102, 241, 0.38);

    background: #fff;

    box-shadow:
        0 7px 17px rgba(79, 70, 229, 0.055);
}

.registration-page .form-control:focus,
.registration-page .form-select:focus {
    border-color:
        rgba(79, 70, 229, 0.62);

    background: #fff;

    outline: none;

    box-shadow:
        0 0 0 4px rgba(79, 70, 229, 0.09),
        0 10px 23px rgba(79, 70, 229, 0.09);

    transform: translateY(-1px);
}


/* =========================================================
   INPUT GROUP
   ========================================================= */

.registration-page .input-group {
    border-radius: 12px;
}

.registration-page .input-group-text {
    min-width: 49px;

    justify-content: center;

    color: #6366f1;

    border-color: #dbe2ea;

    background:
        linear-gradient(
            135deg,
            #f5f7ff,
            #f8faff
        );

    transition:
        color 0.25s ease,
        background 0.25s ease,
        border-color 0.25s ease;
}

.registration-page .input-group .form-control {
    border-left: 0;
}

.registration-page .input-group:hover .input-group-text {
    color: var(--cn-primary);

    background:
        linear-gradient(
            135deg,
            #eef2ff,
            #f5f3ff
        );
}

.registration-page .input-group:focus-within .input-group-text {
    border-color:
        rgba(79, 70, 229, 0.62);

    color: var(--cn-primary);

    box-shadow:
        0 0 0 4px rgba(79, 70, 229, 0.09);
}


/* =========================================================
   PASSWORD TOGGLE
   ========================================================= */

.password-toggle {
    min-width: 50px;

    border-color:
        #dbe2ea !important;

    background:
        #fff !important;

    transition:
        transform 0.25s ease,
        color 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease;
}

.password-toggle:hover {
    color:
        var(--cn-primary) !important;

    background:
        #f5f7ff !important;

    transform:
        translateY(-1px);

    box-shadow:
        0 7px 16px rgba(79, 70, 229, 0.12);
}

.password-toggle:active {
    transform:
        scale(0.94);
}


/* =========================================================
   FORM TEXT
   ========================================================= */

.registration-page .form-text {
    color: #64748b;

    font-size: 0.78rem;

    margin-top: 7px;
}


/* =========================================================
   CHECKBOX
   ========================================================= */

.registration-page .form-check-input {
    cursor: pointer;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.registration-page .form-check-input:hover {
    transform: scale(1.08);
}

.registration-page .form-check-input:focus {
    box-shadow:
        0 0 0 4px rgba(79, 70, 229, 0.10);
}


/* =========================================================
   TERMS
   ========================================================= */

.registration-terms {
    margin: 25px 28px 10px;

    padding: 21px 23px;

    border:
        1px solid rgba(99, 102, 241, 0.13);

    border-radius: 18px;

    background:
        linear-gradient(
            135deg,
            rgba(238, 242, 255, 0.88),
            rgba(240, 249, 255, 0.82)
        );

    box-shadow:
        0 9px 25px rgba(15, 23, 42, 0.045);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
}

.registration-terms:hover {
    transform: translateY(-2px);

    border-color:
        rgba(99, 102, 241, 0.24);

    box-shadow:
        0 14px 30px rgba(79, 70, 229, 0.08);
}

.registration-terms .form-check-input {
    width: 18px;
    height: 18px;

    margin-top: 3px;

    border-color:
        #cbd5e1;
}

.registration-terms .form-check-label {
    color: #475569;

    line-height: 1.65;

    cursor: pointer;
}


/* =========================================================
   ACTION BUTTONS
   ========================================================= */

.registration-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin: 26px 28px 0;

    padding-top: 24px;

    border-top:
        1px solid rgba(148, 163, 184, 0.16);
}

.registration-actions .btn {
    min-height: 51px;

    border-radius: 13px;

    font-weight: 600;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease;
}


/* PRIMARY BUTTON */

.registration-actions .btn-primary {
    position: relative;

    overflow: hidden;

    border: none;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    box-shadow:
        0 13px 28px rgba(79, 70, 229, 0.23);
}

.registration-actions .btn-primary::before {
    content: "";

    position: absolute;

    top: 0;
    left: -120%;

    width: 70%;
    height: 100%;

    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255, 255, 255, 0.22),
            transparent
        );

    transform: skewX(-20deg);

    transition:
        left 0.65s ease;
}

.registration-actions .btn-primary:hover::before {
    left: 140%;
}

.registration-actions .btn-primary:hover {
    transform:
        translateY(-3px);

    background:
        linear-gradient(
            135deg,
            #4338ca,
            #6d28d9
        );

    box-shadow:
        0 19px 38px rgba(79, 70, 229, 0.31);
}

.registration-actions .btn-primary:active {
    transform:
        translateY(0)
        scale(0.98);
}


/* SECONDARY BUTTON */

.registration-actions .btn-outline-secondary {
    border-color:
        #cbd5e1;

    color: #475569;

    background:
        rgba(255, 255, 255, 0.72);

    box-shadow:
        0 5px 15px rgba(15, 23, 42, 0.025);
}

.registration-actions .btn-outline-secondary:hover {
    transform:
        translateY(-2px);

    color: #334155;

    background: #fff;

    border-color:
        #94a3b8;

    box-shadow:
        0 12px 24px rgba(15, 23, 42, 0.09);
}


/* =========================================================
   LOGIN LINK
   ========================================================= */

.registration-card form > .text-center {
    padding-bottom: 31px;
}

.registration-card form > .text-center a {
    position: relative;

    color:
        var(--cn-primary) !important;

    transition:
        color 0.2s ease,
        letter-spacing 0.2s ease;
}

.registration-card form > .text-center a::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -3px;

    width: 0;
    height: 2px;

    border-radius: 10px;

    background:
        linear-gradient(
            90deg,
            #4f46e5,
            #7c3aed
        );

    transition:
        width 0.25s ease;
}

.registration-card form > .text-center a:hover {
    color:
        var(--cn-primary-dark) !important;

    letter-spacing: 0.15px;
}

.registration-card form > .text-center a:hover::after {
    width: 100%;
}


/* =========================================================
   SELECT / DISABLED
   ========================================================= */

.registration-page option {
    color: #1e293b;

    background: #fff;
}

.registration-page select:disabled,
.registration-page input:disabled,
.registration-page textarea:disabled {
    cursor: not-allowed;
}


/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes registrationHeaderIn {
    from {
        opacity: 0;
        transform: translateY(-25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes registrationIconIn {
    from {
        opacity: 0;
        transform: scale(0.65) rotate(-10deg);
    }

    to {
        opacity: 1;
        transform: scale(1) rotate(0);
    }
}

@keyframes registrationIconFloat {
    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-7px);
    }
}

@keyframes registrationPulse {
    0%,
    100% {
        opacity: 0.35;
        transform: scale(1);
    }

    50% {
        opacity: 0.05;
        transform: scale(1.09);
    }
}

@keyframes iconShine {
    0%,
    100% {
        opacity: 0.2;
        transform: translate(0, 0);
    }

    50% {
        opacity: 0.6;
        transform: translate(-7px, 7px);
    }
}

@keyframes registrationCardIn {
    from {
        opacity: 0;
        transform:
            translateY(40px)
            scale(0.985);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}

@keyframes sectionReveal {
    from {
        opacity: 0;
        transform: translateY(22px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes floatingGlowOne {
    0%,
    100% {
        transform:
            translate3d(0, 0, 0)
            scale(1);
    }

    50% {
        transform:
            translate3d(50px, 30px, 0)
            scale(1.08);
    }
}

@keyframes floatingGlowTwo {
    0%,
    100% {
        transform:
            translate3d(0, 0, 0)
            scale(1);
    }

    50% {
        transform:
            translate3d(-45px, -35px, 0)
            scale(1.10);
    }
}

@keyframes registrationLightMove {
    0%,
    100% {
        transform:
            translate3d(0, 0, 0)
            scale(1);
    }

    50% {
        transform:
            translate3d(-45px, -35px, 0)
            scale(1.12);
    }
}

@keyframes gradientMove {
    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }
}

@keyframes roleSwitchIn {
    from {
        opacity: 0;

        transform:
            translateY(15px)
            scale(0.97);
    }

    to {
        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 767.98px) {

    .registration-page {
        padding: 20px 0 50px;
    }

    .registration-icon {
        width: 68px;
        height: 68px;

        border-radius: 20px;

        font-size: 27px;
    }

    .registration-page h1 {
        font-size: 1.75rem;
    }

    .registration-page > .container > .text-center p {
        font-size: 0.93rem;
    }

    /* ROLE SWITCH MOBILE */

    .registration-role-switch {
        width: 100%;

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 5px;

        padding: 5px;

        border-radius: 15px;
    }

    .role-switch-btn {
        min-width: 0;

        padding: 10px 6px;

        flex-direction: column;

        gap: 6px;

        border-radius: 11px;
    }

    .role-switch-icon {
        width: 36px;
        height: 36px;

        flex-basis: 36px;

        border-radius: 10px;
    }

    .role-switch-btn > span:last-child {
        align-items: center;
    }

    .role-switch-btn strong {
        font-size: 0.78rem;
    }

    .role-switch-btn small {
        display: none;
    }

    .registration-card {
        border-radius: 21px;
    }

    .registration-header {
        align-items: flex-start;

        flex-direction: column;

        padding: 23px;
    }

    .registration-header .badge {
        align-self: flex-start;
    }

    .form-section {
        margin: 16px;

        padding: 20px;

        border-radius: 18px;
    }

    .section-title {
        align-items: flex-start;
    }

    .section-icon {
        width: 43px;
        height: 43px;

        border-radius: 12px;
    }

    .registration-terms {
        margin:
            18px 16px 8px;
    }

    .registration-actions {
        flex-direction: column-reverse;

        margin:
            20px 16px 0;
    }

    .registration-actions .btn {
        width: 100%;
    }
}


@media (max-width: 480px) {

    .registration-page h1 {
        font-size: 1.5rem;
    }

    .registration-card {
        margin: 0 7px;
    }

    .registration-header {
        padding: 20px;
    }

    .form-section {
        padding: 17px;
    }

    .section-title {
        gap: 11px;
    }

    .section-title h5 {
        font-size: 1rem;
    }

    .section-title p {
        font-size: 0.78rem;
    }

    .registration-terms {
        padding: 17px;
    }

    .registration-page .form-control,
    .registration-page .form-select {
        min-height: 47px;
    }

    /* SMALL MOBILE ROLE SWITCH */

    .registration-role-switch {
        gap: 4px;
    }

    .role-switch-btn {
        padding: 9px 4px;
    }

    .role-switch-icon {
        width: 33px;
        height: 33px;

        flex-basis: 33px;

        font-size: 15px;
    }

    .role-switch-btn strong {
        font-size: 0.73rem;
    }
}


/* =========================================================
   ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    .registration-page *,
    .registration-page::before,
    .registration-page::after,
    .registration-page .container::before,
    .registration-page .container::after {

        animation-duration: 0.01ms !important;

        animation-iteration-count: 1 !important;

        transition-duration: 0.01ms !important;
    }
}
