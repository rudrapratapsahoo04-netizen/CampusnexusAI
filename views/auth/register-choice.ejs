                                <input
                                    type="tel"
                                    class="form-control"
                                    id="emergencyContact"
                                    name="emergencyContact"
                                    placeholder="Emergency contact number"
                                    pattern="[0-9]{10}"
                                    maxlength="10"
                                    required
                                >

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ==========================================
                     HOSTEL INFORMATION
                =========================================== -->

                <div class="form-section">

                    <div class="section-title">

                        <div class="section-icon">
                            <i class="bi bi-building"></i>
                        </div>

                        <div>

                            <h5>
                                Campus & Hostel
                            </h5>

                            <p>
                                Hostel accommodation details
                            </p>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- HOSTEL REQUIRED -->

                        <div class="col-md-4">

                            <label
                                for="hostelRequired"
                                class="form-label"
                            >

                                Hostel Required?

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <select
                                class="form-select"
                                id="hostelRequired"
                                name="hostelRequired"
                                required
                            >

                                <option
                                    value=""
                                    selected
                                    disabled
                                >
                                    Select
                                </option>

                                <option value="yes">
                                    Yes
                                </option>

                                <option value="no">
                                    No
                                </option>

                            </select>

                        </div>


                        <!-- HOSTEL NAME -->

                        <div class="col-md-4">

                            <label
                                for="hostelName"
                                class="form-label"
                            >

                                Hostel Name

                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="hostelName"
                                name="hostelName"
                                placeholder="If applicable"
                            >

                        </div>


                        <!-- ROOM -->

                        <div class="col-md-4">

                            <label
                                for="roomNumber"
                                class="form-label"
                            >

                                Room Number

                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="roomNumber"
                                name="roomNumber"
                                placeholder="If assigned"
                            >

                        </div>

                    </div>

                </div>


                <!-- ==========================================
                     ACCOUNT SECURITY
                =========================================== -->

                <div class="form-section">

                    <div class="section-title">

                        <div class="section-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                        <div>

                            <h5>
                                Account Security
                            </h5>

                            <p>
                                Create your secure CampusNexus password
                            </p>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- PASSWORD -->

                        <div class="col-md-6">

                            <label
                                for="password"
                                class="form-label"
                            >

                                Password

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <div class="input-group">

                                <input
                                    type="password"
                                    class="form-control"
                                    id="password"
                                    name="password"
                                    placeholder="Create password"
                                    minlength="6"
                                    required
                                    autocomplete="new-password"
                                >

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary password-toggle"
                                    data-target="password"
                                >

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>

                            <div class="form-text">
                                Minimum 6 characters.
                            </div>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="col-md-6">

                            <label
                                for="confirmPassword"
                                class="form-label"
                            >

                                Confirm Password

                                <span class="text-danger">
                                    *
                                </span>

                            </label>

                            <div class="input-group">

                                <input
                                    type="password"
                                    class="form-control"
                                    id="confirmPassword"
                                    name="confirmPassword"
                                    placeholder="Confirm password"
                                    minlength="6"
                                    required
                                    autocomplete="new-password"
                                >

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary password-toggle"
                                    data-target="confirmPassword"
                                >

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ==========================================
                     TERMS
                =========================================== -->

                <div class="registration-terms">

                    <div class="form-check">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="terms"
                            name="termsAccepted"
                            value="yes"
                            required
                        >

                        <label
                            class="form-check-label"
                            for="terms"
                        >

                            I confirm that the information provided above
                            is accurate and I agree to the university's
                            terms and conditions.

                            <span class="text-danger">
                                *
                            </span>

                        </label>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="registration-actions">

                    <a
                        href="/auth/login"
                        class="btn btn-outline-secondary btn-lg"
                    >

                        <i class="bi bi-arrow-left me-2"></i>

                        Back to Login

                    </a>

                    <button
                        type="submit"
                        class="btn btn-primary btn-lg px-5"
                    >

                        <i class="bi bi-person-plus-fill me-2"></i>

                        Create Account

                    </button>

                </div>


                <!-- LOGIN LINK -->

                <div class="text-center mt-4">

                    <p class="text-muted mb-0">

                        Already have an account?

                        <a
                            href="/auth/login"
                            class="fw-semibold text-decoration-none"
                        >
                            Login here
                        </a>

                    </p>

                </div>

            </form>

        </div>

    </div>

</div>


<script>
document.addEventListener("DOMContentLoaded", () => {

    // ========================================================
    // DEPARTMENT → PROGRAM FILTERING
    // ========================================================

    const departmentSelect =
        document.getElementById("department");

    const programSelect =
        document.getElementById("program");

    if (departmentSelect && programSelect) {

        const allProgramOptions =
            Array.from(
                programSelect.querySelectorAll(
                    "option[data-department]"
                )
            );

        function filterPrograms() {

            const selectedDepartment =
                String(
                    departmentSelect.value || ""
                ).trim();

            // Reset program selection
            programSelect.value = "";

            // Show / hide programs
            allProgramOptions.forEach((option) => {

                const optionDepartment =
                    String(
                        option.dataset.department || ""
                    ).trim();

                if (
                    selectedDepartment &&
                    optionDepartment === selectedDepartment
                ) {

                    option.style.display = "";

                } else {

                    option.style.display = "none";

                }

            });
        }

        departmentSelect.addEventListener(
            "change",
            filterPrograms
        );

        // Initial state
        filterPrograms();
    }


    // ========================================================
    // PASSWORD VISIBILITY
    // ========================================================

    document
        .querySelectorAll(".password-toggle")
        .forEach((button) => {

            button.addEventListener("click", () => {

                const targetId =
                    button.dataset.target;

                const input =
                    document.getElementById(targetId);

                const icon =
                    button.querySelector("i");

                if (!input || !icon) {
                    return;
                }

                if (input.type === "password") {

                    input.type = "text";

                    icon.classList.remove(
                        "bi-eye"
                    );

                    icon.classList.add(
                        "bi-eye-slash"
                    );

                } else {

                    input.type = "password";

                    icon.classList.remove(
                        "bi-eye-slash"
                    );

                    icon.classList.add(
                        "bi-eye"
                    );

                }

            });

        });


    // ========================================================
    // SAME ADDRESS
    // ========================================================

    const sameAddress =
        document.getElementById("sameAddress");

    const permanentAddress =
        document.getElementById("permanentAddress");

    const currentAddress =
        document.getElementById("currentAddress");

    if (
        sameAddress &&
        permanentAddress &&
        currentAddress
    ) {

        sameAddress.addEventListener(
            "change",
            () => {

                if (sameAddress.checked) {

                    currentAddress.value =
                        permanentAddress.value;

                    currentAddress.setAttribute(
                        "readonly",
                        "readonly"
                    );

                } else {

                    currentAddress.removeAttribute(
                        "readonly"
                    );

                }

            }
        );


        permanentAddress.addEventListener(
            "input",
            () => {

                if (sameAddress.checked) {

                    currentAddress.value =
                        permanentAddress.value;

                }

            }
        );

    }


    // ========================================================
    // PASSWORD MATCH VALIDATION
    // ========================================================

    const form =
        document.getElementById(
            "registrationForm"
        );

    const password =
        document.getElementById(
            "password"
        );

    const confirmPassword =
        document.getElementById(
            "confirmPassword"
        );

    if (
        form &&
        password &&
        confirmPassword
    ) {

        form.addEventListener(
            "submit",
            (event) => {

                if (
                    password.value !==
                    confirmPassword.value
                ) {

                    event.preventDefault();

                    confirmPassword.setCustomValidity(
                        "Passwords do not match."
                    );

                    confirmPassword.reportValidity();

                } else {

                    confirmPassword.setCustomValidity(
                        ""
                    );

                }

            }
        );

    }

});
</script>
