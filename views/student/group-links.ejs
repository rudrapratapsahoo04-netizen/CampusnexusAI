<% layout("layouts/boilerplate") -%>

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>
                College Group Links
            </h2>

            <p class="text-muted mb-0">
                Join official college, department, program and class groups.
            </p>
        </div>

        <a
            href="/student/dashboard"
            class="btn btn-outline-secondary"
        >
            <i class="bi bi-arrow-left me-1"></i>
            Dashboard
        </a>

    </div>


    <!-- STUDENT ACADEMIC INFO -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Department
                    </small>

                    <strong class="text-capitalize">
                        <%= studentProfile.department || "N/A" %>
                    </strong>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Program
                    </small>

                    <strong class="text-uppercase">
                        <%= studentProfile.program || "N/A" %>
                    </strong>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Semester
                    </small>

                    <strong>
                        Semester <%= studentProfile.semester || "N/A" %>
                    </strong>
                </div>

                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Section
                    </small>

                    <strong>
                        <%= studentProfile.section || "N/A" %>
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <% if (groupLinks && groupLinks.length > 0) { %>

        <div class="row g-4">

            <% groupLinks.forEach(group => { %>

                <div class="col-xl-4 col-lg-6">

                    <div class="card h-100 border-0 shadow-sm group-link-card">

                        <div class="card-body p-4">

                            <!-- TOP -->
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">

                                <div class="d-flex align-items-center gap-3">

                                    <div
                                        class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                                        style="width: 48px; height: 48px;"
                                    >
                                        <i class="bi bi-people-fill fs-5"></i>
                                    </div>

                                    <div>
                                        <h5 class="fw-bold mb-1">
                                            <%= group.groupName %>
                                        </h5>

                                        <span class="badge bg-light text-dark border">
                                            <% if (group.platform === "whatsapp") { %>
                                                <i class="bi bi-whatsapp me-1"></i>
                                                WhatsApp
                                            <% } else if (group.platform === "telegram") { %>
                                                <i class="bi bi-telegram me-1"></i>
                                                Telegram
                                            <% } else if (group.platform === "discord") { %>
                                                <i class="bi bi-discord me-1"></i>
                                                Discord
                                            <% } else if (group.platform === "class_group") { %>
                                                <i class="bi bi-mortarboard-fill me-1"></i>
                                                Class Group
                                            <% } else if (group.platform === "department_group") { %>
                                                <i class="bi bi-building me-1"></i>
                                                Department Group
                                            <% } else if (group.platform === "program_group") { %>
                                                <i class="bi bi-book me-1"></i>
                                                Program Group
                                            <% } else { %>
                                                <i class="bi bi-link-45deg me-1"></i>
                                                Other
                                            <% } %>
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- SCOPE -->
                            <div class="mb-3">

                                <% if (group.scope === "university") { %>

                                    <span class="badge bg-primary-subtle text-primary">
                                        <i class="bi bi-globe2 me-1"></i>
                                        University Wide
                                    </span>

                                <% } else if (group.scope === "department") { %>

                                    <span class="badge bg-info-subtle text-info">
                                        <i class="bi bi-building me-1"></i>
                                        Department
                                    </span>

                                <% } else if (group.scope === "program") { %>

                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-book me-1"></i>
                                        Program
                                    </span>

                                <% } else if (group.scope === "semester") { %>

                                    <span class="badge bg-warning-subtle text-warning">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        Semester
                                    </span>

                                <% } else if (group.scope === "section") { %>

                                    <span class="badge bg-danger-subtle text-danger">
                                        <i class="bi bi-people me-1"></i>
                                        Section
                                    </span>

                                <% } %>

                            </div>


                            <!-- DESCRIPTION -->
                            <% if (group.description) { %>

                                <p class="text-muted small mb-4">
                                    <%= group.description %>
                                </p>

                            <% } else { %>

                                <p class="text-muted small mb-4">
                                    Official college group for students.
                                </p>

                            <% } %>


                            <!-- JOIN BUTTON -->
                            <div class="d-grid">

                                <a
                                    href="<%= group.groupLink %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn btn-primary"
                                >
                                    <i class="bi bi-box-arrow-up-right me-1"></i>
                                    Join Group
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <!-- EMPTY STATE -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div
                    class="rounded-circle bg-light text-muted d-flex align-items-center justify-content-center mx-auto mb-3"
                    style="width: 80px; height: 80px;"
                >
                    <i class="bi bi-people fs-1"></i>
                </div>

                <h4 class="fw-bold">
                    No Group Links Available
                </h4>

                <p class="text-muted mb-0">
                    There are currently no active college or academic group links
                    available for your academic profile.
                </p>

            </div>

        </div>

    <% } %>

</div>


<style>

    .group-link-card {
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .group-link-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.08) !important;
    }

</style>