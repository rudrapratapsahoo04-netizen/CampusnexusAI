<script>
document.addEventListener("DOMContentLoaded", function () {

    /* =========================================================
       CAMPUSNEXUS LOCAL AI
       ---------------------------------------------------------
       This frontend sends ONLY the user's question.
       The backend identifies the logged-in student using
       req.session.user and fetches only that student's data.

       NO GEMINI
       NO OPENAI
       NO API KEY
       ========================================================= */


    const floatingAI =
        document.getElementById("floatingAI");

    const aiButton =
        document.getElementById("dashboardAIButton");

    const aiWindow =
        document.getElementById("aiChatWindow");

    const aiClose =
        document.getElementById("aiClose");

    const aiInput =
        document.getElementById("aiInput");

    const aiSend =
        document.getElementById("aiSend");

    const aiMessages =
        document.getElementById("aiChatMessages");


    /* =========================================================
       BASIC ELEMENT CHECK
    ========================================================= */

    if (!floatingAI) {
        console.error(
            "CampusNexus AI: #floatingAI not found."
        );
        return;
    }

    if (!aiButton) {
        console.error(
            "CampusNexus AI: #dashboardAIButton not found."
        );
        return;
    }

    if (!aiWindow) {
        console.error(
            "CampusNexus AI: #aiChatWindow not found."
        );
        return;
    }

    if (!aiInput) {
        console.error(
            "CampusNexus AI: #aiInput not found."
        );
        return;
    }

    if (!aiSend) {
        console.error(
            "CampusNexus AI: #aiSend not found."
        );
        return;
    }

    if (!aiMessages) {
        console.error(
            "CampusNexus AI: #aiChatMessages not found."
        );
        return;
    }


    /* =========================================================
       STATE
    ========================================================= */

    let isSending = false;


    /* =========================================================
       OPEN AI
    ========================================================= */

    aiButton.addEventListener(
        "click",
        function (event) {

            event.preventDefault();
            event.stopPropagation();

            const isOpen =
                floatingAI.classList.contains("ai-open");

            if (isOpen) {

                floatingAI.classList.remove(
                    "ai-open"
                );

            } else {

                floatingAI.classList.add(
                    "ai-open"
                );

                setTimeout(function () {

                    aiInput.focus();

                }, 150);

            }

        }
    );


    /* =========================================================
       CLOSE AI
    ========================================================= */

    if (aiClose) {

        aiClose.addEventListener(
            "click",
            function (event) {

                event.preventDefault();
                event.stopPropagation();

                floatingAI.classList.remove(
                    "ai-open"
                );

            }
        );

    }


    /* =========================================================
       STOP CLICK PROPAGATION
    ========================================================= */

    aiWindow.addEventListener(
        "click",
        function (event) {

            event.stopPropagation();

        }
    );


    /* =========================================================
       QUICK ACTIONS
    ========================================================= */

    const quickButtons =
        document.querySelectorAll(
            ".ai-quick"
        );


    quickButtons.forEach(
        function (button) {

            button.addEventListener(
                "click",
                function () {

                    const text =
                        button.textContent.trim();

                    if (!text) {
                        return;
                    }

                    aiInput.value = text;

                    aiInput.focus();

                    autoResizeInput();

                }
            );

        }
    );


    /* =========================================================
       INPUT AUTO RESIZE
    ========================================================= */

    function autoResizeInput() {

        aiInput.style.height = "auto";

        aiInput.style.height =
            Math.min(
                aiInput.scrollHeight,
                100
            ) + "px";

    }


    aiInput.addEventListener(
        "input",
        autoResizeInput
    );


    /* =========================================================
       ENTER TO SEND
       SHIFT + ENTER = NEW LINE
    ========================================================= */

    aiInput.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Enter" &&
                !event.shiftKey
            ) {

                event.preventDefault();

                sendMessage();

            }

        }
    );


    /* =========================================================
       ESCAPE TO CLOSE
    ========================================================= */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                floatingAI.classList.contains("ai-open")
            ) {

                floatingAI.classList.remove(
                    "ai-open"
                );

            }

        }
    );


    /* =========================================================
       SEND BUTTON
    ========================================================= */

    aiSend.addEventListener(
        "click",
        function (event) {

            event.preventDefault();

            sendMessage();

        }
    );


    /* =========================================================
       SEND MESSAGE
    ========================================================= */

    async function sendMessage() {

        if (isSending) {
            return;
        }


        const message =
            aiInput.value.trim();


        if (!message) {

            aiInput.focus();

            return;

        }


        /* -----------------------------------------------------
           LOCK SEND
        ----------------------------------------------------- */

        isSending = true;

        aiSend.disabled = true;

        aiSend.style.opacity = "0.6";

        aiSend.style.cursor = "not-allowed";


        /* -----------------------------------------------------
           SHOW USER MESSAGE
        ----------------------------------------------------- */

        addUserMessage(
            message
        );


        /* -----------------------------------------------------
           CLEAR INPUT
        ----------------------------------------------------- */

        aiInput.value = "";

        aiInput.style.height = "40px";


        /* -----------------------------------------------------
           SHOW LOADING
        ----------------------------------------------------- */

        const loadingMessage =
            addLoadingMessage();


        scrollMessagesToBottom();


        try {

            /* =================================================
               LOCAL BACKEND REQUEST

               IMPORTANT:
               We intentionally DO NOT send studentId.

               Backend gets the logged-in student from:

               req.session.user
               ================================================= */

            const response =
                await fetch(
                    "/api/ai/chat",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "Accept":
                                "application/json"
                        },

                        credentials:
                            "same-origin",

                        body: JSON.stringify({
                            message: message
                        })
                    }
                );


            /* -------------------------------------------------
               REMOVE LOADING
            ------------------------------------------------- */

            removeMessage(
                loadingMessage
            );


            /* -------------------------------------------------
               READ RESPONSE SAFELY
            ------------------------------------------------- */

            let data = null;

            try {

                data =
                    await response.json();

            } catch (jsonError) {

                data = null;

            }


            /* -------------------------------------------------
               HTTP ERROR
            ------------------------------------------------- */

            if (!response.ok) {

                let errorText =
                    "Sorry, I couldn't process your request.";

                if (
                    data &&
                    typeof data.reply === "string"
                ) {

                    errorText =
                        data.reply;

                } else if (
                    data &&
                    typeof data.message === "string"
                ) {

                    errorText =
                        data.message;

                } else if (
                    response.status === 401
                ) {

                    errorText =
                        "Your session has expired. Please login again.";

                } else if (
                    response.status === 400
                ) {

                    errorText =
                        "Please enter a valid question.";

                } else if (
                    response.status === 404
                ) {

                    errorText =
                        "AI service is not available. Please check the /api/ai/chat route.";

                } else if (
                    response.status >= 500
                ) {

                    errorText =
                        "CampusNexus AI server error. Please try again.";

                }

                addAssistantMessage(
                    errorText
                );

                scrollMessagesToBottom();

                return;

            }


            /* -------------------------------------------------
               SUCCESS RESPONSE
            ------------------------------------------------- */

            let answer =
                "I couldn't find an answer.";

            if (
                data &&
                typeof data.reply === "string" &&
                data.reply.trim()
            ) {

                answer =
                    data.reply.trim();

            } else if (
                data &&
                typeof data.response === "string" &&
                data.response.trim()
            ) {

                answer =
                    data.response.trim();

            } else if (
                data &&
                typeof data.answer === "string" &&
                data.answer.trim()
            ) {

                answer =
                    data.answer.trim();

            } else if (
                data &&
                typeof data.message === "string" &&
                data.message.trim()
            ) {

                answer =
                    data.message.trim();

            }


            /* -------------------------------------------------
               SHOW AI ANSWER
            ------------------------------------------------- */

            addAssistantMessage(
                answer
            );


            scrollMessagesToBottom();


        } catch (error) {

            console.error(
                "CampusNexus AI error:",
                error
            );


            removeMessage(
                loadingMessage
            );


            addAssistantMessage(
                "Unable to connect to CampusNexus AI. Please check your server and try again."
            );


            scrollMessagesToBottom();

        } finally {

            /* -------------------------------------------------
               UNLOCK SEND
            ------------------------------------------------- */

            isSending = false;

            aiSend.disabled = false;

            aiSend.style.opacity = "1";

            aiSend.style.cursor = "pointer";

            aiInput.focus();

        }

    

}


    


    /* =========================================================
       ADD USER MESSAGE
    ========================================================= */

    function addUserMessage(
        message
    ) {

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "ai-message ai-user-message";


        const content =
            document.createElement("div");

        content.className =
            "ai-message-content";


        /*
         * textContent is intentional.
         *
         * It prevents user input from being
         * interpreted as HTML.
         */

        content.textContent =
            message;


        wrapper.appendChild(
            content
        );


        aiMessages.appendChild(
            wrapper
        );


        scrollMessagesToBottom();


        return wrapper;

    }


    /* =========================================================
       ADD ASSISTANT MESSAGE
    ========================================================= */

    function addAssistantMessage(
        message
    ) {

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "ai-message ai-assistant-message";


        const avatar =
            document.createElement("div");

        avatar.className =
            "ai-message-avatar";


        avatar.innerHTML =
            '<i class="bi bi-stars"></i>';


        const content =
            document.createElement("div");

        content.className =
            "ai-message-content";


        /*
         * We use textContent instead of innerHTML
         * so database text cannot inject HTML.
         */

        content.textContent =
            message;


        wrapper.appendChild(
            avatar
        );

        wrapper.appendChild(
            content
        );


        aiMessages.appendChild(
            wrapper
        );


        scrollMessagesToBottom();


        return wrapper;

    }


    /* =========================================================
       LOADING MESSAGE
    ========================================================= */

    function addLoadingMessage() {

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "ai-message ai-assistant-message";


        const avatar =
            document.createElement("div");

        avatar.className =
            "ai-message-avatar";


        avatar.innerHTML =
            '<i class="bi bi-stars"></i>';


        const content =
            document.createElement("div");

        content.className =
            "ai-message-content";


        content.innerHTML = `
            <span class="ai-loading-dots">
                <span></span>
                <span></span>
                <span></span>
            </span>
        `;


        wrapper.appendChild(
            avatar
        );

        wrapper.appendChild(
            content
        );


        aiMessages.appendChild(
            wrapper
        );


        return wrapper;

    }


    /* =========================================================
       REMOVE MESSAGE
    ========================================================= */

    function removeMessage(
        element
    ) {

        if (
            element &&
            element.parentNode
        ) {

            element.parentNode.removeChild(
                element
            );

        }

    }


    /* =========================================================
       SCROLL CHAT
    ========================================================= */

    function scrollMessagesToBottom() {

        requestAnimationFrame(
            function () {

                aiMessages.scrollTop =
                    aiMessages.scrollHeight;

            }
        );

    }


    /* =========================================================
       INITIALIZE
    ========================================================= */

    console.log(
        "CampusNexus Local AI initialized."
    );

});
</script>