<% layout("layouts/boilerplate") -%>

<div class="student-dashboard">

    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="student-sidebar">

        <div class="sidebar-brand">

            <div class="brand-logo">
                <img
                    src="/images/logo3.png"
                    alt="CampusNexus"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                >

                <span class="brand-fallback">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
            </div>

            <div class="brand-text">
                <strong>CampusNexus</strong>
                <span>Student Portal</span>
            </div>

        </div>


        <!-- PROFILE -->

        <div class="sidebar-profile">

            <div class="sidebar-avatar">
                <%= (currentUser?.name || "S").charAt(0).toUpperCase() %>
            </div>

            <div class="sidebar-profile-info">
                <strong>
                    <%= currentUser?.name || "Student" %>
                </strong>

                <span>
                    Student
                </span>
            </div>

        </div>


        <!-- MAIN MENU -->

        <div class="sidebar-label">
            MAIN MENU
        </div>

        <nav class="sidebar-nav">

            <a
                href="/student/dashboard"
                class="sidebar-link active"
            >
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>


            <a
                href="/student/profile"
                class="sidebar-link"
            >
                <i class="bi bi-person-vcard"></i>
                <span>My Profile</span>
            </a>


            <a
                href="/student/timetable"
                class="sidebar-link"
            >
                <i class="bi bi-calendar3"></i>
                <span>Timetable</span>
            </a>


            <a
                href="/student/attendance"
                class="sidebar-link"
            >
                <i class="bi bi-calendar-check"></i>
                <span>Attendance</span>
            </a>


            <a
                href="/student/notices"
                class="sidebar-link"
            >
                <i class="bi bi-megaphone"></i>
                <span>Notices</span>
            </a>


            <a
                href="/student/fees"
                class="sidebar-link"
            >
                <i class="bi bi-wallet2"></i>
                <span>Fees</span>
            </a>

        </nav>


        <!-- SERVICES -->

        <div class="sidebar-label services-label">
            SERVICES
        </div>

        <nav class="sidebar-nav">

            <a
                href="/student/group-links"
                class="sidebar-link"
            >
                <i class="bi bi-people"></i>
                <span>Group Links</span>
            </a>


            <a
                href="/student/leave"
                class="sidebar-link"
            >
                <i class="bi bi-file-earmark-text"></i>
                <span>Leave</span>
            </a>


            <a
                href="/student/complaints"
                class="sidebar-link"
            >
                <i class="bi bi-chat-left-text"></i>
                <span>Complaints</span>
            </a>


            <a
                href="/student/lost-found"
                class="sidebar-link"
            >
                <i class="bi bi-search-heart"></i>
                <span>Lost & Found</span>
            </a>


            <a
                href="/student/gate-passes"
                class="sidebar-link"
            >
                <i class="bi bi-door-open"></i>
                <span>Gate Pass</span>
            </a>


            <a
                href="/student/certificates"
                class="sidebar-link"
            >
                <i class="bi bi-file-earmark-check"></i>
                <span>Certificates</span>
            </a>

        </nav>


        <!-- SIDEBAR BOTTOM -->

        <div class="sidebar-bottom">

            <div class="sidebar-help">

                <div class="help-icon">
                    <i class="bi bi-headset"></i>
                </div>

                <div>
                    <strong>Need Help?</strong>
                    <span>Contact campus support</span>
                </div>

            </div>

        </div>

    </aside>


    <!-- =========================================================
         MAIN AREA
    ========================================================== -->

    <main class="student-main">


        <!-- TOPBAR -->

        <header class="student-topbar">

            <div class="mobile-brand">

                <button
                    type="button"
                    class="mobile-menu-btn"
                    id="mobileMenuBtn"
                >
                    <i class="bi bi-list"></i>
                </button>

                <strong>CampusNexus</strong>

            </div>


            <div class="topbar-search">

                <i class="bi bi-search"></i>

                <input
                    type="text"
                    placeholder="Search services..."
                    id="dashboardSearch"
                >

            </div>


            <div class="topbar-actions">

                <!-- NOTIFICATION -->

                <button
                    type="button"
                    class="topbar-icon-btn notification-trigger"
                    id="notificationButton"
                    title="Notifications"
                >

                    <i class="bi bi-bell"></i>

                    <% if ((unreadNotificationCount || 0) > 0) { %>

                        <span class="notification-dot">
                            <%= unreadNotificationCount %>
                        </span>

                    <% } %>

                </button>


                <!-- PROFILE -->

                <a
                    href="/student/profile"
                    class="topbar-user"
                >

                    <div class="topbar-avatar">
                        <%= (currentUser?.name || "S").charAt(0).toUpperCase() %>
                    </div>

                    <div class="topbar-user-info">

                        <strong>
                            <%= currentUser?.name || "Student" %>
                        </strong>

                        <span>
                            Student
                        </span>

                    </div>

                    <i class="bi bi-chevron-down"></i>

                </a>

            </div>

        </header>


        <!-- MOBILE OVERLAY -->

        <div
            class="sidebar-overlay"
            id="sidebarOverlay"
        ></div>


        <!-- =====================================================
             DASHBOARD CONTENT
        ====================================================== -->

        <div class="dashboard-content">


            <!-- HERO -->

            <section class="welcome-hero">

                <div class="hero-content">

                    <div class="hero-small">
                        <i class="bi bi-stars"></i>
                        STUDENT DASHBOARD
                    </div>

                    <h1>
                        Hello,
                        <%= currentUser?.name || "Student" %> 👋
                    </h1>

                    <p>
                        Welcome back! Manage your academic life,
                        campus services and university information
                        from one place.
                    </p>

                    <div class="hero-actions">

                        <a
                            href="/student/profile"
                            class="hero-btn primary"
                        >
                            <i class="bi bi-person"></i>
                            My Profile
                        </a>

                        <a
                            href="/student/timetable"
                            class="hero-btn light"
                        >
                            <i class="bi bi-calendar3"></i>
                            View Timetable
                        </a>

                    </div>

                </div>


                <div class="hero-visual">

                    <div class="hero-circle circle-one"></div>
                    <div class="hero-circle circle-two"></div>

                    <div class="hero-student-card">

                        <div class="hero-student-avatar">
                            <%= (currentUser?.name || "S").charAt(0).toUpperCase() %>
                        </div>

                        <div>

                            <span>Student Account</span>

                            <strong>
                                <%= currentUser?.name || "Student" %>
                            </strong>

                            <small>
                                <%= currentUser?.email || "Email not available" %>
                            </small>

                        </div>

                    </div>

                    <div class="floating-icon icon-one">
                        <i class="bi bi-book"></i>
                    </div>

                    <div class="floating-icon icon-two">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <div class="floating-icon icon-three">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                </div>

            </section>


            <!-- =================================================
                 QUICK STATS
            ================================================== -->

            <section class="stats-grid">


                <div class="modern-stat stat-blue">

                    <div class="stat-top">

                        <div class="stat-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <span class="stat-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </span>

                    </div>

                    <div class="stat-number">
                        0%
                    </div>

                    <div class="stat-title">
                        Attendance
                    </div>

                    <div class="stat-description">
                        Overall attendance
                    </div>

                    <div class="stat-progress">
                        <span style="width: 0%;"></span>
                    </div>

                </div>


                <div class="modern-stat stat-purple">

                    <div class="stat-top">

                        <div class="stat-icon">
                            <i class="bi bi-journal-bookmark"></i>
                        </div>

                        <span class="stat-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </span>

                    </div>

                    <div class="stat-number">
                        0
                    </div>

                    <div class="stat-title">
                        Courses
                    </div>

                    <div class="stat-description">
                        Active courses
                    </div>

                    <div class="stat-mini-line"></div>

                </div>


                <div class="modern-stat stat-orange">

                    <div class="stat-top">

                        <div class="stat-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <span class="stat-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </span>

                    </div>

                    <div class="stat-number">
                        0
                    </div>

                    <div class="stat-title">
                        Pending
                    </div>

                    <div class="stat-description">
                        Pending requests
                    </div>

                    <div class="stat-mini-line"></div>

                </div>


                <div class="modern-stat stat-pink">

                    <div class="stat-top">

                        <div class="stat-icon">
                            <i class="bi bi-bell"></i>
                        </div>

                        <span class="stat-arrow">
                            <i class="bi bi-arrow-up-right"></i>
                        </span>

                    </div>

                    <div class="stat-number">
                        <%= unreadNotificationCount || 0 %>
                    </div>

                    <div class="stat-title">
                        Notifications
                    </div>

                    <div class="stat-description">
                        Unread notifications
                    </div>

                    <div class="stat-mini-line"></div>

                </div>

            </section>


            <!-- =================================================
                 MAIN GRID
            ================================================== -->

            <div class="dashboard-grid">


                <!-- LEFT COLUMN -->

                <div class="dashboard-left">


                    <!-- TODAY CLASSES -->

                    <section class="dashboard-panel">

                        <div class="panel-header">

                            <div class="panel-title">

                                <div class="panel-icon blue">
                                    <i class="bi bi-calendar-day"></i>
                                </div>

                                <div>

                                    <h3>
                                        Today's Classes
                                    </h3>

                                    <p>
                                        Your scheduled classes for today
                                    </p>

                                </div>

                            </div>


                            <a
                                href="/student/timetable"
                                class="panel-link"
                            >
                                View Timetable
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>


                        <div class="empty-modern">

                            <div class="empty-modern-icon">
                                <i class="bi bi-calendar2-x"></i>
                            </div>

                            <h4>
                                No classes scheduled
                            </h4>

                            <p>
                                Your today's class schedule will appear here.
                            </p>

                            <a
                                href="/student/timetable"
                                class="small-action-btn"
                            >
                                <i class="bi bi-calendar-week"></i>
                                Open Timetable
                            </a>

                        </div>

                    </section>


                    <!-- STUDENT SERVICES -->

                    <section class="dashboard-panel">

                        <div class="panel-header">

                            <div class="panel-title">

                                <div class="panel-icon purple">
                                    <i class="bi bi-grid-1x2-fill"></i>
                                </div>

                                <div>

                                    <h3>
                                        Student Services
                                    </h3>

                                    <p>
                                        Quick access to your campus services
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="service-grid">


                            <a
                                href="/student/profile"
                                class="service-card service-blue"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-person-vcard"></i>
                                </div>

                                <div class="service-text">
                                    <strong>My Profile</strong>
                                    <span>View profile details</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/timetable"
                                class="service-card service-purple"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-calendar3"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Timetable</strong>
                                    <span>View weekly timetable</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/attendance"
                                class="service-card service-green"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-calendar-check"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Attendance</strong>
                                    <span>Check attendance</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/notices"
                                class="service-card service-orange"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-megaphone"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Notices</strong>
                                    <span>University announcements</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/fees"
                                class="service-card service-cyan"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-wallet2"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Fees</strong>
                                    <span>View fee information</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/group-links"
                                class="service-card service-indigo"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-people"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Group Links</strong>
                                    <span>Official college groups</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/leave"
                                class="service-card service-yellow"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-file-earmark-text"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Leave</strong>
                                    <span>Apply and track leave</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/complaints"
                                class="service-card service-red"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-chat-left-text"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Complaints</strong>
                                    <span>Submit a complaint</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/lost-found"
                                class="service-card service-teal"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-search-heart"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Lost & Found</strong>
                                    <span>Report lost items</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/gate-passes"
                                class="service-card service-dark"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-door-open"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Gate Pass</strong>
                                    <span>Apply and view gate pass</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>


                            <a
                                href="/student/certificates"
                                class="service-card service-pink"
                            >

                                <div class="service-icon">
                                    <i class="bi bi-file-earmark-check"></i>
                                </div>

                                <div class="service-text">
                                    <strong>Certificates</strong>
                                    <span>Apply for certificates</span>
                                </div>

                                <i class="bi bi-arrow-up-right service-arrow"></i>

                            </a>

                        </div>

                    </section>

                </div>


                <!-- =================================================
                     RIGHT COLUMN
                ================================================== -->

                <div class="dashboard-right">


                    <!-- NOTIFICATIONS -->

                    <section class="dashboard-panel notification-panel">

                        <div class="panel-header">

                            <div class="panel-title">

                                <div class="panel-icon red">
                                    <i class="bi bi-bell-fill"></i>
                                </div>

                                <div>

                                    <h3>
                                        Notifications
                                    </h3>

                                    <p>
                                        Latest updates for you
                                    </p>

                                </div>

                            </div>


                            <% if ((unreadNotificationCount || 0) > 0) { %>

                                <span class="new-badge">
                                    <%= unreadNotificationCount %> New
                                </span>

                            <% } %>

                        </div>


                        <% if (notifications && notifications.length > 0) { %>

                            <div class="notification-list">

                                <% notifications.slice(0, 6).forEach(notification => { %>

                                    <div
                                        class="notification-item <%= notification.isRead ? '' : 'unread' %>"
                                    >

                                        <div class="notification-item-icon">

                                            <i class="bi bi-bell-fill"></i>

                                        </div>


                                        <div class="notification-item-content">

                                            <div class="notification-item-top">

                                                <strong>
                                                    <%= notification.title %>
                                                </strong>

                                                <% if (!notification.isRead) { %>

                                                    <span class="unread-dot"></span>

                                                <% } %>

                                            </div>


                                            <p>
                                                <%= notification.message %>
                                            </p>


                                            <small>

                                                <i class="bi bi-clock"></i>

                                                <%= new Date(
                                                    notification.createdAt
                                                ).toLocaleString("en-IN", {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric",
                                                    hour: "2-digit",
                                                    minute: "2-digit"
                                                }) %>

                                            </small>

                                        </div>

                                    </div>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <div class="empty-modern compact">

                                <div class="empty-modern-icon">
                                    <i class="bi bi-bell-slash"></i>
                                </div>

                                <h4>
                                    No notifications
                                </h4>

                                <p>
                                    You don't have any notifications yet.
                                </p>

                            </div>

                        <% } %>

                    </section>


                    <!-- LATEST NOTICES -->

                    <section class="dashboard-panel">

                        <div class="panel-header">

                            <div class="panel-title">

                                <div class="panel-icon orange">
                                    <i class="bi bi-megaphone-fill"></i>
                                </div>

                                <div>

                                    <h3>
                                        Latest Notices
                                    </h3>

                                    <p>
                                        Important university updates
                                    </p>

                                </div>

                            </div>


                            <a
                                href="/student/notices"
                                class="panel-link"
                            >
                                View All
                            </a>

                        </div>


                        <div class="empty-modern compact">

                            <div class="empty-modern-icon orange">
                                <i class="bi bi-bell-slash"></i>
                            </div>

                            <h4>
                                No notices yet
                            </h4>

                            <p>
                                New notices will appear here.
                            </p>

                        </div>

                    </section>


                    <!-- ACADEMIC INFORMATION -->

                    <section class="dashboard-panel">

                        <div class="panel-header">

                            <div class="panel-title">

                                <div class="panel-icon blue">
                                    <i class="bi bi-mortarboard-fill"></i>
                                </div>

                                <div>

                                    <h3>
                                        Academic Information
                                    </h3>

                                    <p>
                                        Your current academic details
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="academic-list">

                            <div class="academic-row">

                                <span>
                                    <i class="bi bi-building"></i>
                                    Department
                                </span>

                                <strong>
                                    Not Assigned
                                </strong>

                            </div>


                            <div class="academic-row">

                                <span>
                                    <i class="bi bi-book"></i>
                                    Program
                                </span>

                                <strong>
                                    Not Assigned
                                </strong>

                            </div>


                            <div class="academic-row">

                                <span>
                                    <i class="bi bi-layers"></i>
                                    Semester
                                </span>

                                <strong>
                                    Not Assigned
                                </strong>

                            </div>


                            <div class="academic-row">

                                <span>
                                    <i class="bi bi-diagram-3"></i>
                                    Section
                                </span>

                                <strong>
                                    Not Assigned
                                </strong>

                            </div>

                        </div>

                    </section>


                    <!-- CAMPUS SERVICES -->

                    <section class="dashboard-panel">

                        <div class="panel-header">

                            <div class="panel-title">

                                <div class="panel-icon green">
                                    <i class="bi bi-building-check"></i>
                                </div>

                                <div>

                                    <h3>
                                        Campus Services
                                    </h3>

                                    <p>
                                        Essential campus facilities
                                    </p>

                                </div>

                            </div>

                        </div>


                        <div class="campus-service-list">


                            <a
                                href="#"
                                class="campus-service-item"
                            >

                                <div class="campus-service-icon library">
                                    <i class="bi bi-book"></i>
                                </div>

                                <div>
                                    <strong>Library</strong>
                                    <span>Access library services</span>
                                </div>

                                <i class="bi bi-arrow-up-right"></i>

                            </a>


                            <a
                                href="/student/gate-passes"
                                class="campus-service-item"
                            >

                                <div class="campus-service-icon gate">
                                    <i class="bi bi-door-open"></i>
                                </div>

                                <div>
                                    <strong>Gate Pass</strong>
                                    <span>Apply and view gate pass</span>
                                </div>

                                <i class="bi bi-arrow-up-right"></i>

                            </a>


                            <a
                                href="/student/certificates"
                                class="campus-service-item"
                            >

                                <div class="campus-service-icon certificate">
                                    <i class="bi bi-file-earmark-medical"></i>
                                </div>

                                <div>
                                    <strong>Certificates</strong>
                                    <span>Apply for certificates</span>
                                </div>

                                <i class="bi bi-arrow-up-right"></i>

                            </a>

                        </div>

                    </section>


                    <!-- GROUP PROMO -->

                    <section class="group-promo">

                        <div class="promo-decoration"></div>

                        <div class="promo-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <span>
                            OFFICIAL CAMPUS GROUPS
                        </span>

                        <h3>
                            College Group Links
                        </h3>

                        <p>
                            Join official university, department
                            and class groups.
                        </p>

                        <a
                            href="/student/group-links"
                            class="promo-button"
                        >
                            Open Groups
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </section>

                </div>

            </div>

        </div>

    </main>

</div>
<!-- =============================================================
     CAMPUSNEXUS AI
============================================================== -->

<div class="floating-ai" id="floatingAI">

    <!-- AI CHAT WINDOW -->
    <div class="ai-chat-window" id="aiChatWindow">

        <!-- HEADER -->
        <div class="ai-chat-header">

            <div class="ai-chat-brand">

                <div class="ai-chat-logo">
                    <img
                        src="/images/logo3.png"
                        alt="CampusNexus AI"
                        onerror="this.style.display='none';"
                    >
                </div>

                <div class="ai-chat-brand-text">
                    <strong>CampusNexus AI</strong>
                    <span>Your campus assistant</span>
                </div>

            </div>

