
<% layout("layouts/boilerplate") -%>

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-ticket-perforated text-primary me-2"></i>
                My Gate Passes
            </h2>

            <p class="text-muted mb-0">
                Track your gate pass applications and approval status.
            </p>
        </div>

        <a
            href="/student/gate-pass"
            class="btn btn-primary"
        >
            <i class="bi bi-plus-circle me-1"></i>
            Apply New Gate Pass
        </a>

    </div>


    <!-- Flash Messages -->
    <% if (typeof success !== "undefined" && success && success.length) { %>

        <% success.forEach(message => { %>

            <div
                class="alert alert-success alert-dismissible fade show"
                role="alert"
            >
                <i class="bi bi-check-circle me-2"></i>

                <%= message %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% }) %>

    <% } %>


    <% if (typeof error !== "undefined" && error && error.length) { %>

        <% error.forEach(message => { %>

            <div
                class="alert alert-danger alert-dismissible fade show"
                role="alert"
            >
                <i class="bi bi-exclamation-circle me-2"></i>

                <%= message %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                ></button>

            </div>

        <% }) %>

    <% } %>


    <!-- Empty State -->
    <% if (!gatePasses || gatePasses.length === 0) { %>

        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div
                    class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                    style="width: 80px; height: 80px;"
                >
                    <i class="bi bi-ticket-perforated fs-1 text-muted"></i>
                </div>

                <h4 class="fw-bold">
                    No Gate Pass Applications
                </h4>

                <p class="text-muted mb-4">
                    You haven't submitted any gate pass application yet.
                </p>

                <a
                    href="/student/gate-pass"
                    class="btn btn-primary"
                >
                    <i class="bi bi-plus-circle me-1"></i>
                    Apply for Gate Pass
                </a>

            </div>

        </div>

    <% } else { %>


        <!-- Gate Pass List -->
        <div class="row g-4">

            <% gatePasses.forEach(gatePass => { %>

                <div class="col-12">

                    <div class="card border-0 shadow-sm">

                        <!-- Card Header -->
                        <div class="card-header bg-white border-bottom p-3">

                            <div class="d-flex flex-column flex-md-row justify-content-between gap-3">

                                <div>

                                    <div class="d-flex align-items-center gap-2 mb-1">

                                        <span class="fw-bold">
                                            <%= gatePass.applicationNumber || "Gate Pass Application" %>
                                        </span>


                                        <% if (gatePass.status === "pending") { %>

                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock me-1"></i>
                                                Pending
                                            </span>

                                        <% } else if (gatePass.status === "approved") { %>

                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Approved
                                            </span>

                                        <% } else if (gatePass.status === "rejected") { %>

                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Rejected
                                            </span>

                                        <% } else if (gatePass.status === "expired") { %>

                                            <span class="badge bg-secondary">
                                                <i class="bi bi-hourglass-bottom me-1"></i>
                                                Expired
                                            </span>

                                        <% } else if (gatePass.status === "used") { %>

                                            <span class="badge bg-info text-dark">
                                                <i class="bi bi-check2-all me-1"></i>
                                                Used
                                            </span>

                                        <% } else if (gatePass.status === "cancelled") { %>

                                            <span class="badge bg-dark">
                                                <i class="bi bi-slash-circle me-1"></i>
                                                Cancelled
                                            </span>

                                        <% } %>

                                    </div>


                                    <small class="text-muted">

                                        Applied on

                                        <%= gatePass.createdAt
                                            ? new Date(gatePass.createdAt).toLocaleDateString("en-IN", {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric"
                                            })
                                            : "N/A"
                                        %>

                                    </small>

                                </div>


                                <!-- Pass Type -->
                                <div class="text-md-end">

                                    <% if (gatePass.passType === "outing") { %>

                                        <span class="badge rounded-pill bg-primary-subtle text-primary">

                                            <i class="bi bi-person-walking me-1"></i>

                                            Outing

                                        </span>

                                    <% } else if (gatePass.passType === "leave") { %>

                                        <span class="badge rounded-pill bg-info-subtle text-info-emphasis">

                                            <i class="bi bi-calendar-event me-1"></i>

                                            Leave

                                        </span>

                                    <% } else if (gatePass.passType === "emergency") { %>

                                        <span class="badge rounded-pill bg-danger-subtle text-danger">

                                            <i class="bi bi-exclamation-triangle me-1"></i>

                                            Emergency

                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>


                        <!-- Card Body -->
                        <div class="card-body p-4">

                            <div class="row g-4">

                                <!-- Date -->
                                <div class="col-12 col-md-6 col-lg-3">

                                    <div class="text-muted small mb-1">

                                        <i class="bi bi-calendar3 me-1"></i>

                                        Exit Date

                                    </div>

                                    <div class="fw-semibold">

                                        <%= gatePass.exitDate
                                            ? new Date(gatePass.exitDate).toLocaleDateString("en-IN", {
                                                day: "2-digit",
                                                month: "long",
                                                year: "numeric"
                                            })
                                            : "N/A"
                                        %>

                                    </div>

                                </div>


                                <!-- Exit Time -->
                                <div class="col-12 col-md-6 col-lg-3">

                                    <div class="text-muted small mb-1">

                                        <i class="bi bi-box-arrow-right me-1"></i>

                                        Expected Exit

                                    </div>

                                    <div class="fw-semibold">

                                        <%= gatePass.expectedExitTime || "N/A" %>

                                    </div>

                                </div>


                                <!-- Return Time -->
                                <div class="col-12 col-md-6 col-lg-3">

                                    <div class="text-muted small mb-1">

                                        <i class="bi bi-box-arrow-in-left me-1"></i>

                                        Expected Return

                                    </div>

                                    <div class="fw-semibold">

                                        <%= gatePass.expectedReturnTime || "N/A" %>

                                    </div>

                                </div>


                                <!-- Destination -->
                                <div class="col-12 col-md-6 col-lg-3">

                                    <div class="text-muted small mb-1">

                                        <i class="bi bi-geo-alt me-1"></i>

                                        Destination

                                    </div>

                                    <div class="fw-semibold">

                                        <%= gatePass.destination || "N/A" %>

                                    </div>

                                </div>


                                <!-- Reason -->
                                <div class="col-12">

                                    <div class="text-muted small mb-1">

                                        <i class="bi bi-chat-left-text me-1"></i>

                                        Reason

                                    </div>

                                    <div class="p-3 bg-light rounded">

                                        <%= gatePass.reason || "No reason provided." %>

                                    </div>

                                </div>


                                <!-- Additional Remarks -->
                                <% if (gatePass.additionalRemarks) { %>

                                    <div class="col-12">

                                        <div class="text-muted small mb-1">

                                            <i class="bi bi-info-circle me-1"></i>

                                            Additional Remarks

                                        </div>

                                        <div class="p-3 bg-light rounded">

                                            <%= gatePass.additionalRemarks %>

                                        </div>

                                    </div>

                                <% } %>


                                <!-- Admin Remarks -->
                                <% if (gatePass.adminRemarks) { %>

                                    <div class="col-12">

                                        <div class="text-muted small mb-1">

                                            <i class="bi bi-person-badge me-1"></i>

                                            Admin Remarks

                                        </div>

                                        <div
                                            class="alert <%= gatePass.status === 'rejected'
                                                ? 'alert-danger'
                                                : 'alert-success'
                                            %> mb-0"
                                        >

                                            <%= gatePass.adminRemarks %>

                                        </div>

                                    </div>

                                <% } %>

                            </div>

                        </div>


                        <!-- Card Footer / Actions -->
                        <div class="card-footer bg-white border-top p-3">

                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">


                                <!-- Pending -->
                                <% if (gatePass.status === "pending") { %>

                                    <div class="text-muted small">

                                        <i class="bi bi-info-circle me-1"></i>

                                        Your gate pass is waiting for
                                        admin approval.

                                    </div>

                                    <button
                                        type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        disabled
                                    >

                                        <i class="bi bi-hourglass-split me-1"></i>

                                        Awaiting Approval

                                    </button>


                                <!-- Approved -->
                                <% } else if (gatePass.status === "approved") { %>

                                    <div class="text-success small">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Gate pass approved.
                                        You can now generate your QR pass.

                                    </div>


                                    <% if (!gatePass.qrToken) { %>

                                        <form
                                            action="/student/gate-pass/<%= gatePass._id %>/generate-qr"
                                            method="POST"
                                            onsubmit="console.log('QR FORM SUBMITTED:', this.action);"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-success btn-sm"
                                            >

                                                <i class="bi bi-qr-code me-1"></i>

                                                Generate QR Pass

                                            </button>

                                        </form>

                                    <% } else { %>

                                    
                                              <a
                                                   href="/student/gate-pass/<%= gatePass._id %>/qr"
                                                   class="btn btn-success btn-sm"
                                               >
                                                   <i class="bi bi-qr-code me-1"></i>
                                                        View QR Pass
                                              </a>


                                    <% } %>


                                <!-- Rejected -->
                                <% } else if (gatePass.status === "rejected") { %>

                                    <div class="text-danger small">

                                        <i class="bi bi-x-circle me-1"></i>

                                        This gate pass application
                                        was rejected.

                                    </div>

                                    <a
                                        href="/student/gate-pass"
                                        class="btn btn-outline-primary btn-sm"
                                    >

                                        <i class="bi bi-arrow-repeat me-1"></i>

                                        Apply Again

                                    </a>


                                <!-- Expired -->
                                <% } else if (gatePass.status === "expired") { %>

                                    <div class="text-muted small">

                                        <i class="bi bi-hourglass-bottom me-1"></i>

                                        This gate pass has expired.

                                    </div>

                                    <a
                                        href="/student/gate-pass"
                                        class="btn btn-outline-primary btn-sm"
                                    >

                                        <i class="bi bi-plus-circle me-1"></i>

                                        New Gate Pass

                                    </a>


                                <!-- Used -->
                                <% } else if (gatePass.status === "used") { %>

                                    <div class="text-info small">

                                        <i class="bi bi-check2-all me-1"></i>

                                        This gate pass has already been used.

                                    </div>


                                <!-- Cancelled -->
                                <% } else if (gatePass.status === "cancelled") { %>

                                    <div class="text-muted small">

                                        <i class="bi bi-slash-circle me-1"></i>

                                        This gate pass was cancelled.

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>
