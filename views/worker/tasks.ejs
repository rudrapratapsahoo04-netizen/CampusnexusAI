<% layout("layouts/boilerplate") -%>
    <style>

        * {
            box-sizing: border-box;
        }


        body {
            margin: 0;
            min-height: 100vh;

            font-family: "Inter", sans-serif;

            color: #172033;

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(37, 99, 235, .08),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 20%,
                    rgba(124, 58, 237, .07),
                    transparent 30%
                ),
                #f7f9fc;
        }


        a {
            text-decoration: none;
        }


        /* =====================================================
           NAVBAR
        ===================================================== */

        .top-navbar {
            position: sticky;
            top: 0;
            z-index: 1000;

            padding: 13px 0;

            background: rgba(255, 255, 255, .88);

            border-bottom: 1px solid #e8edf4;

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }


        .brand {
            display: flex;
            align-items: center;
            gap: 10px;

            color: #172033;
            font-size: 1rem;
            font-weight: 800;
        }


        .brand-icon {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #4f46e5
                );

            box-shadow:
                0 7px 18px rgba(37, 99, 235, .20);
        }


        .nav-worker {
            display: flex;
            align-items: center;
            gap: 9px;

            padding: 7px 11px;

            border: 1px solid #e6ebf2;
            border-radius: 12px;

            background: #fff;
        }


        .nav-avatar {
            width: 31px;
            height: 31px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #f59e0b,
                    #ea580c
                );

            font-size: .72rem;
            font-weight: 800;
        }


        .nav-worker-name {
            max-width: 150px;

            overflow: hidden;

            color: #334155;

            font-size: .72rem;
            font-weight: 700;

            white-space: nowrap;
            text-overflow: ellipsis;
        }


        /* =====================================================
           PAGE
        ===================================================== */

        .page-wrapper {
            max-width: 1180px;

            margin: 0 auto;

            padding:
                32px 18px
                60px;
        }


        .page-header {
            display: flex;

            align-items: flex-end;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 24px;
        }


        .eyebrow {
            margin-bottom: 7px;

            color: #2563eb;

            font-size: .67rem;
            font-weight: 800;

            text-transform: uppercase;
            letter-spacing: .13em;
        }


        .page-title {
            margin: 0;

            color: #172033;

            font-size: clamp(
                1.55rem,
                3vw,
                2.15rem
            );

            font-weight: 800;

            letter-spacing: -.04em;
        }


        .page-subtitle {
            max-width: 650px;

            margin:
                8px 0 0;

            color: #64748b;

            font-size: .82rem;

            line-height: 1.65;
        }


        .back-button {
            display: inline-flex;

            align-items: center;
            gap: 7px;

            flex-shrink: 0;

            padding: 10px 14px;

            color: #475569;

            background: white;

            border: 1px solid #e2e8f0;

            border-radius: 12px;

            font-size: .73rem;
            font-weight: 700;

            transition: .2s ease;
        }


        .back-button:hover {
            color: #2563eb;

            border-color: #bfdbfe;

            background: #eff6ff;

            transform: translateY(-2px);
        }


        /* =====================================================
           FLASH MESSAGES
        ===================================================== */

        .alert {
            border-radius: 14px;

            border: 1px solid transparent;

            font-size: .76rem;

            box-shadow:
                0 7px 20px rgba(15, 23, 42, .04);
        }


        /* =====================================================
           SUMMARY
        ===================================================== */

        .summary-grid {
            display: grid;

            grid-template-columns:
                repeat(4, minmax(0, 1fr));

            gap: 13px;

            margin-bottom: 24px;
        }


        .summary-card {
            position: relative;

            overflow: hidden;

            padding: 17px;

            background: rgba(255, 255, 255, .92);

            border: 1px solid #e5eaf2;

            border-radius: 17px;

            box-shadow:
                0 8px 25px rgba(15, 23, 42, .045);

            transition:
                transform .22s ease,
                box-shadow .22s ease;
        }


        .summary-card:hover {
            transform: translateY(-3px);

            box-shadow:
                0 14px 32px rgba(15, 23, 42, .08);
        }


        .summary-icon {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 12px;

            border-radius: 11px;

            font-size: .95rem;
        }


        .summary-label {
            color: #64748b;

            font-size: .65rem;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: .06em;
        }


        .summary-value {
            margin-top: 4px;

            color: #172033;

            font-size: 1.3rem;
            font-weight: 800;
        }


        .summary-blue .summary-icon {
            color: #2563eb;
            background: #eff6ff;
        }


        .summary-orange .summary-icon {
            color: #ea580c;
            background: #fff7ed;
        }


        .summary-green .summary-icon {
            color: #16a34a;
            background: #f0fdf4;
        }


        .summary-purple .summary-icon {
            color: #7c3aed;
            background: #f5f3ff;
        }


        /* =====================================================
           TASK CARD
        ===================================================== */

        .task-list {
            display: flex;

            flex-direction: column;

            gap: 16px;
        }


        .task-card {
            position: relative;

            overflow: hidden;

            padding: 21px;

            background:
                rgba(255, 255, 255, .96);

            border: 1px solid #e4e9f1;

            border-radius: 20px;

            box-shadow:
                0 8px 28px rgba(15, 23, 42, .045);

            transition:
                transform .23s ease,
                box-shadow .23s ease,
                border-color .23s ease;
        }


        .task-card::before {
            content: "";

            position: absolute;

            left: 0;
            top: 0;
            bottom: 0;

            width: 4px;

            background:
                linear-gradient(
                    180deg,
                    #2563eb,
                    #7c3aed
                );
        }


        .task-card:hover {
            transform: translateY(-3px);

            border-color: #d7deea;

            box-shadow:
                0 16px 38px rgba(15, 23, 42, .075);
        }


        .task-top {
            display: flex;

            align-items: flex-start;
            justify-content: space-between;

            gap: 18px;
        }


        .task-title-area {
            min-width: 0;
        }


        .task-title {
            margin: 0;

            color: #172033;

            font-size: 1rem;
            font-weight: 800;

            line-height: 1.4;
        }


        .task-description {
            margin: 8px 0 0;

            color: #64748b;

            font-size: .76rem;

            line-height: 1.7;

            white-space: pre-line;
        }


        .badges {
            display: flex;

            flex-wrap: wrap;

            justify-content: flex-end;

            gap: 6px;

            flex-shrink: 0;
        }


        .badge-custom {
            display: inline-flex;

            align-items: center;
            gap: 5px;

            padding: 6px 9px;

            border-radius: 999px;

            font-size: .61rem;
            font-weight: 800;

            white-space: nowrap;
        }


        .status-assigned {
            color: #1d4ed8;
            background: #eff6ff;
        }


        .status-progress {
            color: #c2410c;
            background: #fff7ed;
        }


        .status-completed {
            color: #15803d;
            background: #f0fdf4;
        }


        .status-closed {
            color: #475569;
            background: #f1f5f9;
        }


        .priority-low {
            color: #15803d;
            background: #f0fdf4;
        }


        .priority-medium {
            color: #2563eb;
            background: #eff6ff;
        }


        .priority-high {
            color: #c2410c;
            background: #fff7ed;
        }


        .priority-urgent {
            color: #b91c1c;
            background: #fef2f2;
        }


        /* =====================================================
           META
        ===================================================== */

        .task-meta {
            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            gap: 10px;

            margin-top: 18px;

            padding-top: 16px;

            border-top: 1px solid #edf1f6;
        }


        .meta-item {
            display: flex;

            align-items: center;

            gap: 9px;

            min-width: 0;
        }


        .meta-icon {
            width: 32px;
            height: 32px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex: 0 0 auto;

            color: #2563eb;

            background: #eff6ff;

            border-radius: 10px;

            font-size: .78rem;
        }


        .meta-text {
            min-width: 0;
        }


        .meta-label {
            display: block;

            color: #94a3b8;

            font-size: .59rem;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: .05em;
        }


        .meta-value {
            display: block;

            margin-top: 2px;

            overflow: hidden;

            color: #475569;

            font-size: .69rem;
            font-weight: 700;

            white-space: nowrap;
            text-overflow: ellipsis;
        }


        /* =====================================================
           COMPLETION MESSAGE
        ===================================================== */

        .completion-box {
            margin-top: 16px;

            padding: 14px 15px;

            border: 1px solid #bbf7d0;

            border-radius: 14px;

            background: #f0fdf4;
        }


        .completion-heading {
            display: flex;

            align-items: center;

            gap: 7px;

            margin-bottom: 6px;

            color: #15803d;

            font-size: .69rem;
            font-weight: 800;
        }


        .completion-message {
            margin: 0;

            color: #166534;

            font-size: .73rem;

            line-height: 1.6;

            white-space: pre-line;
        }


        /* =====================================================
           TASK ACTIONS
        ===================================================== */

        .task-actions {
            display: flex;

            justify-content: flex-end;

            gap: 8px;

            margin-top: 17px;
        }


        .task-button {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            gap: 7px;

            padding: 9px 13px;

            border-radius: 11px;

            font-size: .7rem;
            font-weight: 800;

            border: 1px solid transparent;

            transition: .2s ease;

            cursor: pointer;
        }


        .start-button {
            color: white;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #4f46e5
                );

            box-shadow:
                0 7px 17px rgba(37, 99, 235, .16);
        }


        .start-button:hover {
            color: white;

            transform: translateY(-2px);

            box-shadow:
                0 10px 22px rgba(37, 99, 235, .23);
        }


        .complete-button {
            color: white;

            background:
                linear-gradient(
                    135deg,
                    #16a34a,
                    #15803d
                );

            box-shadow:
                0 7px 17px rgba(22, 163, 74, .15);
        }


        .complete-button:hover {
            color: white;

            transform: translateY(-2px);

            box-shadow:
                0 10px 22px rgba(22, 163, 74, .22);
        }


        .completed-label {
            display: inline-flex;

            align-items: center;
            gap: 6px;

            padding: 9px 12px;

            color: #15803d;

            background: #f0fdf4;

            border: 1px solid #bbf7d0;

            border-radius: 11px;

            font-size: .68rem;
            font-weight: 800;
        }


        .closed-label {
            display: inline-flex;

            align-items: center;
            gap: 6px;

            padding: 9px 12px;

            color: #475569;

            background: #f8fafc;

            border: 1px solid #e2e8f0;

            border-radius: 11px;

            font-size: .68rem;
            font-weight: 800;
        }


        /* =====================================================
           EMPTY STATE
        ===================================================== */

        .empty-state {
            padding: 60px 25px;

            text-align: center;

            background:
                rgba(255, 255, 255, .94);

            border: 1px solid #e5eaf2;

            border-radius: 22px;

            box-shadow:
                0 10px 30px rgba(15, 23, 42, .045);
        }


        .empty-icon {
            width: 70px;
            height: 70px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin: 0 auto 17px;

            color: #2563eb;

            background: #eff6ff;

            border-radius: 20px;

            font-size: 1.6rem;
        }


        .empty-state h3 {
            margin: 0;

            color: #334155;

            font-size: 1rem;
            font-weight: 800;
        }


        .empty-state p {
            max-width: 450px;

            margin:
                8px auto 0;

            color: #94a3b8;

            font-size: .74rem;

            line-height: 1.7;
        }


        /* =====================================================
           MODAL
        ===================================================== */

        .modal-content {
            overflow: hidden;

            border: 0;

            border-radius: 20px;

            box-shadow:
                0 25px 70px rgba(15, 23, 42, .18);
        }


        .modal-header {
            padding: 19px 21px;

            border-bottom: 1px solid #edf1f6;
        }


        .modal-title {
            color: #172033;

            font-size: .95rem;
            font-weight: 800;
        }


        .modal-body {
            padding: 21px;
        }


        .modal-task-title {
            margin-bottom: 17px;

            color: #64748b;

            font-size: .72rem;
        }


        .form-label {
            margin-bottom: 7px;

            color: #334155;

            font-size: .7rem;
            font-weight: 800;
        }


        .form-control {
            padding: 11px 12px;

            color: #334155;

            border-color: #dfe5ed;

            border-radius: 11px;

            font-size: .76rem;

            box-shadow: none;
        }


        .form-control:focus {
            border-color: #93c5fd;

            box-shadow:
                0 0 0 3px rgba(
                    37,
                    99,
                    235,
                    .08
                );
        }


        .modal-footer {
            padding: 14px 21px;

            border-top: 1px solid #edf1f6;
        }


        .cancel-button {
            padding: 9px 13px;

            color: #475569;

            background: #f8fafc;

            border: 1px solid #e2e8f0;

            border-radius: 10px;

            font-size: .7rem;
            font-weight: 700;
        }


        .submit-complete {
            padding: 9px 14px;

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #16a34a,
                    #15803d
                );

            border: 0;

            border-radius: 10px;

            font-size: .7rem;
            font-weight: 800;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media (max-width: 900px) {

            .summary-grid {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

        }


        @media (max-width: 700px) {

            .page-wrapper {
                padding:
                    24px 13px
                    45px;
            }


            .page-header {
                align-items: flex-start;

                flex-direction: column;
            }


            .back-button {
                width: 100%;

                justify-content: center;
            }


            .task-top {
                flex-direction: column;
            }


            .badges {
                justify-content: flex-start;
            }


            .task-meta {
                grid-template-columns:
                    1fr;
            }


            .task-actions {
                justify-content: stretch;

                flex-direction: column;
            }


            .task-button,
            .completed-label,
            .closed-label {
                width: 100%;
            }

        }


        @media (max-width: 480px) {

            .summary-grid {
                grid-template-columns: 1fr;
            }


            .nav-worker-name {
                display: none;
            }


            .task-card {
                padding: 17px;
            }

        }

    </style>
</head>


<body>


    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <nav class="top-navbar">

        <div class="container">

            <div
                class="d-flex align-items-center justify-content-between"
            >

                <a
                    href="/worker/dashboard"
                    class="brand"
                >

                    <span class="brand-icon">
                        <i class="bi bi-buildings"></i>
                    </span>

                    <span>
                        CampusNexus
                    </span>

                </a>


                <div class="nav-worker">

                    <div class="nav-avatar">
                        <%= user?.name
                            ? user.name
                                .split(" ")
                                .map(n => n[0])
                                .join("")
                                .substring(0, 2)
                                .toUpperCase()
                            : "W"
                        %>
                    </div>

                    <span class="nav-worker-name">
                        <%= user?.name || "Worker" %>
                    </span>

                </div>

            </div>

        </div>

    </nav>


    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="page-wrapper">


        <!-- PAGE HEADER -->

        <div class="page-header">

            <div>

                <div class="eyebrow">
                    Worker Portal
                </div>

                <h1 class="page-title">
                    My Work
                </h1>

                <p class="page-subtitle">
                    View the work assigned to you, start your
                    tasks and send a completion update to the
                    administrator after finishing the work.
                </p>

            </div>


            <a
                href="/worker/dashboard"
                class="back-button"
            >
                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

        </div>


        <!-- =================================================
             FLASH MESSAGES
        ================================================== -->

        <% if (typeof success !== "undefined" && success) { %>

            <div
                class="alert alert-success d-flex align-items-center gap-2 mb-4"
                role="alert"
            >

                <i class="bi bi-check-circle-fill"></i>

                <span>
                    <%= success %>
                </span>

            </div>

        <% } %>


        <% if (typeof error !== "undefined" && error) { %>

            <div
                class="alert alert-danger d-flex align-items-center gap-2 mb-4"
                role="alert"
            >

                <i class="bi bi-exclamation-circle-fill"></i>

                <span>
                    <%= error %>
                </span>

            </div>

        <% } %>


        <!-- =================================================
             SUMMARY
        ================================================== -->

        <%
            const taskList = Array.isArray(tasks)
                ? tasks
                : [];

            const totalTasks = taskList.length;

            const assignedTasks =
                taskList.filter(
                    task =>
                        task.status === "assigned"
                ).length;

            const progressTasks =
                taskList.filter(
                    task =>
                        task.status === "in-progress"
                ).length;

            const completedTasks =
                taskList.filter(
                    task =>
                        task.status === "completed" ||
                        task.status === "closed"
                ).length;
        %>


        <div class="summary-grid">


            <div class="summary-card summary-blue">

                <div class="summary-icon">
                    <i class="bi bi-clipboard2-check"></i>
                </div>

                <div class="summary-label">
                    Total Tasks
                </div>

                <div class="summary-value">
                    <%= totalTasks %>
                </div>

            </div>


            <div class="summary-card summary-orange">

                <div class="summary-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div class="summary-label">
                    Assigned
                </div>

                <div class="summary-value">
                    <%= assignedTasks %>
                </div>

            </div>


            <div class="summary-card summary-purple">

                <div class="summary-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div class="summary-label">
                    In Progress
                </div>

                <div class="summary-value">
                    <%= progressTasks %>
                </div>

            </div>


            <div class="summary-card summary-green">

                <div class="summary-icon">
                    <i class="bi bi-check2-circle"></i>
                </div>

                <div class="summary-label">
                    Completed
                </div>

                <div class="summary-value">
                    <%= completedTasks %>
                </div>

            </div>

        </div>


        <!-- =================================================
             TASK LIST
        ================================================== -->

        <% if (taskList.length > 0) { %>

            <div class="task-list">


                <% taskList.forEach(task => { %>

                    <%
                        let statusText = "Assigned";
                        let statusClass = "status-assigned";
                        let statusIcon = "bi-clipboard-check";

                        if (task.status === "in-progress") {
                            statusText = "In Progress";
                            statusClass = "status-progress";
                            statusIcon = "bi-arrow-repeat";
                        }

                        if (task.status === "completed") {
                            statusText = "Completed";
                            statusClass = "status-completed";
                            statusIcon = "bi-check-circle";
                        }

                        if (task.status === "closed") {
                            statusText = "Closed";
                            statusClass = "status-closed";
                            statusIcon = "bi-lock";
                        }


                        let priorityText =
                            task.priority
                                ? task.priority.charAt(0).toUpperCase() +
                                  task.priority.slice(1)
                                : "Medium";

                        let priorityClass =
                            "priority-medium";

                        if (task.priority === "low") {
                            priorityClass = "priority-low";
                        }

                        if (task.priority === "high") {
                            priorityClass = "priority-high";
                        }

                        if (task.priority === "urgent") {
                            priorityClass = "priority-urgent";
                        }


                        let taskTypeText =
                            task.taskType
                                ? task.taskType.charAt(0).toUpperCase() +
                                  task.taskType.slice(1)
                                : "Other";


                        let assignedDate = task.assignedAt
                            ? new Date(
                                task.assignedAt
                            ).toLocaleDateString(
                                "en-IN",
                                {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric"
                                }
                            )
                            : "Not available";


                        let dueDate = task.dueDate
                            ? new Date(
                                task.dueDate
                            ).toLocaleDateString(
                                "en-IN",
                                {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric"
                                }
                            )
                            : "No deadline";


                        let completedDate = task.completedAt
                            ? new Date(
                                task.completedAt
                            ).toLocaleDateString(
                                "en-IN",
                                {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric"
                                }
                            )
                            : "";
                    %>


                    <article class="task-card">


                        <!-- TASK TOP -->

                        <div class="task-top">


                            <div class="task-title-area">

                                <h2 class="task-title">
                                    <%= task.title %>
                                </h2>

                                <p class="task-description">
                                    <%= task.description %>
                                </p>

                            </div>


                            <div class="badges">

                                <span
                                    class="badge-custom <%= statusClass %>"
                                >

                                    <i
                                        class="bi <%= statusIcon %>"
                                    ></i>

                                    <%= statusText %>

                                </span>


                                <span
                                    class="badge-custom <%= priorityClass %>"
                                >

                                    <i class="bi bi-flag"></i>

                                    <%= priorityText %>

                                </span>

                            </div>

                        </div>


                        <!-- TASK META -->

                        <div class="task-meta">


                            <div class="meta-item">

                                <div class="meta-icon">
                                    <i class="bi bi-geo-alt"></i>
                                </div>

                                <div class="meta-text">

                                    <span class="meta-label">
                                        Location
                                    </span>

                                    <span class="meta-value">
                                        <%= task.location || "Not specified" %>
                                    </span>

                                </div>

                            </div>


                            <div class="meta-item">

                                <div class="meta-icon">
                                    <i class="bi bi-tools"></i>
                                </div>

                                <div class="meta-text">

                                    <span class="meta-label">
                                        Work Type
                                    </span>

                                    <span class="meta-value">
                                        <%= taskTypeText %>
                                    </span>

                                </div>

                            </div>


                            <div class="meta-item">

                                <div class="meta-icon">
                                    <i class="bi bi-person-badge"></i>
                                </div>

                                <div class="meta-text">

                                    <span class="meta-label">
                                        Assigned By
                                    </span>

                                    <span class="meta-value">

                                        <%= task.assignedBy?.name ||
                                            "Administrator" %>

                                    </span>

                                </div>

                            </div>


                            <div class="meta-item">

                                <div class="meta-icon">
                                    <i class="bi bi-calendar-event"></i>
                                </div>

                                <div class="meta-text">

                                    <span class="meta-label">
                                        Assigned
                                    </span>

                                    <span class="meta-value">
                                        <%= assignedDate %>
                                    </span>

                                </div>

                            </div>


                            <div class="meta-item">

                                <div class="meta-icon">
                                    <i class="bi bi-calendar2-check"></i>
                                </div>

                                <div class="meta-text">

                                    <span class="meta-label">
                                        Deadline
                                    </span>

                                    <span class="meta-value">
                                        <%= dueDate %>
                                    </span>

                                </div>

                            </div>


                            <% if (completedDate) { %>

                                <div class="meta-item">

                                    <div class="meta-icon">
                                        <i class="bi bi-check2"></i>
                                    </div>

                                    <div class="meta-text">

                                        <span class="meta-label">
                                            Completed
                                        </span>

                                        <span class="meta-value">
                                            <%= completedDate %>
                                        </span>

                                    </div>

                                </div>

                            <% } %>


                        </div>


                        <!-- =================================================
                             WORKER COMPLETION MESSAGE
                        ================================================== -->

                        <% if (
                            task.status === "completed" &&
                            task.workerCompletionMessage
                        ) { %>

                            <div class="completion-box">

                                <div class="completion-heading">

                                    <i class="bi bi-send-check-fill"></i>

                                    Completion Message Sent to Admin

                                </div>

                                <p class="completion-message">
                                    <%= task.workerCompletionMessage %>
                                </p>

                            </div>

                        <% } %>


                        <!-- =================================================
                             ACTIONS
                        ================================================== -->

                        <div class="task-actions">


                            <% if (task.status === "assigned") { %>

                                <form
                                    action="/worker/tasks/<%= task._id %>/start"
                                    method="POST"
                                >

                                    <button
                                        type="submit"
                                        class="task-button start-button"
                                    >

                                        <i class="bi bi-play-fill"></i>

                                        Start Work

                                    </button>

                                </form>

                            <% } %>


                            <% if (
                                task.status === "assigned" ||
                                task.status === "in-progress"
                            ) { %>

                                <button
                                    type="button"
                                    class="task-button complete-button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#completeTaskModal"
                                    data-task-id="<%= task._id %>"
                                    data-task-title="<%= task.title %>"
                                >

                                    <i class="bi bi-check2-circle"></i>

                                    Complete Work

                                </button>

                            <% } %>


                            <% if (task.status === "completed") { %>

                                <span class="completed-label">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Completion Sent to Admin

                                </span>

                            <% } %>


                            <% if (task.status === "closed") { %>

                                <span class="closed-label">

                                    <i class="bi bi-lock-fill"></i>

                                    Task Closed by Admin

                                </span>

                            <% } %>


                        </div>


                    </article>

                <% }) %>


            </div>


        <% } else { %>


            <!-- EMPTY STATE -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-clipboard2-x"></i>

                </div>

                <h3>
                    No Work Assigned Yet
                </h3>

                <p>
                    You currently don't have any work assigned
                    by the administrator. New tasks will appear
                    here when they are assigned to you.
                </p>

            </div>


        <% } %>


    </main>


    <!-- =====================================================
         COMPLETE TASK MODAL
    ====================================================== -->

    <div
        class="modal fade"
        id="completeTaskModal"
        tabindex="-1"
        aria-hidden="true"
    >

        <div
            class="modal-dialog modal-dialog-centered"
        >

            <div class="modal-content">


                <div class="modal-header">

                    <h5 class="modal-title">

                        <i
                            class="bi bi-check2-circle me-2"
                        ></i>

                        Complete Work

                    </h5>


                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                    ></button>

                </div>


                <form
                    id="completeTaskForm"
                    method="POST"
                    action=""
                >

                    <div class="modal-body">


                        <div class="modal-task-title">

                            Task:

                            <strong
                                id="modalTaskTitle"
                            >
                                Selected Task
                            </strong>

                        </div>


                        <label
                            for="completionMessage"
                            class="form-label"
                        >

                            Completion Message

                        </label>


                        <textarea
                            id="completionMessage"
                            name="completionMessage"
                            class="form-control"
                            rows="5"
                            maxlength="2000"
                            required
                            placeholder="Describe what work you completed and any important update for the administrator..."
                        ></textarea>


                        <div
                            class="mt-2 text-end"
                            style="font-size:.62rem;color:#94a3b8;"
                        >

                            Maximum 2000 characters

                        </div>


                    </div>


                    <div class="modal-footer">


                        <button
                            type="button"
                            class="cancel-button"
                            data-bs-dismiss="modal"
                        >

                            Cancel

                        </button>


                        <button
                            type="submit"
                            class="submit-complete"
                        >

                            <i class="bi bi-send-check me-1"></i>

                            Send Completion

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- Bootstrap JS -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


    <script>

        /*
         * Complete Work modal ko selected task ke saath
         * dynamically connect karna.
         */

        const completeModal =
            document.getElementById(
                "completeTaskModal"
            );

        const completeForm =
            document.getElementById(
                "completeTaskForm"
            );

        const modalTaskTitle =
            document.getElementById(
                "modalTaskTitle"
            );

        const completionMessage =
            document.getElementById(
                "completionMessage"
            );


        if (completeModal) {

            completeModal.addEventListener(
                "show.bs.modal",
                function (event) {

                    const button =
                        event.relatedTarget;

                    if (!button) {
                        return;
                    }


                    const taskId =
                        button.getAttribute(
                            "data-task-id"
                        );

                    const taskTitle =
                        button.getAttribute(
                            "data-task-title"
                        );


                    completeForm.action =
                        "/worker/tasks/" +
                        taskId +
                        "/complete";


                    modalTaskTitle.textContent =
                        taskTitle ||
                        "Selected Task";


                    completionMessage.value = "";

                }
            );

        }

    </script>


</body>

