.branch-status {
    font-size: 10px;

    color: #64748b;

    margin-top: 2px;
}

.branch-stat-row {
    display: flex;

    justify-content: space-between;

    border-top:
        1px solid rgba(255, 255, 255, .065);

    margin-top: 14px;

    padding-top: 12px;
}

.branch-stat-value {
    font-weight: 700;

    font-size: 13px;

    color: #e2e8f0;
}

.branch-stat-label {
    font-size: 9px;

    color: #64748b;
}


/* =========================================================
   DASHBOARD CARDS
========================================================= */

.dashboard-card {
    position: relative;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, .045),
            rgba(255, 255, 255, .018)
        );

    border:
        1px solid rgba(255, 255, 255, .08);

    border-radius: 15px;

    overflow: hidden;

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);

    box-shadow:
        0 10px 40px rgba(0, 0, 0, .10);

    transition:
        border-color var(--transition),
        box-shadow var(--transition);
}

.dashboard-card:hover {
    border-color:
        rgba(56, 189, 248, .22);

    box-shadow:
        0 15px 50px rgba(0, 0, 0, .15),
        0 0 25px rgba(56, 189, 248, .045);
}

.dashboard-card-header {
    padding: 16px 18px;

    border-bottom:
        1px solid rgba(255, 255, 255, .07);

    display: flex;

    justify-content: space-between;

    align-items: center;

    background:
        rgba(255, 255, 255, .018);
}


/* =========================================================
   TABLE
========================================================= */

.table {
    margin: 0;

    color: #cbd5e1;
}

.table th {
    background:
        rgba(255, 255, 255, .025);

    color: #64748b;

    font-size: 9px;

    text-transform: uppercase;

    letter-spacing: .07em;

    font-weight: 750;

    border-bottom:
        1px solid rgba(255, 255, 255, .07);

    padding: 12px 15px;

    white-space: nowrap;
}

.table td {
    padding: 13px 15px;

    vertical-align: middle;

    font-size: 11px;

    color: #cbd5e1;

    border-color:
        rgba(255, 255, 255, .055);

    background: transparent;

    transition:
        background var(--transition),
        color var(--transition);
}

.table tbody tr {
    transition: var(--transition);
}

.table tbody tr:hover td {
    background:
        rgba(56, 189, 248, .045);

    color: #f1f5f9;
}

.user-cell {
    display: flex;

    align-items: center;

    gap: 10px;
}

.user-avatar {
    width: 32px;
    height: 32px;

    border-radius: 9px;

    background:
        linear-gradient(
            135deg,
            rgba(37, 99, 235, .20),
            rgba(139, 92, 246, .15)
        );

    color: #7dd3fc;

    border:
        1px solid rgba(56, 189, 248, .15);

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 9px;

    font-weight: 750;

    flex-shrink: 0;

    transition: var(--transition);
}

tr:hover .user-avatar {
    border-color:
        rgba(56, 189, 248, .40);

    box-shadow:
        0 0 18px rgba(56, 189, 248, .10);
}

.user-name {
    font-size: 11px;

    font-weight: 700;

    color: #e2e8f0;
}

.user-email {
    color: #64748b;

    font-size: 9px;

    margin-top: 2px;
}


/* =========================================================
   STATUS
========================================================= */

.status-badge {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    padding: 4px 8px;

    border-radius: 20px;

    font-size: 9px;

    font-weight: 650;

    border: 1px solid transparent;
}

.status-active {
    background:
        rgba(52, 211, 153, .08);

    color: #6ee7b7;

    border-color:
        rgba(52, 211, 153, .15);
}

.status-inactive {
    background:
        rgba(251, 113, 133, .08);

    color: #fda4af;

    border-color:
        rgba(251, 113, 133, .15);
}

.status-dot {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: currentColor;

    box-shadow:
        0 0 8px currentColor;
}


/* =========================================================
   TABLE BUTTONS
========================================================= */

.dashboard-card .btn-light {
    background:
        rgba(255, 255, 255, .035);

    color: #94a3b8;

    border-color:
        rgba(255, 255, 255, .09) !important;

    transition: var(--transition);
}

.dashboard-card .btn-light:hover {
    background:
        rgba(56, 189, 248, .10);

    color: #7dd3fc;

    border-color:
        rgba(56, 189, 248, .35) !important;

    box-shadow:
        0 0 18px rgba(56, 189, 248, .08);

    transform: translateY(-1px);
}


/* =========================================================
   ACTIVITY
========================================================= */

.activity-item {
    display: flex;

    gap: 12px;

    padding: 14px 18px;

    border-bottom:
        1px solid rgba(255, 255, 255, .055);

    transition:
        background var(--transition),
        padding-left var(--transition);
}

.activity-item:last-child {
    border-bottom: 0;
}

.activity-item:hover {
    background:
        rgba(56, 189, 248, .035);

    padding-left: 22px;
}

.activity-icon {
    width: 34px;
    height: 34px;

    border-radius: 9px;

    background:
        rgba(56, 189, 248, .07);

    color: #38bdf8;

    border:
        1px solid rgba(56, 189, 248, .10);

    display: flex;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    transition: var(--transition);
}

.activity-item:hover .activity-icon {
    background:
        rgba(56, 189, 248, .13);

    border-color:
        rgba(56, 189, 248, .30);

    box-shadow:
        0 0 18px rgba(56, 189, 248, .10);

    transform: scale(1.06);
}

.activity-title {
    font-size: 10px;

    font-weight: 650;

    color: #cbd5e1;
}

.activity-time {
    color: #64748b;

    font-size: 9px;

    margin-top: 3px;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-state {
    text-align: center;

    padding: 40px 20px;

    color: #64748b;
}

.empty-state i {
    font-size: 30px;

    color: #475569;

    margin-bottom: 10px;

    transition: var(--transition);
}

.dashboard-card:hover .empty-state i {
    color: #38bdf8;

    filter:
        drop-shadow(
            0 0 10px rgba(56, 189, 248, .30)
        );
}

.empty-state-title {
    font-size: 12px;

    font-weight: 700;

    color: #94a3b8;
}

.empty-state-text {
    font-size: 10px;

    margin-top: 4px;

    color: #64748b;
}


/* =========================================================
   BOOTSTRAP TEXT COLOR OVERRIDES
========================================================= */

.text-primary {
    color: #38bdf8 !important;
}

.text-success {
    color: #34d399 !important;
}

.text-danger {
    color: #fb7185 !important;
}


/* =========================================================
   ENTRY ANIMATIONS
========================================================= */

@keyframes dashboardReveal {
    from {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes cardReveal {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* =========================================================
   SECTION STAGGER
========================================================= */

.dashboard-section:nth-of-type(1) {
    animation-delay: .05s;
}

.dashboard-section:nth-of-type(2) {
    animation-delay: .10s;
}

.dashboard-section:nth-of-type(3) {
    animation-delay: .15s;
}

.dashboard-section:nth-of-type(4) {
    animation-delay: .20s;
}

.dashboard-section:nth-of-type(5) {
    animation-delay: .25s;
}


.adminlogo{
    height: 40px;
    width: 40px;
    border-radius: 50%;
}

/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}

::-webkit-scrollbar-track {
    background: #07111f;
}

::-webkit-scrollbar-thumb {
    background:
        linear-gradient(
            180deg,
            #2563eb,
            #7c3aed
        );

    border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
    background:
        linear-gradient(
            180deg,
            #38bdf8,
            #a855f7
        );
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1199px) {

    .admin-sidebar {
        width: 235px;
    }

    .top-search {
        width: 300px;
    }

    .dashboard-content {
        padding: 23px;
    }
}


@media (max-width: 991px) {

    .admin-sidebar {
        display: none;
    }

    .dashboard-content {
        padding: 18px;
    }

    .admin-topbar {
        padding: 12px 18px;
    }
}


@media (max-width: 767px) {

    .admin-topbar {
        flex-direction: column;
        align-items: stretch;
    }

    .top-search {
        width: 100%;
    }

    .admin-profile {
        justify-content: flex-end;
    }

    .dashboard-content {
        padding: 14px;
    }

    .welcome-card {
        padding: 21px;
        border-radius: 15px;
    }

    .welcome-title {
        font-size: 19px;
    }

    .welcome-text {
        font-size: 11px;
        line-height: 1.6;
    }

    .welcome-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .welcome-actions .btn {
        margin-right: 0 !important;
    }

    .section-header {
        align-items: flex-start;
        gap: 10px;
    }

    .dashboard-card {
        overflow-x: auto;
    }

    .dashboard-card .table {
        min-width: 650px;
    }

    .stat-value {
        font-size: 22px;
    }
}


@media (max-width: 480px) {

    .dashboard-content {
        padding: 10px;
    }

    .admin-profile {
        gap: 8px;
    }

    .profile-role {
        display: none;
    }

    .welcome-card {
        padding: 18px;
    }

    .welcome-title {
        font-size: 17px;
    }

    .welcome-actions .btn {
        width: 100%;
    }

    .stat-card {
        padding: 15px;
    }

    .stat-icon {
        width: 38px;
        height: 38px;
    }

    .stat-value {
        font-size: 20px;
    }

    .stat-label {
        font-size: 10px;
    }
}


/* =========================================================
   REDUCED MOTION ACCESSIBILITY
========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }
}

