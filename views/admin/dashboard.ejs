                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="row g-3">

                    <div class="col-12">

                        <div class="dashboard-card">

                            <div class="empty-state">

                                <i class="bi bi-diagram-3"></i>

                                <div class="empty-state-title">
                                    Department-wise overview
                                </div>

                                <div class="empty-state-text">

                                    Department, program, semester and section statistics will appear here after the academic structure module is connected.

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- STUDENTS + ACTIVITY -->

            <div class="dashboard-section">

                <div class="row g-4">


                    <!-- RECENT STUDENTS -->

                    <div class="col-xl-8">

                        <div class="dashboard-card">

                            <div class="dashboard-card-header">

                                <div>

                                    <div class="section-title">
                                        Recent Students
                                    </div>

                                    <div class="section-subtitle">
                                        Recently registered student accounts
                                    </div>

                                </div>

                                <a
                                    href="/admin/students"
                                    class="section-link"
                                >
                                    View all
                                </a>

                            </div>


                            <% if (recentStudents.length > 0) { %>

                                <div class="table-responsive">

                                    <table class="table">

                                        <thead>

                                            <tr>

                                                <th>
                                                    Student
                                                </th>

                                                <th>
                                                    Status
                                                </th>

                                                <th>
                                                    Registered
                                                </th>

                                                <th>
                                                    Action
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>

                                            <% recentStudents.forEach(student => { %>

                                                <tr>

                                                    <td>

                                                        <div class="user-cell">

                                                            <div class="user-avatar">
                                                                <%= getInitials(student.name) %>
                                                            </div>

                                                            <div>

                                                                <div class="user-name">
                                                                    <%= student.name %>
                                                                </div>

                                                                <div class="user-email">
                                                                    <%= student.email %>
                                                                </div>

                                                            </div>

                                                        </div>

                                                    </td>


                                                    <td>

                                                        <% if (student.isActive) { %>

                                                            <span class="status-badge status-active">

                                                                <span class="status-dot"></span>

                                                                Active

                                                            </span>

                                                        <% } else { %>

                                                            <span class="status-badge status-inactive">

                                                                <span class="status-dot"></span>

                                                                Inactive

                                                            </span>

                                                        <% } %>

                                                    </td>


                                                    <td>

                                                        <%= formatDate(student.createdAt) %>

                                                    </td>


                                                    <td>

                                                        <a
                                                            href="/admin/students"
                                                            class="btn btn-sm btn-light border"
                                                        >

                                                            <i class="bi bi-eye"></i>

                                                        </a>

                                                    </td>

                                                </tr>

                                            <% }) %>

                                        </tbody>

                                    </table>

                                </div>

                            <% } else { %>

                                <div class="empty-state">

                                    <i class="bi bi-people"></i>

                                    <div class="empty-state-title">
                                        No students found
                                    </div>

                                    <div class="empty-state-text">
                                        Student registrations will appear here.
                                    </div>

                                </div>

                            <% } %>

                        </div>

                    </div>


                    <!-- RECENT ACTIVITY -->

                    <div class="col-xl-4">

                        <div class="dashboard-card">

                            <div class="dashboard-card-header">

                                <div>

                                    <div class="section-title">
                                        Recent Activity
                                    </div>

                                    <div class="section-subtitle">
                                        Latest account activity
                                    </div>

                                </div>

                            </div>


                            <% if (recentUsers.length > 0) { %>

                                <% recentUsers.slice(0, 6).forEach(user => { %>

                                    <div class="activity-item">

                                        <div class="activity-icon">

                                            <% if (user.role === "student") { %>

                                                <i class="bi bi-person"></i>

                                            <% } else if (user.role === "faculty") { %>

                                                <i class="bi bi-person-workspace"></i>

                                            <% } else { %>

                                                <i class="bi bi-shield-check"></i>

                                            <% } %>

                                        </div>


                                        <div>

                                            <div class="activity-title">

                                                <%= user.name %>

                                                joined as

                                                <%= roleBadge(user.role) %>

                                            </div>

                                            <div class="activity-time">

                                                <%= formatDateTime(user.createdAt) %>

                                            </div>

                                        </div>

                                    </div>

                                <% }) %>

                            <% } else { %>

                                <div class="empty-state">

                                    <i class="bi bi-activity"></i>

                                    <div class="empty-state-title">
                                        No recent activity
                                    </div>

                                </div>

                            <% } %>

                        </div>

                    </div>

                </div>

            </div>


            <!-- FACULTY -->

            <div class="dashboard-section">

                <div class="dashboard-card">

                    <div class="dashboard-card-header">

                        <div>

                            <div class="section-title">
                                Recent Faculty
                            </div>

                            <div class="section-subtitle">
                                Recently registered faculty members
                            </div>

                        </div>

                        <a
                            href="/admin/faculty"
                            class="section-link"
                        >
                            View all
                        </a>

                    </div>


                    <% if (recentFaculty.length > 0) { %>

                        <div class="table-responsive">

                            <table class="table">

                                <thead>

                                    <tr>

                                        <th>
                                            Faculty
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                        <th>
                                            Joined
                                        </th>

                                        <th>
                                            Action
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% recentFaculty.forEach(faculty => { %>

                                        <tr>

                                            <td>

                                                <div class="user-cell">

                                                    <div class="user-avatar">
                                                        <%= getInitials(faculty.name) %>
                                                    </div>

                                                    <div>

                                                        <div class="user-name">
                                                            <%= faculty.name %>
                                                        </div>

                                                        <div class="user-email">
                                                            <%= faculty.email %>
                                                        </div>

                                                    </div>

                                                </div>

                                            </td>


                                            <td>

                                                <% if (faculty.isActive) { %>

                                                    <span class="status-badge status-active">

                                                        <span class="status-dot"></span>

                                                        Active

                                                    </span>

                                                <% } else { %>

                                                    <span class="status-badge status-inactive">

                                                        <span class="status-dot"></span>

                                                        Inactive

                                                    </span>

                                                <% } %>

                                            </td>


                                            <td>

                                                <%= formatDate(faculty.createdAt) %>

                                            </td>


                                            <td>

                                                <a
                                                    href="/admin/faculty"
                                                    class="btn btn-sm btn-light border"
                                                >

                                                    <i class="bi bi-eye"></i>

                                                </a>

                                            </td>

                                        </tr>

                                    <% }) %>

                                </tbody>

                            </table>

                        </div>

                    <% } else { %>

                        <div class="empty-state">

                            <i class="bi bi-person-workspace"></i>

                            <div class="empty-state-title">
                                No faculty found
                            </div>

                            <div class="empty-state-text">
                                Faculty registrations will appear here.
                            </div>

                        </div>

                    <% } %>

                </div>

            </div>


            <!-- SYSTEM ACCESS -->

            <div class="dashboard-section">

                <div class="section-header">

                    <div>

                        <h2 class="section-title">
                            System Access
                        </h2>

                        <div class="section-subtitle">
                            Role-based university access management
                        </div>

                    </div>

                    <a
                        href="/admin/access-control"
                        class="section-link"
                    >

                        Manage access

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>
                <div class="col-md-4">

    <a
        href="/admin/workers"
        class="branch-card d-block text-decoration-none"
    >

        <div class="branch-icon">

            <i class="bi bi-tools"></i>

        </div>

        <div class="branch-name">
            Workers
        </div>

        <div class="branch-status">
            University service and maintenance access
        </div>

        <div class="branch-stat-row">

            <div>

                <div class="branch-stat-value">
                    <%= activeWorkers %>
                </div>

                <div class="branch-stat-label">
                    Active
                </div>

            </div>

            <div>

                <div class="branch-stat-value">
                    Task Based
                </div>

                <div class="branch-stat-label">
                    Access
                </div>

            </div>

        </div>

    </a>

</div>


                <div class="row g-3">


                    <div class="col-md-4">

                        <div class="branch-card">

                            <div class="branch-icon">

                                <i class="bi bi-shield-lock"></i>

                            </div>

                            <div class="branch-name">
                                Administrator
                            </div>

                            <div class="branch-status">
                                Full university access
                            </div>

                            <div class="branch-stat-row">

                                <div>

                                    <div class="branch-stat-value">
                                        Full
                                    </div>

                                    <div class="branch-stat-label">
                                        Access
                                    </div>

                                </div>

                                <div>

                                    <div class="branch-stat-value">
                                        All
                                    </div>

                                    <div class="branch-stat-label">
                                        Modules
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="branch-card">

                            <div class="branch-icon">

                                <i class="bi bi-person-workspace"></i>

                            </div>

                            <div class="branch-name">
                                Faculty
                            </div>

                            <div class="branch-status">
                                Department and course based
                            </div>

                            <div class="branch-stat-row">

                                <div>

                                    <div class="branch-stat-value">
                                        <%= activeFaculty %>
                                    </div>

                                    <div class="branch-stat-label">
                                        Active
                                    </div>

                                </div>

                                <div>

                                    <div class="branch-stat-value">
                                        Limited
                                    </div>

                                    <div class="branch-stat-label">
                                        Access
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="branch-card">

                            <div class="branch-icon">

                                <i class="bi bi-person"></i>

                            </div>

                            <div class="branch-name">
                                Students
                            </div>

                            <div class="branch-status">
                                Personal academic access
                            </div>

                            <div class="branch-stat-row">

                                <div>

                                    <div class="branch-stat-value">
                                        <%= activeStudents %>
                                    </div>

                                    <div class="branch-stat-label">
                                        Active
                                    </div>

                                </div>

                                <div>

                                    <div class="branch-stat-value">
                                        Personal
                                    </div>

                                    <div class="branch-stat-label">
                                        Access
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                </div>

            </div>


        </div>

    </main>

</div>