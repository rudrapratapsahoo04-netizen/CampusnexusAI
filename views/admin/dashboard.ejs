<style>

/* =========================================================
   CAMPUSNEXUS — FUTURISTIC ADMIN DASHBOARD
   LOGIC UNTOUCHED — DESIGN ONLY
========================================================= */

:root {
    --admin-bg: #07111f;
    --admin-bg-soft: #0a1628;

    --glass: rgba(255, 255, 255, 0.045);
    --glass-strong: rgba(255, 255, 255, 0.075);
    --glass-hover: rgba(255, 255, 255, 0.105);

    --border: rgba(255, 255, 255, 0.09);
    --border-hover: rgba(56, 189, 248, 0.65);

    --text: #f8fafc;
    --muted: #94a3b8;
    --muted-light: #cbd5e1;

    --blue: #38bdf8;
    --blue-strong: #2563eb;

    --violet: #8b5cf6;
    --purple: #a855f7;

    --cyan: #22d3ee;
    --green: #34d399;
    --orange: #fbbf24;
    --red: #fb7185;

    --shadow:
        0 20px 60px rgba(0, 0, 0, .22);

    --glow-blue:
        0 0 0 1px rgba(56, 189, 248, .25),
        0 0 30px rgba(56, 189, 248, .13);

    --transition: .28s cubic-bezier(.2, .8, .2, 1);
}


/* =========================================================
   PAGE BACKGROUND
========================================================= */

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    color: var(--text);
    background:
        radial-gradient(
            circle at 8% 12%,
            rgba(37, 99, 235, .18),
            transparent 25%
        ),
        radial-gradient(
            circle at 88% 18%,
            rgba(139, 92, 246, .16),
            transparent 25%
        ),
        radial-gradient(
            circle at 55% 90%,
            rgba(34, 211, 238, .08),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            #050b14 0%,
            #07111f 45%,
            #0a1322 100%
        );

    min-height: 100vh;
}


/* =========================================================
   AMBIENT LIGHT
========================================================= */

.admin-wrapper {
    min-height: calc(100vh - 70px);
    position: relative;
    overflow: hidden;
}

.admin-wrapper::before,
.admin-wrapper::after {
    content: "";
    position: fixed;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(90px);
    opacity: .12;
    z-index: -1;
}

.admin-wrapper::before {
    background: #2563eb;
    left: -180px;
    top: 15%;
    animation: ambientMove 12s ease-in-out infinite alternate;
}

.admin-wrapper::after {
    background: #8b5cf6;
    right: -180px;
    bottom: 5%;
    animation: ambientMoveReverse 15s ease-in-out infinite alternate;
}

@keyframes ambientMove {
    from {
        transform: translate(0, 0) scale(1);
    }

    to {
        transform: translate(80px, 40px) scale(1.15);
    }
}

@keyframes ambientMoveReverse {
    from {
        transform: translate(0, 0) scale(1);
    }

    to {
        transform: translate(-70px, -40px) scale(1.18);
    }
}


/* =========================================================
   SIDEBAR
========================================================= */

.admin-sidebar {
    width: 270px;
    min-height: calc(100vh - 70px);

    background:
        linear-gradient(
            180deg,
            rgba(7, 17, 31, .88),
            rgba(5, 12, 23, .82)
        );

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    color: #fff;

    position: sticky;
    top: 0;

    z-index: 100;

    overflow-y: auto;

    border-right: 1px solid rgba(255, 255, 255, .08);

    box-shadow:
        20px 0 60px rgba(0, 0, 0, .12);
}

.admin-sidebar::-webkit-scrollbar {
