    const dashboardStats = stats || {};

    const totalUsers = dashboardStats.totalUsers || 0;
    const totalStudents = dashboardStats.totalStudents || 0;
    const totalFaculty = dashboardStats.totalFaculty || 0;
    const activeStudents = dashboardStats.activeStudents || 0;
    const activeFaculty = dashboardStats.activeFaculty || 0;
    const inactiveUsers = dashboardStats.inactiveUsers || 0;
    const totalWorkers = dashboardStats.totalWorkers || 0;
    const activeWorkers = dashboardStats.activeWorkers || 0;


    const recentStudents = dashboardStats.recentStudents || [];
    const recentFaculty = dashboardStats.recentFaculty || [];
    const recentUsers = dashboardStats.recentUsers || [];

    const roleDistribution = dashboardStats.roleDistribution || {
        students: totalStudents,
        faculty: totalFaculty,
        workers: totalWorkers
    };

    const formatDate = (date) => {
        if (!date) return "—";

        return new Date(date).toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        });
    };

    const formatDateTime = (date) => {
        if (!date) return "Never";

        return new Date(date).toLocaleString("en-IN", {
            day: "2-digit",
            month: "short",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit"
        });
    };

    const getInitials = (name) => {
        if (!name) return "U";

        return name
            .split(" ")
            .map(word => word.charAt(0))
            .join("")
            .substring(0, 2)
            .toUpperCase();
    };

    const roleBadge = (role) => {
        if (role === "admin") return "Administrator";
        if (role === "faculty") return "Faculty";
        return "Student";
    };
