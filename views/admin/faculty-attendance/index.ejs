</style>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const workingInput =
            document.getElementById(
                "workingDays"
            );

        const presentInput =
            document.getElementById(
                "presentDays"
            );

        const leaveInput =
            document.getElementById(
                "leaveDays"
            );

        const absentInput =
            document.getElementById(
                "absentDays"
            );

        const percentageText =
            document.getElementById(
                "attendancePercentage"
            );

        const progressBar =
            document.getElementById(
                "attendanceProgress"
            );

        const summaryWorking =
            document.getElementById(
                "summaryWorking"
            );

        const summaryPresent =
            document.getElementById(
                "summaryPresent"
            );

        const summaryLeave =
            document.getElementById(
                "summaryLeave"
            );

        const summaryAbsent =
            document.getElementById(
                "summaryAbsent"
            );


        /*
         * If attendance form is not loaded,
         * stop here.
         */

        if (
            !workingInput ||
            !presentInput ||
            !leaveInput
        ) {
            return;
        }


        function updateAttendance() {

            const working =
                Math.max(
                    Number(
                        workingInput.value
                    ) || 0,
                    0
                );

            const present =
                Math.max(
                    Number(
                        presentInput.value
                    ) || 0,
                    0
                );

            const leave =
                Math.max(
                    Number(
                        leaveInput.value
                    ) || 0,
                    0
                );


            /*
             * Calculate absent days.
             */

            const absent =
                Math.max(
                    working -
                    present -
                    leave,
                    0
                );


            absentInput.value =
                absent;


            /*
             * Effective working days
             */

            const effectiveWorkingDays =
                Math.max(
                    working -
                    leave,
                    0
                );


            let percentage = 0;


            if (
                effectiveWorkingDays > 0
            ) {

                percentage =
                    (
                        present /
                        effectiveWorkingDays
                    ) *
                    100;

            }


            /*
             * Never allow percentage
             * above 100.
             */

            percentage =
                Math.min(
                    Math.max(
                        percentage,
                        0
                    ),
                    100
                );


            /*
             * Update UI
             */

            percentageText.textContent =
                percentage.toFixed(2) + "%";

            progressBar.style.width =
                percentage.toFixed(2) + "%";


            summaryWorking.textContent =
                working;

            summaryPresent.textContent =
                present;

            summaryLeave.textContent =
                leave;

            summaryAbsent.textContent =
                absent;


            /*
             * Validation hint.
             */

            if (
                present + leave >
                working
            ) {

                presentInput.classList.add(
                    "is-invalid"
                );

                leaveInput.classList.add(
                    "is-invalid"
                );

            } else {

                presentInput.classList.remove(
                    "is-invalid"
                );

                leaveInput.classList.remove(
                    "is-invalid"
                );

            }

        }


        workingInput.addEventListener(
            "input",
            updateAttendance
        );

        presentInput.addEventListener(
            "input",
            updateAttendance
        );

        leaveInput.addEventListener(
            "input",
            updateAttendance
        );


        /*
         * Initial calculation.
         */

        updateAttendance();


        /*
         * Prevent invalid submission.
         */

        const form =
            document.getElementById(
                "attendanceForm"
            );

        if (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    const working =
                        Number(
                            workingInput.value
                        ) || 0;

                    const present =
                        Number(
                            presentInput.value
                        ) || 0;

                    const leave =
                        Number(
                            leaveInput.value
                        ) || 0;


                    if (
                        present + leave >
                        working
                    ) {

                        event.preventDefault();

                        alert(
                            "Present days and approved leave cannot exceed working days."
                        );

                        return;

                    }


                    const saveButton =
                        document.getElementById(
                            "saveAttendanceBtn"
                        );

                    if (saveButton) {

                        saveButton.disabled =
                            true;

                        saveButton.innerHTML =
                            '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

                    }

                }
            );

        }

    }
);

</script>