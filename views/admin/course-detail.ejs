<% layout("layouts/boilerplate") -%>

<%
    const courseTypeLabels = {
        core: "Core",
        elective: "Elective",
        practical: "Practical",
        tutorial: "Tutorial",
        project: "Project",
        internship: "Internship",
        seminar: "Seminar"
    };

    const courseTypeIcons = {
        core: "bi-book",
        elective: "bi-ui-checks",
        practical: "bi-pc-display",
        tutorial: "bi-person-video3",
        project: "bi-kanban",
        internship: "bi-briefcase",
        seminar: "bi-mic"
    };

    const courseTypeLabel =
        courseTypeLabels[course.courseType] ||
        course.courseType;

    const courseTypeIcon =
        courseTypeIcons[course.courseType] ||
        "bi-book";

    const totalHours =
        Number(course.theoryHours || 0) +
        Number(course.practicalHours || 0);
%>

<div class="container-fluid py-4">

    <!-- ==========================================
         PAGE HEADER
    =========================================== -->

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">

                <a
                    href="/admin/courses"
                    class="btn btn-sm btn-outline-secondary"
                >
                    <i class="bi bi-arrow-left"></i>
                    Back to Courses
                </a>

            </div>

            <h2 class="fw-bold mb-1">
                <%= course.courseCode %>
            </h2>

            <p class="text-muted mb-0">
                Course Details & Academic Information
            </p>
        </div>

        <div class="d-flex gap-2">

            <a
                href="/admin/courses/<%= course._id %>/edit"
                class="btn btn-primary"
            >
                <i class="bi bi-pencil-square me-1"></i>
                Edit Course
            </a>

            <form
                method="POST"
                action="/admin/courses/<%= course._id %>/toggle-status"
                class="d-inline"
            >
                <button
                    type="submit"
                    class="btn <%= course.status === 'active' ? 'btn-outline-danger' : 'btn-outline-success' %>"
                >
                    <% if (course.status === "active") { %>
                        <i class="bi bi-pause-circle me-1"></i>
                        Deactivate
                    <% } else { %>
                        <i class="bi bi-play-circle me-1"></i>
                        Activate
                    <% } %>
                </button>
            </form>

        </div>

    </div>


    <!-- ==========================================
         TOP SUMMARY CARDS
    =========================================== -->

    <div class="row g-4 mb-4">

        <!-- Course Code -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Course Code
                            </p>

                            <h4 class="fw-bold mb-0">
                                <%= course.courseCode %>
                            </h4>
                        </div>

                        <div class="bg-primary-subtle text-primary rounded-3 p-2">
                            <i class="bi bi-hash fs-5"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Credits -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Credits
                            </p>

                            <h4 class="fw-bold mb-0">
                                <%= course.credits %>
                            </h4>
                        </div>

                        <div class="bg-success-subtle text-success rounded-3 p-2">
                            <i class="bi bi-award fs-5"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Semester -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Semester
                            </p>

                            <h4 class="fw-bold mb-0">
                                Semester <%= course.semester %>
                            </h4>
                        </div>

                        <div class="bg-warning-subtle text-warning rounded-3 p-2">
                            <i class="bi bi-calendar3 fs-5"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Status -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <p class="text-muted small mb-1">
                                Status
                            </p>

                            <h4 class="mb-0">

                                <% if (course.status === "active") { %>

                                    <span class="badge text-bg-success">
                                        Active
                                    </span>

                                <% } else { %>

                                    <span class="badge text-bg-secondary">
                                        Inactive
                                    </span>

                                <% } %>

                            </h4>

                        </div>

                        <div class="<%= course.status === 'active' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %> rounded-3 p-2">

                            <% if (course.status === "active") { %>

                                <i class="bi bi-check-circle fs-5"></i>

                            <% } else { %>

                                <i class="bi bi-pause-circle fs-5"></i>

                            <% } %>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- ==========================================
             LEFT COLUMN
        =========================================== -->

        <div class="col-12 col-xl-8">


            <!-- COURSE INFORMATION -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center gap-2">

                        <div class="bg-primary-subtle text-primary rounded-3 p-2">

                            <i class="bi bi-book fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Course Information
                            </h5>

                            <small class="text-muted">
                                Basic course details
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Course Code
                            </label>

                            <div class="fw-semibold mt-1">
                                <%= course.courseCode %>
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="text-muted small">
                                Short Name
                            </label>

                            <div class="fw-semibold mt-1">

                                <%= course.shortName || "—" %>

                            </div>

                        </div>


                        <div class="col-12">

                            <label class="text-muted small">
                                Course Name
                            </label>

                            <div class="fw-semibold fs-5 mt-1">

                                <%= course.courseName %>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="text-muted small">
                                Course Type
                            </label>

                            <div class="mt-2">

                                <span class="badge bg-light text-dark border">

                                    <i class="bi <%= courseTypeIcon %> me-1"></i>

                                    <%= courseTypeLabel %>

                                </span>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="text-muted small">
                                Course Status
                            </label>

                            <div class="mt-2">

                                <% if (course.status === "active") { %>

                                    <span class="badge text-bg-success">
                                        Active
                                    </span>

                                <% } else { %>

                                    <span class="badge text-bg-secondary">
                                        Inactive
                                    </span>

                                <% } %>

                            </div>

                        </div>


                        <% if (course.description) { %>

                            <div class="col-12">

                                <label class="text-muted small">
                                    Description
                                </label>

                                <div class="mt-2 text-secondary">

                                    <%= course.description %>

                                </div>

                            </div>

                        <% } %>

                    </div>

                </div>

            </div>


            <!-- ACADEMIC MAPPING -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center gap-2">

                        <div class="bg-success-subtle text-success rounded-3 p-2">

                            <i class="bi bi-diagram-3 fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Academic Mapping
                            </h5>

                            <small class="text-muted">
                                Where this course belongs
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <label class="text-muted small">
                                Department
                            </label>

                            <div class="mt-1">

                                <% if (course.department) { %>

                                    <div class="fw-semibold">
                                        <%= course.department.name %>
                                    </div>

                                    <small class="text-muted">
                                        <%= course.department.code %>
                                    </small>

                                <% } else { %>

                                    <span class="text-muted">
                                        Not available
                                    </span>

                                <% } %>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="text-muted small">
                                Program
                            </label>

                            <div class="mt-1">

                                <% if (course.program) { %>

                                    <div class="fw-semibold">
                                        <%= course.program.name %>
                                    </div>

                                    <small class="text-muted">
                                        <%= course.program.code %>
                                    </small>

                                <% } else { %>

                                    <span class="text-muted">
                                        Not available
                                    </span>

                                <% } %>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <label class="text-muted small">
                                Semester
                            </label>

                            <div class="fw-semibold mt-1">

                                Semester <%= course.semester %>

                            </div>

                        </div>


                        <% if (course.program) { %>

                            <div class="col-md-6">

                                <label class="text-muted small">
                                    Program Duration
                                </label>

                                <div class="fw-semibold mt-1">

                                    <%= course.program.durationYears %>
                                    <%= course.program.durationYears === 1 ? "Year" : "Years" %>

                                </div>

                            </div>

                        <% } %>

                    </div>

                </div>

            </div>


            <!-- WORKLOAD -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center gap-2">

                        <div class="bg-warning-subtle text-warning rounded-3 p-2">

                            <i class="bi bi-clock-history fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-0">
                                Course Workload
                            </h5>

                            <small class="text-muted">
                                Weekly academic workload
                            </small>

                        </div>

                    </div>

                </div>


                <div class="card-body px-4 pb-4">

                    <div class="row g-3">

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    Credits
                                </div>

                                <div class="fs-4 fw-bold">
                                    <%= course.credits %>
                                </div>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    Theory Hours
                                </div>

                                <div class="fs-4 fw-bold">
                                    <%= course.theoryHours || 0 %>
                                </div>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    Practical Hours
                                </div>

                                <div class="fs-4 fw-bold">
                                    <%= course.practicalHours || 0 %>
                                </div>

                            </div>

                        </div>


                        <div class="col-12">

                            <div class="bg-light rounded-3 p-3">

                                <div class="d-flex justify-content-between align-items-center">

                                    <div>

                                        <div class="text-muted small">
                                            Total Contact Hours
                                        </div>

                                        <div class="fw-bold fs-5">
                                            <%= totalHours %> hours
                                        </div>

                                    </div>

                                    <i class="bi bi-hourglass-split fs-3 text-primary"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==========================================
             RIGHT COLUMN
        =========================================== -->

        <div class="col-12 col-xl-4">


            <!-- COURSE SNAPSHOT -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-0">
                        Course Snapshot
                    </h5>

                </div>


                <div class="card-body px-4">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="rounded-3 bg-primary text-white p-3">

                            <i class="bi <%= courseTypeIcon %> fs-4"></i>

                        </div>

                        <div>

                            <div class="fw-bold">
                                <%= course.courseName %>
                            </div>

                            <small class="text-muted">
                                <%= course.courseCode %>
                            </small>

                        </div>

                    </div>


                    <div class="border-top pt-3">

                        <div class="d-flex justify-content-between py-2">

                            <span class="text-muted">
                                Type
                            </span>

                            <span class="fw-semibold">
                                <%= courseTypeLabel %>
                            </span>

                        </div>


                        <div class="d-flex justify-content-between py-2">

                            <span class="text-muted">
                                Credits
                            </span>

                            <span class="fw-semibold">
                                <%= course.credits %>
                            </span>

                        </div>


                        <div class="d-flex justify-content-between py-2">

                            <span class="text-muted">
                                Semester
                            </span>

                            <span class="fw-semibold">
                                <%= course.semester %>
                            </span>

                        </div>


                        <div class="d-flex justify-content-between py-2">

                            <span class="text-muted">
                                Status
                            </span>

                            <span>

                                <% if (course.status === "active") { %>

                                    <span class="badge text-bg-success">
                                        Active
                                    </span>

                                <% } else { %>

                                    <span class="badge text-bg-secondary">
                                        Inactive
                                    </span>

                                <% } %>

                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- MANAGEMENT -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-0">
                        Course Management
                    </h5>

                </div>


                <div class="card-body px-4">

                    <div class="d-grid gap-2">

                        <a
                            href="/admin/courses/<%= course._id %>/edit"
                            class="btn btn-primary"
                        >
                            <i class="bi bi-pencil-square me-2"></i>
                            Edit Course
                        </a>


                        <a
                            href="/admin/courses"
                            class="btn btn-outline-secondary"
                        >
                            <i class="bi bi-list-ul me-2"></i>
                            All Courses
                        </a>

                    </div>

                </div>

            </div>


            <!-- FUTURE ACADEMIC MANAGEMENT -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-0">
                        Academic Management
                    </h5>

                </div>


                <div class="card-body px-4">

                    <div class="list-group list-group-flush">

                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">

                            <div>

                                <i class="bi bi-person-badge me-2 text-primary"></i>

                                Faculty Assignment

                            </div>

                            <span class="badge text-bg-light">
                                Coming
                            </span>

                        </div>


                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">

                            <div>

                                <i class="bi bi-calendar-week me-2 text-success"></i>

                                Timetable

                            </div>

                            <span class="badge text-bg-light">
                                Coming
                            </span>

                        </div>


                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">

                            <div>

                                <i class="bi bi-people me-2 text-warning"></i>

                                Sections

                            </div>

                            <span class="badge text-bg-light">
                                Coming
                            </span>

                        </div>


                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">

                            <div>

                                <i class="bi bi-bar-chart me-2 text-info"></i>

                                Course Analytics

                            </div>

                            <span class="badge text-bg-light">
                                Coming
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ==========================================
         RECORD INFORMATION
    =========================================== -->

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <div class="text-muted small">
                        Course ID
                    </div>

                    <div class="fw-semibold text-break">
                        <%= course._id %>
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        Created
                    </div>

                    <div class="fw-semibold">

                        <%= course.createdAt
                            ? new Date(course.createdAt).toLocaleDateString("en-IN", {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                            })
                            : "—"
                        %>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        Last Updated
                    </div>

                    <div class="fw-semibold">

                        <%= course.updatedAt
                            ? new Date(course.updatedAt).toLocaleDateString("en-IN", {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                            })
                            : "—"
                        %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>