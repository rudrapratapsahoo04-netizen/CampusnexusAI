<% layout("layouts/boilerplate") -%>
<div class="container py-4">

    <!-- ======================================== -->
    <!-- PAGE HEADER -->
    <!-- ======================================== -->

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            Certificate Management
        </h2>

        <p class="text-muted mb-0">
            Review and manage certificate applications submitted by students.
        </p>
    </div>


    <!-- ======================================== -->
    <!-- CERTIFICATE REQUESTS -->
    <!-- ======================================== -->

    <% if (
        !certificateRequests ||
        certificateRequests.length === 0
    ) { %>

        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <div class="mb-3">
                    <i class="bi bi-file-earmark-text fs-1 text-muted"></i>
                </div>

                <h5 class="fw-semibold">
                    No Certificate Applications
                </h5>

                <p class="text-muted mb-0">
                    No certificate applications have been submitted yet.
                </p>

            </div>
        </div>

    <% } else { %>


        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h5 class="mb-1 fw-bold">
                            Certificate Applications
                        </h5>

                        <small class="text-muted">
                            Total Applications:
                            <%= certificateRequests.length %>
                        </small>
                    </div>

                </div>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Certificate
                                </th>

                                <th>
                                    Academic
                                </th>

                                <th>
                                    Application
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% certificateRequests.forEach(
                                function(request)
                            { %>

                                <tr>

                                    <!-- STUDENT -->

                                    <td>

                                        <div class="fw-semibold">
                                            <%= request.student
                                                ? request.student.name
                                                : "Unknown Student" %>
                                        </div>

                                        <small class="text-muted">

                                            ID:
                                            <%= request.studentId || "-" %>

                                        </small>

                                    </td>


                                    <!-- CERTIFICATE -->

                                    <td>

                                        <div class="fw-semibold">

                                            <%= request.certificateType
                                                .replaceAll("_", " ")
                                                .replace(/\b\w/g, function(letter) {
                                                    return letter.toUpperCase();
                                                }) %>

                                        </div>

                                        <small class="text-muted">

                                            <%= request.purpose %>

                                        </small>

                                    </td>


                                    <!-- ACADEMIC -->

                                    <td>

                                        <div>
                                            <%= request.department || "-" %>
                                        </div>

                                        <small class="text-muted">

                                            <%= request.program || "-" %>
                                            |
                                            Sem <%= request.semester || "-" %>
                                            |
                                            Sec <%= request.section || "-" %>

                                        </small>

                                    </td>


                                    <!-- APPLICATION -->

                                    <td>

                                        <div class="fw-semibold">

                                            <%= request.applicationNumber || "-" %>

                                        </div>

                                        <small class="text-muted">

                                            <%= request.createdAt
                                                ? new Date(
                                                    request.createdAt
                                                ).toLocaleDateString("en-IN")
                                                : "-" %>

                                        </small>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if (
                                            request.status === "ready"
                                        ) { %>

                                            <span class="badge bg-success">
                                                Ready
                                            </span>

                                        <% } else if (
                                            request.status === "approved"
                                        ) { %>

                                            <span class="badge bg-success">
                                                Approved
                                            </span>

                                        <% } else if (
                                            request.status === "rejected"
                                        ) { %>

                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>

                                        <% } else if (
                                            request.status === "under_review"
                                        ) { %>

                                            <span class="badge bg-warning text-dark">
                                                Under Review
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-secondary">
                                                Pending
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACTION -->

                                    <td>

                                        <% if (
                                            request.status !== "ready"
                                        ) { %>

                                            <button
                                                type="button"
                                                class="btn btn-sm btn-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reviewModal<%= request._id %>"
                                            >
                                                Review
                                            </button>

                                        <% } else { %>

                                            <span class="text-success small fw-semibold">
                                                Certificate Generated
                                            </span>

                                        <% } %>

                                    </td>

                                </tr>


                                <!-- ======================================== -->
                                <!-- REVIEW MODAL -->
                                <!-- ======================================== -->

                                <div
                                    class="modal fade"
                                    id="reviewModal<%= request._id %>"
                                    tabindex="-1"
                                    aria-hidden="true"
                                >

                                    <div class="modal-dialog modal-lg modal-dialog-centered">

                                        <div class="modal-content">

                                            <div class="modal-header">

                                                <h5 class="modal-title fw-bold">
                                                    Review Certificate Request
                                                </h5>

                                                <button
                                                    type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal"
                                                    aria-label="Close"
                                                ></button>

                                            </div>


                                            <form
                                                method="POST"
                                                action="/admin/certificates/<%= request._id %>/review"
                                            >

                                                <div class="modal-body">


                                                    <!-- STUDENT DETAILS -->

                                                    <div class="mb-4">

                                                        <h6 class="fw-bold">
                                                            Student Information
                                                        </h6>

                                                        <div class="bg-light rounded p-3">

                                                            <div class="row g-3">

                                                                <div class="col-md-6">

                                                                    <small class="text-muted">
                                                                        Student Name
                                                                    </small>

                                                                    <div class="fw-semibold">
                                                                        <%= request.student
                                                                            ? request.student.name
                                                                            : "Unknown" %>
                                                                    </div>

                                                                </div>


                                                                <div class="col-md-6">

                                                                    <small class="text-muted">
                                                                        Student ID
                                                                    </small>

                                                                    <div class="fw-semibold">
                                                                        <%= request.studentId || "-" %>
                                                                    </div>

                                                                </div>


                                                                <div class="col-md-6">

                                                                    <small class="text-muted">
                                                                        Department
                                                                    </small>

                                                                    <div>
                                                                        <%= request.department || "-" %>
                                                                    </div>

                                                                </div>


                                                                <div class="col-md-6">

                                                                    <small class="text-muted">
                                                                        Program
                                                                    </small>

                                                                    <div>
                                                                        <%= request.program || "-" %>
                                                                    </div>

                                                                </div>


                                                                <div class="col-md-6">

                                                                    <small class="text-muted">
                                                                        Semester
                                                                    </small>

                                                                    <div>
                                                                        <%= request.semester || "-" %>
                                                                    </div>

                                                                </div>


                                                                <div class="col-md-6">

                                                                    <small class="text-muted">
                                                                        Section
                                                                    </small>

                                                                    <div>
                                                                        <%= request.section || "-" %>
                                                                    </div>

                                                                </div>

                                                            </div>

                                                        </div>

                                                    </div>


                                                    <!-- CERTIFICATE DETAILS -->

                                                    <div class="mb-4">

                                                        <h6 class="fw-bold">
                                                            Certificate Details
                                                        </h6>

                                                        <div class="bg-light rounded p-3">

                                                            <div class="mb-3">

                                                                <small class="text-muted">
                                                                    Certificate Type
                                                                </small>

                                                                <div class="fw-semibold">

                                                                    <%= request.certificateType
                                                                        .replaceAll("_", " ")
                                                                        .replace(/\b\w/g, function(letter) {
                                                                            return letter.toUpperCase();
                                                                        }) %>

                                                                </div>

                                                            </div>


                                                            <div class="mb-3">

                                                                <small class="text-muted">
                                                                    Purpose
                                                                </small>

                                                                <div>
                                                                    <%= request.purpose %>
                                                                </div>

                                                            </div>


                                                            <% if (
                                                                request.additionalDetails
                                                            ) { %>

                                                                <div>

                                                                    <small class="text-muted">
                                                                        Additional Details
                                                                    </small>

                                                                    <div>
                                                                        <%= request.additionalDetails %>
                                                                    </div>

                                                                </div>

                                                            <% } %>

                                                        </div>

                                                    </div>


                                                    <!-- STATUS -->

                                                    <div class="mb-3">

                                                        <label
                                                            class="form-label fw-semibold"
                                                            for="status<%= request._id %>"
                                                        >
                                                            Update Status
                                                        </label>

                                                        <select
                                                            class="form-select"
                                                            id="status<%= request._id %>"
                                                            name="status"
                                                            required
                                                        >

                                                            <option
                                                                value="under_review"
                                                                <%= request.status === "under_review"
                                                                    ? "selected"
                                                                    : "" %>
                                                            >
                                                                Under Review
                                                            </option>

                                                            <option
                                                                value="approved"
                                                                <%= request.status === "approved"
                                                                    ? "selected"
                                                                    : "" %>
                                                            >
                                                                Approved
                                                            </option>

                                                            <option
                                                                value="rejected"
                                                                <%= request.status === "rejected"
                                                                    ? "selected"
                                                                    : "" %>
                                                            >
                                                                Rejected
                                                            </option>

                                                        </select>

                                                    </div>


                                                    <!-- ADMIN REMARKS -->

                                                    <div class="mb-3">

                                                        <label
                                                            class="form-label fw-semibold"
                                                            for="remarks<%= request._id %>"
                                                        >
                                                            Admin Remarks
                                                        </label>

                                                        <textarea
                                                            class="form-control"
                                                            id="remarks<%= request._id %>"
                                                            name="adminRemarks"
                                                            rows="4"
                                                            maxlength="1000"
                                                            placeholder="Enter internal remarks..."
                                                        ><%= request.adminRemarks || "" %></textarea>

                                                        <small class="text-muted">
                                                            These remarks are for administrative use.
                                                        </small>

                                                    </div>

                                                </div>


                                                <div class="modal-footer">

                                                    <button
                                                        type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal"
                                                    >
                                                        Cancel
                                                    </button>

                                                    <button
                                                        type="submit"
                                                        class="btn btn-primary"
                                                    >
                                                        Update Request
                                                    </button>

                                                </div>

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    <% } %>

</div>

