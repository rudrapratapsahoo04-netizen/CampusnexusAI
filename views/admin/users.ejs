<% layout("layouts/boilerplate") -%>

<div class="container-fluid py-4">

    <!-- ========================================== -->
    <!-- PAGE HEADER -->
    <!-- ========================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>
                User Management
            </h2>

            <p class="text-muted mb-0">
                Manage university user accounts, status and access.
            </p>
        </div>

        <div>
            <a
                href="/admin/dashboard"
                class="btn btn-outline-secondary"
            >
                <i class="bi bi-arrow-left me-1"></i>
                Dashboard
            </a>
        </div>

    </div>


    <!-- ========================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ========================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Users -->

        <div class="col-12 col-sm-6 col-xl-2">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Total Users
                            </p>

                            <h3 class="fw-bold mb-0">
                                <%= summary.totalUsers %>
                            </h3>
                        </div>

                        <div class="text-primary fs-3">
                            <i class="bi bi-people"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Students -->

        <div class="col-12 col-sm-6 col-xl-2">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Students
                            </p>

                            <h3 class="fw-bold mb-0">
                                <%= summary.totalStudents %>
                            </h3>
                        </div>

                        <div class="text-success fs-3">
                            <i class="bi bi-mortarboard"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Faculty -->

        <div class="col-12 col-sm-6 col-xl-2">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Faculty
                            </p>

                            <h3 class="fw-bold mb-0">
                                <%= summary.totalFaculty %>
                            </h3>
                        </div>

                        <div class="text-info fs-3">
                            <i class="bi bi-person-workspace"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Admins -->

        <div class="col-12 col-sm-6 col-xl-2">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Admins
                            </p>

                            <h3 class="fw-bold mb-0">
                                <%= summary.totalAdmins %>
                            </h3>
                        </div>

                        <div class="text-danger fs-3">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Active -->

        <div class="col-12 col-sm-6 col-xl-2">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Active
                            </p>

                            <h3 class="fw-bold mb-0 text-success">
                                <%= summary.activeUsers %>
                            </h3>
                        </div>

                        <div class="text-success fs-3">
                            <i class="bi bi-check-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Inactive -->

        <div class="col-12 col-sm-6 col-xl-2">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted small mb-1">
                                Inactive
                            </p>

                            <h3 class="fw-bold mb-0 text-secondary">
                                <%= summary.inactiveUsers %>
                            </h3>
                        </div>

                        <div class="text-secondary fs-3">
                            <i class="bi bi-person-x"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- FILTERS -->
    <!-- ========================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-bottom">

            <div class="d-flex align-items-center">

                <i class="bi bi-funnel me-2"></i>

                <h5 class="mb-0 fw-semibold">
                    Search & Filters
                </h5>

            </div>

        </div>


        <div class="card-body">

            <form
                method="GET"
                action="/admin/users"
            >

                <div class="row g-3">

                    <!-- Search -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label
                            for="search"
                            class="form-label fw-semibold"
                        >
                            Search
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="search"
                            name="search"
                            value="<%= filters.search || '' %>"
                            placeholder="Name or email"
                        >

                    </div>


                    <!-- Role -->

                    <div class="col-12 col-md-6 col-xl-2">

                        <label
                            for="role"
                            class="form-label fw-semibold"
                        >
                            Role
                        </label>

                        <select
                            class="form-select"
                            id="role"
                            name="role"
                        >

                            <option value="">
                                All Roles
                            </option>

                            <option
                                value="student"
                                <%= filters.role === "student" ? "selected" : "" %>
                            >
                                Student
                            </option>

                            <option
                                value="faculty"
                                <%= filters.role === "faculty" ? "selected" : "" %>
                            >
                                Faculty
                            </option>

                            <option
                                value="admin"
                                <%= filters.role === "admin" ? "selected" : "" %>
                            >
                                Admin
                            </option>

                        </select>

                    </div>


                    <!-- Status -->

                    <div class="col-12 col-md-6 col-xl-2">

                        <label
                            for="status"
                            class="form-label fw-semibold"
                        >
                            Status
                        </label>

                        <select
                            class="form-select"
                            id="status"
                            name="status"
                        >

                            <option value="">
                                All Status
                            </option>

                            <option
                                value="active"
                                <%= filters.status === "active" ? "selected" : "" %>
                            >
                                Active
                            </option>

                            <option
                                value="inactive"
                                <%= filters.status === "inactive" ? "selected" : "" %>
                            >
                                Inactive
                            </option>

                        </select>

                    </div>


                    <!-- Department -->

                    <div class="col-12 col-md-6 col-xl-2">

                        <label
                            for="department"
                            class="form-label fw-semibold"
                        >
                            Department
                        </label>

                        <select
                            class="form-select"
                            id="department"
                            name="department"
                        >

                            <option value="">
                                All Departments
                            </option>

                            <% departments.forEach(department => { %>

                                <option
                                    value="<%= department.name %>"
                                    <%= filters.department === department.name ? "selected" : "" %>
                                >
                                    <%= department.name %>
                                    <% if (department.code) { %>
                                        (<%= department.code %>)
                                    <% } %>
                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <!-- Program -->

                    <div class="col-12 col-md-6 col-xl-2">

                        <label
                            for="program"
                            class="form-label fw-semibold"
                        >
                            Program
                        </label>

                        <select
                            class="form-select"
                            id="program"
                            name="program"
                        >

                            <option value="">
                                All Programs
                            </option>

                            <% programs.forEach(program => { %>

                                <option
                                    value="<%= program.name %>"
                                    <%= filters.program === program.name ? "selected" : "" %>
                                >
                                    <%= program.name %>
                                    <% if (program.code) { %>
                                        (<%= program.code %>)
                                    <% } %>
                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <!-- Semester -->

                    <div class="col-12 col-md-6 col-xl-1">

                        <label
                            for="semester"
                            class="form-label fw-semibold"
                        >
                            Sem
                        </label>

                        <select
                            class="form-select"
                            id="semester"
                            name="semester"
                        >

                            <option value="">
                                All
                            </option>

                            <% semesters.forEach(semester => { %>

                                <option
                                    value="<%= semester %>"
                                    <%= String(filters.semester || "") === String(semester) ? "selected" : "" %>
                                >
                                    <%= semester %>
                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <!-- Buttons -->

                    <div class="col-12">

                        <div class="d-flex flex-wrap gap-2">

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                <i class="bi bi-search me-1"></i>
                                Apply Filters
                            </button>

                            <a
                                href="/admin/users"
                                class="btn btn-outline-secondary"
                            >
                                <i class="bi bi-x-circle me-1"></i>
                                Clear Filters
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- USERS TABLE -->
    <!-- ========================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>

                    <h5 class="mb-1 fw-semibold">
                        Users
                    </h5>

                    <small class="text-muted">
                        Showing
                        <strong><%= users.length %></strong>
                        user(s)
                    </small>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <% if (users.length === 0) { %>

                <div class="text-center py-5 px-3">

                    <div class="fs-1 text-muted mb-3">
                        <i class="bi bi-people"></i>
                    </div>

                    <h5 class="fw-semibold">
                        No users found
                    </h5>

                    <p class="text-muted mb-0">
                        Try changing your search or filter criteria.
                    </p>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-3">
                                    User
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Academic Details
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Last Login
                                </th>

                                <th>
                                    Created
                                </th>

                                <th class="text-end px-3">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% users.forEach(user => { %>

                                <tr>

                                    <!-- USER -->

                                    <td class="px-3">

                                        <div class="d-flex align-items-center">

                                            <div
                                                class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3"
                                                style="width: 42px; height: 42px;"
                                            >

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    <%= user.name %>
                                                </div>

                                                <div class="small text-muted">
                                                    <%= user.email %>
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ROLE -->

                                    <td>

                                        <% if (user.role === "student") { %>

                                            <span class="badge text-bg-success">
                                                <i class="bi bi-mortarboard me-1"></i>
                                                Student
                                            </span>

                                        <% } else if (user.role === "faculty") { %>

                                            <span class="badge text-bg-info">
                                                <i class="bi bi-person-workspace me-1"></i>
                                                Faculty
                                            </span>

                                        <% } else { %>

                                            <span class="badge text-bg-danger">
                                                <i class="bi bi-shield-lock me-1"></i>
                                                Admin
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- ACADEMIC DETAILS -->

                                    <td>

                                        <% if (user.role === "student" && user.studentProfile) { %>

                                            <div class="small">

                                                <div class="fw-semibold">
                                                    <%= user.studentProfile.studentId || "—" %>
                                                </div>

                                                <div class="text-muted">
                                                    <%= user.studentProfile.department || "—" %>
                                                </div>

                                                <div class="text-muted">
                                                    <%= user.studentProfile.program || "—" %>
                                                    · Sem
                                                    <%= user.studentProfile.semester || "—" %>
                                                    <% if (user.studentProfile.section) { %>
                                                        · Sec
                                                        <%= user.studentProfile.section %>
                                                    <% } %>
                                                </div>

                                            </div>

                                        <% } else if (user.role === "faculty" && user.facultyProfile) { %>

                                            <div class="small">

                                                <div class="fw-semibold">
                                                    <%= user.facultyProfile.employeeId || "—" %>
                                                </div>

                                                <div class="text-muted">
                                                    <%= user.facultyProfile.department || "—" %>
                                                </div>

                                                <div class="text-muted">
                                                    <%= user.facultyProfile.designation || "—" %>
                                                </div>

                                            </div>

                                        <% } else if (user.role === "admin") { %>

                                            <span class="text-muted small">
                                                System Administrator
                                            </span>

                                        <% } else { %>

                                            <span class="text-muted">
                                                —
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% if (user.isActive) { %>

                                            <span class="badge text-bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge text-bg-secondary">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Inactive
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- LAST LOGIN -->

                                    <td>

                                        <% if (user.lastLogin) { %>

                                            <span class="small">
                                                <%= new Date(user.lastLogin).toLocaleString("en-IN") %>
                                            </span>

                                        <% } else { %>

                                            <span class="text-muted small">
                                                Never
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- CREATED -->

                                    <td>

                                        <span class="small text-muted">
                                            <%= new Date(user.createdAt).toLocaleDateString("en-IN") %>
                                        </span>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-end px-3">

                                        <div class="dropdown">

                                            <button
                                                class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                            >
                                                Actions
                                            </button>


                                            <ul class="dropdown-menu dropdown-menu-end">

                                                <!-- VIEW -->

                                                <li>

                                                    <a
                                                        class="dropdown-item"
                                                        href="/admin/users/<%= user._id %>"
                                                    >
                                                        <i class="bi bi-eye me-2"></i>
                                                        View Details
                                                    </a>

                                                </li>


                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>


                                                <!-- STATUS -->

                                                <% if (
                                                    currentUser &&
                                                    String(currentUser.id) === String(user._id)
                                                ) { %>

                                                    <li>

                                                        <span class="dropdown-item-text text-muted">

                                                            <i class="bi bi-lock me-2"></i>

                                                            Current Admin Account

                                                        </span>

                                                    </li>

                                                <% } else { %>

                                                    <li>

                                                        <form
                                                            method="POST"
                                                            action="/admin/users/<%= user._id %>/toggle-status"
                                                            onsubmit="return confirm('<%= user.isActive ? "Deactivate this user?" : "Activate this user?" %>');"
                                                        >

                                                            <button
                                                                type="submit"
                                                                class="dropdown-item <%= user.isActive ? "text-danger" : "text-success" %>"
                                                            >

                                                                <% if (user.isActive) { %>

                                                                    <i class="bi bi-person-x me-2"></i>
                                                                    Deactivate User

                                                                <% } else { %>

                                                                    <i class="bi bi-person-check me-2"></i>
                                                                    Activate User

                                                                <% } %>

                                                            </button>

                                                        </form>

                                                    </li>

                                                <% } %>

                                                <li>
    <form
        method="POST"
        action="/admin/users/<%= user._id %>/delete"
        onsubmit="return confirm('Are you sure you want to delete this user account? This action will not delete the user’s academic/history records.');"
    >
        <button
            type="submit"
            class="dropdown-item text-danger"
        >
            <i class="bi bi-trash3 me-2"></i>
            Delete User
        </button>
    </form>
</li>


                                                <!-- RESET PASSWORD -->

                                                <% if (user.role !== "admin") { %>

                                                    <li>

                                                        <form
                                                            method="POST"
                                                            action="/admin/users/<%= user._id %>/reset-password"
                                                            onsubmit="return confirm('Generate a new temporary password for this user?');"
                                                        >

                                                            <button
                                                                type="submit"
                                                                class="dropdown-item text-warning"
                                                            >

                                                                <i class="bi bi-key me-2"></i>
                                                                Reset Password

                                                            </button>

                                                        </form>

                                                    </li>

                                                <% } %>

                                            </ul>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>

</div>