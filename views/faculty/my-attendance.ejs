<% layout("layouts/boilerplate") -%>

<%
    const record = attendance || null;

    const workingDays =
        record?.workingDays ?? 0;

    const presentDays =
        record?.presentDays ?? 0;

    const leaveDays =
        record?.leaveDays ?? 0;

    const absentDays =
        record?.absentDays ?? 0;

    const effectiveWorkingDays =
        Math.max(
            workingDays - leaveDays,
            0
        );

    const percentage =
        effectiveWorkingDays > 0
            ? Math.min(
                (
                    presentDays /
                    effectiveWorkingDays
                ) * 100,
                100
            )
            : 0;

    const percentageValue =
        Number(percentage).toFixed(2);

    let attendanceStatus = "No Data";
    let statusClass = "neutral";

    if (record) {
        if (percentage >= 90) {
            attendanceStatus = "Excellent";
            statusClass = "excellent";
        } else if (percentage >= 75) {
            attendanceStatus = "Good";
            statusClass = "good";
        } else if (percentage >= 60) {
            attendanceStatus = "Needs Attention";
            statusClass = "warning";
        } else {
            attendanceStatus = "Low Attendance";
            statusClass = "danger";
        }
    }
%>

<div class="faculty-my-attendance">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="attendance-hero">

        <div class="hero-content">

            <div class="hero-avatar">
                <%= faculty.name.charAt(0).toUpperCase() %>
            </div>

            <div>

                <span class="hero-label">
                    FACULTY PORTAL
                </span>

                <h1>
                    My Attendance
                </h1>

                <p>
                    Track your attendance and monthly
                    presence records.
                </p>

            </div>

        </div>

        <div class="hero-decoration hero-decoration-one"></div>
        <div class="hero-decoration hero-decoration-two"></div>

    </section>


    <!-- =====================================================
         FACULTY PROFILE
    ====================================================== -->

    <section class="profile-card">

        <div class="profile-left">

            <div class="profile-avatar">
                <%= faculty.name.charAt(0).toUpperCase() %>
            </div>

            <div>

                <span class="profile-label">
                    FACULTY MEMBER
                </span>

                <h2>
                    <%= faculty.name %>
                </h2>

                <p>
                    <i class="bi bi-envelope me-1"></i>
                    <%= faculty.email %>
                </p>

            </div>

        </div>

        <div>

            <% if (faculty.isActive) { %>

                <span class="status-badge active">
                    <span></span>
                    Active
                </span>

            <% } else { %>

                <span class="status-badge inactive">
                    <span></span>
                    Inactive
                </span>

            <% } %>

        </div>

    </section>


    <!-- =====================================================
         MONTH FILTER
    ====================================================== -->

    <section class="filter-card">

        <div class="filter-heading">

            <div class="filter-icon">
                <i class="bi bi-calendar3"></i>
            </div>

            <div>

                <h3>
                    Attendance Period
                </h3>

                <p>
                    Select a month to view your attendance.
                </p>

            </div>

        </div>


        <form
            method="GET"
            action="/faculty/my-attendance"
            class="filter-form"
        >

            <div class="filter-field">

                <label for="month">
                    Month
                </label>

                <select
                    id="month"
                    name="month"
                    class="form-select"
                >

                    <%
                        const months = [
                            "January",
                            "February",
                            "March",
                            "April",
                            "May",
                            "June",
                            "July",
                            "August",
                            "September",
                            "October",
                            "November",
                            "December"
                        ];
                    %>

                    <% months.forEach((monthName, index) => { %>

                        <option
                            value="<%= index + 1 %>"
                            <%= Number(month) === index + 1
                                ? "selected"
                                : "" %>
                        >
                            <%= monthName %>
                        </option>

                    <% }) %>

                </select>

            </div>


            <div class="filter-field">

                <label for="year">
                    Year
                </label>

                <select
                    id="year"
                    name="year"
                    class="form-select"
                >

                    <%
                        const currentYear =
                            new Date().getFullYear();

                        for (
                            let y = currentYear - 2;
                            y <= currentYear + 1;
                            y++
                        ) {
                    %>

                        <option
                            value="<%= y %>"
                            <%= Number(year) === y
                                ? "selected"
                                : "" %>
                        >
                            <%= y %>
                        </option>

                    <% } %>

                </select>

            </div>


            <button
                type="submit"
                class="btn load-btn"
            >
                <i class="bi bi-search me-2"></i>
                View Attendance
            </button>

        </form>

    </section>


    <% if (record) { %>

        <!-- =================================================
             MAIN ATTENDANCE
        ================================================== -->

        <section class="attendance-main-card">

            <div class="attendance-main-content">

                <div class="attendance-circle-wrapper">

                    <div
                        class="attendance-circle"
                        style="
                            --attendance:
                            <%= percentageValue %>%;
                        "
                    >

                        <div class="circle-inner">

                            <strong>
                                <%= percentageValue %>%
                            </strong>

                            <span>
                                Attendance
                            </span>

                        </div>

                    </div>

                </div>


                <div class="attendance-main-info">

                    <span class="month-label">
                        <%= months[Number(month) - 1] %>
                        <%= year %>
                    </span>

                    <h2>
                        Your Attendance
                    </h2>

                    <p>
                        Your attendance percentage is calculated
                        using present days against effective
                        working days. Approved leave is excluded
                        from the calculation.
                    </p>


                    <div class="attendance-status <%= statusClass %>">

                        <% if (statusClass === "excellent") { %>
                            <i class="bi bi-stars"></i>
                        <% } else if (statusClass === "good") { %>
                            <i class="bi bi-check-circle-fill"></i>
                        <% } else if (statusClass === "warning") { %>
                            <i class="bi bi-exclamation-circle-fill"></i>
                        <% } else if (statusClass === "danger") { %>
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        <% } else { %>
                            <i class="bi bi-info-circle-fill"></i>
                        <% } %>

                        <span>
                            <%= attendanceStatus %>
                        </span>

                    </div>

                </div>

            </div>


            <div class="attendance-progress-section">

                <div class="progress-header">

                    <span>
                        Attendance Progress
                    </span>

                    <strong>
                        <%= percentageValue %>%
                    </strong>

                </div>

                <div class="progress-track">

                    <div
                        class="progress-fill"
                        style="
                            width:
                            <%= percentageValue %>%;
                        "
                    ></div>

                </div>

            </div>

        </section>


        <!-- =================================================
             SUMMARY CARDS
        ================================================== -->

        <section class="stats-grid">

            <!-- Working Days -->

            <div class="stat-card working">

                <div class="stat-icon">
                    <i class="bi bi-calendar-week"></i>
                </div>

                <div>

                    <span>
                        Working Days
                    </span>

                    <strong>
                        <%= workingDays %>
                    </strong>

                    <small>
                        Official working days
                    </small>

                </div>

            </div>


            <!-- Present -->

            <div class="stat-card present">

                <div class="stat-icon">
                    <i class="bi bi-person-check-fill"></i>
                </div>

                <div>

                    <span>
                        Present
                    </span>

                    <strong>
                        <%= presentDays %>
                    </strong>

                    <small>
                        Days present
                    </small>

                </div>

            </div>


            <!-- Leave -->

            <div class="stat-card leave">

                <div class="stat-icon">
                    <i class="bi bi-calendar-minus-fill"></i>
                </div>

                <div>

                    <span>
                        Approved Leave
                    </span>

                    <strong>
                        <%= leaveDays %>
                    </strong>

                    <small>
                        Approved leave days
                    </small>

                </div>

            </div>


            <!-- Absent -->

            <div class="stat-card absent">

                <div class="stat-icon">
                    <i class="bi bi-person-x-fill"></i>
                </div>

                <div>

                    <span>
                        Absent
                    </span>

                    <strong>
                        <%= absentDays %>
                    </strong>

                    <small>
                        Days absent
                    </small>

                </div>

            </div>

        </section>


        <!-- =================================================
             ATTENDANCE BREAKDOWN
        ================================================== -->

        <section class="breakdown-card">

            <div class="section-heading">

                <div>

                    <span class="section-label">
                        MONTHLY BREAKDOWN
                    </span>

                    <h3>
                        Attendance Overview
                    </h3>

                </div>

                <div class="overview-icon">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>

            </div>


            <div class="breakdown-list">

                <!-- Present -->

                <div class="breakdown-row">

                    <div class="breakdown-title">

                        <div class="mini-icon present-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div>

                            <strong>
                                Present
                            </strong>

                            <span>
                                <%= presentDays %> days
                            </span>

                        </div>

                    </div>

                    <div class="breakdown-bar">

                        <div class="bar-track">

                            <div
                                class="bar-fill present-bar"
                                style="
                                    width:
                                    <%= effectiveWorkingDays > 0
                                        ? Math.min(
                                            (presentDays /
                                            effectiveWorkingDays) * 100,
                                            100
                                        )
                                        : 0
                                    %>%;
                                "
                            ></div>

                        </div>

                        <strong>
                            <%= effectiveWorkingDays > 0
                                ? (
                                    (presentDays /
                                    effectiveWorkingDays) *
                                    100
                                ).toFixed(1)
                                : "0.0" %>%
                        </strong>

                    </div>

                </div>


                <!-- Absent -->

                <div class="breakdown-row">

                    <div class="breakdown-title">

                        <div class="mini-icon absent-icon">
                            <i class="bi bi-x-lg"></i>
                        </div>

                        <div>

                            <strong>
                                Absent
                            </strong>

                            <span>
                                <%= absentDays %> days
                            </span>

                        </div>

                    </div>

                    <div class="breakdown-bar">

                        <div class="bar-track">

                           <div class="bar-track">
                               <div
                                    class="bar-fill absent-bar"
                                 style="width: <%= effectiveWorkingDays > 0
                                    ? Math.min((absentDays / effectiveWorkingDays) * 100, 100)
                                    : 0 %>%"
                                 ></div>
                            </div>

                        </div>

                        <strong>
                            <%= effectiveWorkingDays > 0
                                ? (
                                    (absentDays /
                                    effectiveWorkingDays) *
                                    100
                                ).toFixed(1)
                                : "0.0" %>%
                        </strong>

                    </div>

                </div>


                <!-- Leave -->

                <div class="breakdown-row">

                    <div class="breakdown-title">

                        <div class="mini-icon leave-icon">
                            <i class="bi bi-calendar2-minus"></i>
                        </div>

                        <div>

                            <strong>
                                Approved Leave
                            </strong>

                            <span>
                                <%= leaveDays %> days
                            </span>

                        </div>

                    </div>

                    <div class="breakdown-bar">

                        <div class="bar-track">

                            <div
                                class="bar-fill leave-bar"
                                style="
                                    width:
                                    <%= workingDays > 0
                                        ? Math.min(
                                            (leaveDays /
                                            workingDays) * 100,
                                            100
                                        )
                                        : 0
                                    %>%;
                                "
                            ></div>

                        </div>

                        <strong>
                            <%= workingDays > 0
                                ? (
                                    (leaveDays /
                                    workingDays) *
                                    100
                                ).toFixed(1)
                                : "0.0" %>%
                        </strong>

                    </div>

                </div>

            </div>

        </section>


    <% } else { %>

        <!-- =================================================
             NO DATA
        ================================================== -->

        <section class="empty-state">

            <div class="empty-icon">
                <i class="bi bi-calendar-x"></i>
            </div>

            <span class="empty-label">
                NO ATTENDANCE RECORD
            </span>

            <h2>
                Attendance data isn't available yet
            </h2>

            <p>
                There is no attendance record for
                <strong>
                    <%= months[Number(month) - 1] %>
                    <%= year %>
                </strong>.
                Please contact the administrator if
                you believe this information should be available.
            </p>

            <div class="empty-note">
                <i class="bi bi-shield-check"></i>
                Attendance is maintained by the
                university administration.
            </div>

        </section>

    <% } %>


    <!-- =====================================================
         INFORMATION
    ====================================================== -->

    <section class="info-card">

        <div class="info-icon">
            <i class="bi bi-lock-fill"></i>
        </div>

        <div>

            <h4>
                Read-only Attendance
            </h4>

            <p>
                Your attendance records are maintained
                by the university administration.
                Faculty members cannot edit or modify
                attendance records from this page.
            </p>

        </div>

    </section>

</div>


<style>

/* =========================================================
   MAIN
========================================================= */

.faculty-my-attendance {
    max-width: 1450px;
    margin: 0 auto;
    padding: 8px 4px 45px;
}


/* =========================================================
   HERO
========================================================= */

.attendance-hero {
    position: relative;
    overflow: hidden;
    min-height: 205px;
    padding: 35px;
    display: flex;
    align-items: center;
    border-radius: 25px;
    color: #fff;
    background:
        linear-gradient(
            135deg,
            #172554 0%,
            #3730a3 52%,
            #6366f1 100%
        );
    box-shadow:
        0 18px 50px rgba(49, 46, 129, .23);
}

.hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 20px;
}

.hero-avatar {
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 22px;
    font-size: 28px;
    font-weight: 800;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.23);
    backdrop-filter: blur(12px);
}

.hero-label {
    display: block;
    margin-bottom: 5px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.7px;
    opacity: .72;
}

.attendance-hero h1 {
    margin: 0;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    letter-spacing: -1.2px;
}

.attendance-hero p {
    margin: 8px 0 0;
    color: rgba(255,255,255,.78);
    font-size: 14px;
}

.hero-decoration {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
}

.hero-decoration-one {
    width: 280px;
    height: 280px;
    top: -150px;
    right: -70px;
    background: rgba(255,255,255,.07);
}

.hero-decoration-two {
    width: 170px;
    height: 170px;
    right: 25%;
    bottom: -120px;
    background: rgba(255,255,255,.045);
}


/* =========================================================
   PROFILE
========================================================= */

.profile-card {
    position: relative;
    z-index: 3;
    margin: -25px 25px 22px;
    padding: 21px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-radius: 19px;
    background: #fff;
    border: 1px solid #e8ebf3;
    box-shadow:
        0 13px 35px rgba(15,23,42,.09);
}

.profile-left {
    display: flex;
    align-items: center;
    gap: 15px;
}

.profile-avatar {
    width: 57px;
    height: 57px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 17px;
    color: #fff;
    font-size: 22px;
    font-weight: 800;
    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );
}

.profile-label {
    display: block;
    color: #8c95a7;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

.profile-card h2 {
    margin: 2px 0 2px;
    color: #172033;
    font-size: 19px;
    font-weight: 800;
}

.profile-card p {
    margin: 0;
    color: #7e8799;
    font-size: 12px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 750;
}

.status-badge span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
}

.status-badge.active {
    color: #047857;
    background: #ecfdf5;
}

.status-badge.active span {
    background: #10b981;
}

.status-badge.inactive {
    color: #b45309;
    background: #fffbeb;
}

.status-badge.inactive span {
    background: #f59e0b;
}


/* =========================================================
   FILTER
========================================================= */

.filter-card {
    margin-bottom: 20px;
    padding: 24px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid #e8ebf3;
    box-shadow:
        0 9px 30px rgba(15,23,42,.045);
}

.filter-heading {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 20px;
}

.filter-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    color: #4f46e5;
    background: #eef2ff;
    font-size: 18px;
}

.filter-heading h3 {
    margin: 0;
    color: #20293b;
    font-size: 17px;
    font-weight: 800;
}

.filter-heading p {
    margin: 3px 0 0;
    color: #8992a5;
    font-size: 11px;
}

.filter-form {
    display: flex;
    align-items: flex-end;
    gap: 14px;
}

.filter-field {
    flex: 1;
}

.filter-field label {
    display: block;
    margin-bottom: 7px;
    color: #354056;
    font-size: 12px;
    font-weight: 750;
}

.form-select {
    min-height: 46px;
    border-radius: 11px;
    border-color: #dfe4ed;
    box-shadow: none !important;
    font-size: 13px;
}

.form-select:focus {
    border-color: #818cf8;
    box-shadow:
        0 0 0 4px rgba(99,102,241,.09) !important;
}

.load-btn {
    min-height: 46px;
    padding: 0 20px;
    flex-shrink: 0;
    border: 0;
    border-radius: 11px;
    color: #fff;
    background: #4f46e5;
    font-size: 12px;
    font-weight: 750;
    transition: .2s ease;
}

.load-btn:hover {
    color: #fff;
    background: #4338ca;
    transform: translateY(-1px);
}


/* =========================================================
   MAIN ATTENDANCE CARD
========================================================= */

.attendance-main-card {
    margin-bottom: 20px;
    padding: 29px;
    border-radius: 22px;
    background: #fff;
    border: 1px solid #e8ebf3;
    box-shadow:
        0 11px 35px rgba(15,23,42,.055);
}

.attendance-main-content {
    display: flex;
    align-items: center;
    gap: 35px;
}

.attendance-circle-wrapper {
    flex-shrink: 0;
}

.attendance-circle {
    width: 190px;
    height: 190px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background:
        conic-gradient(
            #4f46e5 var(--attendance),
            #e9eaf3 0
        );
}

.attendance-circle::before {
    content: "";
    position: absolute;
    inset: 12px;
    border-radius: 50%;
    background: #fff;
}

.circle-inner {
    position: relative;
    z-index: 2;
    text-align: center;
}

.circle-inner strong {
    display: block;
    color: #172033;
    font-size: 32px;
    line-height: 1;
    font-weight: 850;
}

.circle-inner span {
    display: block;
    margin-top: 7px;
    color: #8992a5;
    font-size: 10px;
    font-weight: 700;
}

.attendance-main-info {
    flex: 1;
}

.month-label {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 7px;
    color: #4f46e5;
    background: #eef2ff;
    font-size: 10px;
    font-weight: 800;
}

.attendance-main-info h2 {
    margin: 9px 0 6px;
    color: #172033;
    font-size: 24px;
    font-weight: 800;
}

.attendance-main-info p {
    max-width: 680px;
    margin: 0;
    color: #7c8699;
    font-size: 12px;
    line-height: 1.7;
}

.attendance-status {
    width: fit-content;
    margin-top: 15px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 750;
}

.attendance-status.excellent {
    color: #047857;
    background: #ecfdf5;
}

.attendance-status.good {
    color: #2563eb;
    background: #eff6ff;
}

.attendance-status.warning {
    color: #b45309;
    background: #fffbeb;
}

.attendance-status.danger {
    color: #b91c1c;
    background: #fef2f2;
}

.attendance-status.neutral {
    color: #475569;
    background: #f1f5f9;
}


/* =========================================================
   PROGRESS
========================================================= */

.attendance-progress-section {
    margin-top: 27px;
    padding-top: 23px;
    border-top: 1px solid #edf0f5;
}

.progress-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 9px;
}

.progress-header span {
    color: #677287;
    font-size: 11px;
    font-weight: 700;
}

.progress-header strong {
    color: #4f46e5;
    font-size: 13px;
}

.progress-track {
    height: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: #e9eaf2;
}

.progress-fill {
    height: 100%;
    border-radius: inherit;
    background:
        linear-gradient(
            90deg,
            #4f46e5,
            #7c3aed
        );
    transition: width .6s ease;
}


/* =========================================================
   STATS
========================================================= */

.stats-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0,1fr));
    gap: 15px;
    margin-bottom: 20px;
}

.stat-card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 20px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid #e8ebf3;
    box-shadow:
        0 8px 28px rgba(15,23,42,.045);
}

.stat-icon {
    width: 47px;
    height: 47px;
    display: flex;
    align-items: center;
    justify-content: center;
