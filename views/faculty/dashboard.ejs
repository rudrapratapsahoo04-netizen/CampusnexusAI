<!-- =========================================================
     AI JAVASCRIPT
========================================================= -->

<script>
(() => {

    "use strict";


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const aiButton =
        document.getElementById(
            "facultyAiButton"
        );

    const aiChat =
        document.getElementById(
            "facultyAiChat"
        );

    const aiClose =
        document.getElementById(
            "facultyAiClose"
        );

    const aiForm =
        document.getElementById(
            "facultyAiForm"
        );

    const aiInput =
        document.getElementById(
            "facultyAiInput"
        );

    const aiMessages =
        document.getElementById(
            "facultyAiMessages"
        );

    const aiTyping =
        document.getElementById(
            "facultyAiTyping"
        );

    const aiSend =
        document.getElementById(
            "facultyAiSend"
        );


    /* =====================================================
       SAFETY CHECK
    ====================================================== */

    if (
        !aiButton ||
        !aiChat ||
        !aiClose ||
        !aiForm ||
        !aiInput ||
        !aiMessages ||
        !aiTyping ||
        !aiSend
    ) {

        console.error(
            "Faculty AI: required elements not found."
        );

        return;

    }


    /* =====================================================
       OPEN
    ====================================================== */

    function openAI() {

        aiChat.classList.add(
            "active"
        );

        aiChat.setAttribute(
            "aria-hidden",
            "false"
        );

        setTimeout(() => {

            aiInput.focus();

        }, 250);

    }


    /* =====================================================
       CLOSE
    ====================================================== */

    function closeAI() {

        aiChat.classList.remove(
            "active"
        );

        aiChat.setAttribute(
            "aria-hidden",
            "true"
        );

    }


    aiButton.addEventListener(
        "click",
        () => {

            if (
                aiChat.classList.contains(
                    "active"
                )
            ) {

                closeAI();

            } else {

                openAI();

            }

        }
    );


    aiClose.addEventListener(
        "click",
        closeAI
    );


    /* =====================================================
       ESC
    ====================================================== */

    document.addEventListener(
        "keydown",
        (event) => {

            if (
                event.key === "Escape" &&
                aiChat.classList.contains(
                    "active"
                )
            ) {

                closeAI();

            }

        }
    );


    /* =====================================================
       ADD MESSAGE
    ====================================================== */

    function addMessage(
        message,
        type
    ) {

        const wrapper =
            document.createElement(
                "div"
            );

        wrapper.className =
            "ai-message " +
            type;


        const bubble =
            document.createElement(
                "div"
            );

        bubble.className =
            "ai-bubble";


        bubble.textContent =
            String(
                message || ""
            );


        wrapper.appendChild(
            bubble
        );


        aiMessages.insertBefore(
            wrapper,
            aiTyping
        );


        aiMessages.scrollTop =
            aiMessages.scrollHeight;

    }


    /* =====================================================
       TYPING
    ====================================================== */

    function setTyping(
        visible
    ) {

        if (visible) {

            aiTyping.classList.add(
                "active"
            );

        } else {

            aiTyping.classList.remove(
                "active"
            );

        }


        aiMessages.scrollTop =
            aiMessages.scrollHeight;

    }


    /* =====================================================
       SEND MESSAGE
    ====================================================== */

    async function sendMessage(
        message
    ) {

        const cleanMessage =
            String(
                message || ""
            ).trim();


        if (!cleanMessage) {
            return;
        }


        addMessage(
            cleanMessage,
            "user"
        );


        aiInput.value = "";

        aiInput.disabled = true;
        aiSend.disabled = true;


        setTyping(true);


        try {

            const response =
                await fetch(
                    "/faculty/ai/chat",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "Accept":
                                "application/json"
                        },

                        credentials:
                            "same-origin",

                        body:
                            JSON.stringify({
                                message:
                                    cleanMessage
                            })
                    }
                );


            let data = null;


            try {

                data =
                    await response.json();

            } catch (
                jsonError
            ) {

                data = null;

            }


            if (!response.ok) {

                throw new Error(
                    data?.reply ||
                    data?.message ||
                    "Faculty AI service is unavailable."
                );

            }


            setTyping(false);


            addMessage(
                data?.reply ||
                data?.answer ||
                "Sorry, I can only answer questions from my available knowledge.",
                "bot"
            );


        } catch (error) {

            console.error(
                "Faculty AI error:",
                error
            );


            setTyping(false);


            addMessage(
                "Sorry, I can only answer questions from my available knowledge.",
                "bot"
            );


        } finally {

            aiInput.disabled = false;
            aiSend.disabled = false;

            aiInput.focus();

        }

    }


    /* =====================================================
       FORM
    ====================================================== */

    aiForm.addEventListener(
        "submit",
        (event) => {

            event.preventDefault();

            sendMessage(
                aiInput.value
            );

        }
    );


    /* =====================================================
       QUICK QUESTIONS
    ====================================================== */

    document
        .querySelectorAll(
            ".ai-quick-list button"
        )
        .forEach(
            (button) => {

                button.addEventListener(
                    "click",
                    () => {

                        const question =
                            button.dataset.question;

                        sendMessage(
                            question
                        );

                    }
                );

            }
        );


    /* =====================================================
       ENTER
    ====================================================== */

    aiInput.addEventListener(
        "keydown",
        (event) => {

            if (
                event.key === "Enter" &&
                !event.shiftKey
            ) {

                event.preventDefault();

                aiForm.requestSubmit();

            }

        }
    );


    /* =====================================================
       INITIAL SCROLL
    ====================================================== */

    aiMessages.scrollTop =
        aiMessages.scrollHeight;

})();
</script>