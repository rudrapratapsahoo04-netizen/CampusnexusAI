<% layout("layouts/boilerplate") -%>

<style>
/* =========================================================
   FACULTY DASHBOARD
========================================================= */

.faculty-page {
    position: relative;
    min-height: calc(100vh - 70px);
    padding: 35px 20px 100px;
    overflow: hidden;

    background:
        radial-gradient(circle at 5% 10%,
            rgba(79, 70, 229, 0.16),
            transparent 30%),
        radial-gradient(circle at 95% 10%,
            rgba(236, 72, 153, 0.14),
            transparent 28%),
        radial-gradient(circle at 85% 90%,
            rgba(6, 182, 212, 0.13),
            transparent 30%),
        linear-gradient(
            135deg,
            #f8fafc 0%,
            #eef2ff 45%,
            #fdf2f8 100%
        );
}

.faculty-container {
    position: relative;
    z-index: 2;
    max-width: 1250px;
    margin: 0 auto;
}

/* =========================================================
   BACKGROUND DECORATION
========================================================= */

.faculty-page::before,
.faculty-page::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
}

.faculty-page::before {
    width: 300px;
    height: 300px;
    top: -120px;
    left: -120px;
    background: rgba(99, 102, 241, 0.08);
    animation: floatingCircle 8s ease-in-out infinite;
}

.faculty-page::after {
    width: 360px;
    height: 360px;
    right: -150px;
    bottom: -120px;
    background: rgba(236, 72, 153, 0.07);
    animation: floatingCircle 9s ease-in-out infinite reverse;
}

/* =========================================================
   HERO
========================================================= */

.faculty-hero {
    position: relative;
    overflow: hidden;

    padding: 36px;

    border-radius: 28px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #312e81 0%,
            #4f46e5 38%,
            #7c3aed 70%,
            #db2777 100%
        );

    box-shadow:
        0 25px 60px rgba(79, 70, 229, 0.28);

    animation: heroEnter 0.7s ease both;
}

.faculty-hero::before {
    content: "";
    position: absolute;

    width: 250px;
    height: 250px;

    right: -70px;
    top: -120px;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.10);
}

.faculty-hero::after {
    content: "";
    position: absolute;

    width: 170px;
    height: 170px;

    left: 45%;
    bottom: -110px;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.07);
}

.faculty-hero-content {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
}

.hero-left {
    flex: 1;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 8px 14px;
    margin-bottom: 15px;

    border-radius: 999px;

    background:
        rgba(255, 255, 255, 0.14);

    border:
        1px solid
        rgba(255, 255, 255, 0.22);

    font-size: 12px;
    font-weight: 800;

    backdrop-filter: blur(10px);
}

.hero-badge i {
    font-size: 15px;
}

.faculty-hero h1 {
    margin: 0 0 12px;

    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;

    font-weight: 800;
    letter-spacing: -1px;
}

.faculty-hero p {
    margin: 0;

    max-width: 720px;

    color:
        rgba(255, 255, 255, 0.84);

    font-size: 15px;
    line-height: 1.7;
}

/* Hero AI Icon */

.hero-ai-badge {
    position: relative;

    width: 115px;
    height: 115px;

    flex-shrink: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        rgba(255, 255, 255, 0.14);

    border:
        1px solid
        rgba(255, 255, 255, 0.28);

    box-shadow:
        inset 0 0 25px rgba(255,255,255,0.08),
        0 15px 35px rgba(0,0,0,0.15);

    backdrop-filter: blur(12px);

    animation: aiPulse 3s ease-in-out infinite;
}

.hero-ai-badge i {
    font-size: 38px;
    margin-bottom: 5px;
}

.hero-ai-badge span {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

/* =========================================================
   PROFILE
========================================================= */

.faculty-profile {
    margin-top: 25px;
    animation: slideUp 0.7s 0.1s ease both;
}

.profile-card {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding: 24px;

    background:
        rgba(255, 255, 255, 0.90);

    border:
        1px solid
        rgba(148, 163, 184, 0.18);

    border-radius: 22px;

    box-shadow:
        0 15px 40px
        rgba(15, 23, 42, 0.08);

    overflow: hidden;

    backdrop-filter: blur(12px);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.profile-card:hover {
    transform: translateY(-4px);

    box-shadow:
        0 22px 45px
        rgba(15, 23, 42, 0.13);
}

.profile-card::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 5px;

    background:
        linear-gradient(
            to bottom,
            #4f46e5,
            #7c3aed,
            #ec4899
        );
}

.profile-main {
    display: flex;
    align-items: center;

    gap: 18px;
}

.faculty-avatar {
    width: 68px;
    height: 68px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 20px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    font-size: 24px;
    font-weight: 800;

    box-shadow:
        0 10px 25px
        rgba(79, 70, 229, 0.25);
}

.profile-info h3 {
    margin: 0 0 5px;

    color: #0f172a;

    font-size: 20px;
    font-weight: 800;
}

.profile-info p {
    margin: 0 0 8px;

    color: #64748b;

    font-size: 14px;
}

.profile-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    color: #15803d;

    font-size: 12px;
    font-weight: 800;
}

.status-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #22c55e;

    box-shadow:
        0 0 0 4px
        rgba(34, 197, 94, 0.12);
}

.profile-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 11px 17px;

    border-radius: 12px;

    text-decoration: none;

    color: #4338ca;

    background:
        #eef2ff;

    font-size: 13px;
    font-weight: 800;

    transition:
        transform 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.profile-button:hover {
    transform: translateY(-3px);

    color: #3730a3;

    background:
        #e0e7ff;

    box-shadow:
        0 10px 20px
        rgba(79, 70, 229, 0.14);
}

/* =========================================================
   SECTION TITLE
========================================================= */

.section-title {
    display: flex;
    align-items: center;
    gap: 12px;

    margin: 38px 0 18px;

    animation:
        slideUp 0.7s 0.15s ease both;
}

.section-title-icon {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 13px;

    color: #4f46e5;

    background:
        linear-gradient(
            135deg,
            #eef2ff,
            #f5f3ff
        );

    box-shadow:
        0 8px 20px
        rgba(79, 70, 229, 0.10);
}

.section-title-icon i {
    font-size: 20px;
}

.section-title h2 {
    margin: 0;

    color: #0f172a;

    font-size: 21px;
    font-weight: 800;
}

/* =========================================================
   ACTION GRID
========================================================= */

.faculty-actions {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 18px;
}

.faculty-action-card {
    position: relative;

    display: flex;
    align-items: center;

    gap: 16px;

    min-height: 110px;

    padding: 20px;

    text-decoration: none;

    background:
        rgba(255, 255, 255, 0.91);

    border:
        1px solid
        rgba(148, 163, 184, 0.17);

    border-radius: 20px;

    overflow: hidden;

    box-shadow:
        0 10px 30px
        rgba(15, 23, 42, 0.07);

    transition:
        transform 0.28s ease,
        box-shadow 0.28s ease,
        border-color 0.28s ease;

    animation:
        cardEnter 0.65s ease both;
}

/* Top color line */

.faculty-action-card::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 4px;

    background:
        linear-gradient(
            90deg,
            #4f46e5,
            #7c3aed,
            #ec4899
        );

    transform:
        scaleX(0);

    transform-origin: left;

    transition:
        transform 0.3s ease;
}

/* Corner color */

.faculty-action-card::after {
    content: "";

    position: absolute;

    width: 100px;
    height: 100px;

    right: -50px;
    bottom: -50px;

    border-radius: 50%;

    background:
        rgba(99, 102, 241, 0.06);

    transition:
        transform 0.35s ease;
}

.faculty-action-card:hover {
    transform: translateY(-7px);

    border-color:
        rgba(99, 102, 241, 0.20);

    box-shadow:
        0 20px 42px
        rgba(15, 23, 42, 0.13);
}

.faculty-action-card:hover::before {
    transform:
        scaleX(1);
}

.faculty-action-card:hover::after {
    transform:
        scale(2.2);
}

.action-icon {
    position: relative;
    z-index: 2;

    width: 54px;
    height: 54px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 16px;

    color: #4f46e5;

    background:
        linear-gradient(
            135deg,
            #eef2ff,
            #f5f3ff
        );

    font-size: 22px;

    transition:
        transform 0.3s ease,
        border-radius 0.3s ease;
}

.faculty-action-card:hover .action-icon {
    transform:
        rotate(-5deg)
        scale(1.08);

    border-radius: 18px;
}

.action-content {
    position: relative;
    z-index: 2;
}

.action-content h3 {
    margin: 0 0 5px;

    color: #0f172a;

    font-size: 16px;
    font-weight: 800;
}

.action-content p {
    margin: 0;

    color: #64748b;

    font-size: 12px;
    line-height: 1.5;
}

/* Different icon colors */

.faculty-action-card:nth-child(1) .action-icon {
    color: #4f46e5;
    background: #eef2ff;
}

.faculty-action-card:nth-child(2) .action-icon {
    color: #0891b2;
    background: #ecfeff;
}

.faculty-action-card:nth-child(3) .action-icon {
    color: #059669;
    background: #ecfdf5;
}

.faculty-action-card:nth-child(4) .action-icon {
    color: #ea580c;
    background: #fff7ed;
}

.faculty-action-card:nth-child(5) .action-icon {
    color: #7c3aed;
    background: #f5f3ff;
}

.faculty-action-card:nth-child(6) .action-icon {
    color: #db2777;
    background: #fdf2f8;
}

.faculty-action-card:nth-child(7) .action-icon {
    color: #2563eb;
    background: #eff6ff;
}

.faculty-action-card:nth-child(8) .action-icon {
    color: #ca8a04;
    background: #fefce8;
}

.faculty-action-card:nth-child(9) .action-icon {
    color: #dc2626;
    background: #fef2f2;
}

/* Stagger */

.faculty-action-card:nth-child(1) {
    animation-delay: 0.08s;
}

.faculty-action-card:nth-child(2) {
    animation-delay: 0.14s;
}

.faculty-action-card:nth-child(3) {
    animation-delay: 0.20s;
}

.faculty-action-card:nth-child(4) {
    animation-delay: 0.26s;
}

.faculty-action-card:nth-child(5) {
    animation-delay: 0.32s;
}

.faculty-action-card:nth-child(6) {
    animation-delay: 0.38s;
}

.faculty-action-card:nth-child(7) {
    animation-delay: 0.44s;
}

.faculty-action-card:nth-child(8) {
    animation-delay: 0.50s;
}

.faculty-action-card:nth-child(9) {
    animation-delay: 0.56s;
}

/* =========================================================
   ACCESS CARD
========================================================= */

.access-card {
    position: relative;

    margin-top: 35px;

    padding: 25px;

    border-radius: 22px;

    background:
        linear-gradient(
            135deg,
            rgba(79, 70, 229, 0.08),
            rgba(236, 72, 153, 0.07)
        );

    border:
        1px solid
        rgba(99, 102, 241, 0.12);

    box-shadow:
        0 12px 30px
        rgba(79, 70, 229, 0.07);

    animation:
        slideUp 0.8s 0.4s ease both;
}

.access-card-inner {
    display: flex;
    align-items: flex-start;

    gap: 15px;
}

.access-icon {
    width: 46px;
    height: 46px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    color: #4f46e5;

    background: white;

    box-shadow:
        0 8px 18px
        rgba(15, 23, 42, 0.07);

    font-size: 20px;
}

.access-card h3 {
    margin: 0 0 6px;

    color: #312e81;

    font-size: 17px;
    font-weight: 800;
}

.access-card p {
    margin: 0;

    color: #64748b;

    font-size: 13px;
    line-height: 1.7;
}

/* =========================================================
   FLOATING AI BUTTON
========================================================= */

.faculty-ai-button {
    position: fixed;

    right: 28px;
    bottom: 28px;

    width: 70px;
    height: 70px;

    padding: 0;

    border: 0;
    border-radius: 50%;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(
            135deg,
            #312e81,
            #4f46e5,
            #7c3aed,
            #db2777
        );

    box-shadow:
        0 15px 40px
        rgba(79, 70, 229, 0.42);

    z-index: 9998;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.faculty-ai-button:hover {
    transform:
        scale(1.10)
        rotate(-4deg);

    box-shadow:
        0 20px 50px
        rgba(79, 70, 229, 0.52);
}

.faculty-ai-button::before {
    content: "";

    position: absolute;

    inset: -6px;

    border-radius: 50%;

    border:
        2px solid
        rgba(99, 102, 241, 0.25);

    animation:
        aiRing 2.2s ease-out infinite;
}

/* AI logo */

.ai-logo-wrap {
    position: relative;
    z-index: 2;

    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    overflow: hidden;

    background:
        rgba(255,255,255,0.16);

    border:
        2px solid
        rgba(255,255,255,0.28);
}

.ai-logo-wrap img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    border-radius: 50%;
}

/* If logo3.png is unavailable */

.ai-logo-fallback {
    display: none;

    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    color: white;

    font-size: 28px;
}

.ai-logo-wrap.image-error img {
    display: none;
}

.ai-logo-wrap.image-error .ai-logo-fallback {
    display: flex;
}

/* Label */

.ai-button-label {
    position: absolute;

    right: 80px;
    top: 50%;

    transform:
        translateY(-50%);

    padding: 8px 12px;

    border-radius: 10px;

    white-space: nowrap;

    color: white;

    background:
        #0f172a;

    font-size: 12px;
    font-weight: 800;

    opacity: 0;
    pointer-events: none;

    transition:
        opacity 0.25s ease,
        transform 0.25s ease;
}

.faculty-ai-button:hover .ai-button-label {
    opacity: 1;

    transform:
        translateY(-50%)
        translateX(-3px);
}

/* =========================================================
   AI CHAT
========================================================= */

.faculty-ai-chat {
    position: fixed;

    right: 28px;
    bottom: 112px;

    width: min(400px, calc(100vw - 30px));
    height: 580px;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border-radius: 24px;

    background:
        rgba(255,255,255,0.98);

    border:
        1px solid
        rgba(148,163,184,0.18);

    box-shadow:
        0 30px 80px
        rgba(15,23,42,0.24);

    backdrop-filter: blur(20px);

    z-index: 9999;

    opacity: 0;
    visibility: hidden;

    transform:
        translateY(20px)
        scale(0.96);

    transform-origin:
        bottom right;

    transition:
        opacity 0.25s ease,
        visibility 0.25s ease,
        transform 0.25s ease;
}

.faculty-ai-chat.active {
    opacity: 1;
    visibility: visible;

    transform:
        translateY(0)
        scale(1);
}

/* =========================================================
   AI HEADER
========================================================= */

.ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 16px 18px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #312e81,
            #4f46e5,
            #7c3aed
        );
}

.ai-chat-title {
    display: flex;
    align-items: center;
    gap: 11px;
}

.ai-chat-avatar {
    width: 42px;
    height: 42px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 12px;

    background:
        rgba(255,255,255,0.16);
}

.ai-chat-avatar img {
    width: 100%;
    height: 100%;

    object-fit: cover;
}

.ai-chat-title strong {
    display: block;

    font-size: 14px;
    font-weight: 800;
}

.ai-online {
    display: flex;
    align-items: center;

    gap: 5px;

    margin-top: 3px;

    color:
        rgba(255,255,255,0.75);

    font-size: 10px;
}

.ai-online-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #4ade80;
}

.ai-close {
    width: 35px;
    height: 35px;

    border: 0;
    border-radius: 10px;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    color: white;

    background:
        rgba(255,255,255,0.10);

    font-size: 18px;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.ai-close:hover {
    background:
        rgba(255,255,255,0.20);

    transform:
        rotate(90deg);
}

/* =========================================================
   MESSAGES
========================================================= */

.ai-chat-messages {
    flex: 1;

    padding: 18px;

    overflow-y: auto;

    background:
        linear-gradient(
            180deg,
            #f8fafc,
            #ffffff
        );
}

.ai-message {
    display: flex;

    margin-bottom: 14px;

    animation:
        messageEnter 0.25s ease both;
}

.ai-message.bot {
    justify-content: flex-start;
}

.ai-message.user {
    justify-content: flex-end;
}

.ai-bubble {
    max-width: 84%;

    padding: 11px 13px;

    border-radius: 15px;

    font-size: 13px;
    line-height: 1.55;

    white-space: pre-line;
    word-break: break-word;
}

.ai-message.bot .ai-bubble {
    color: #334155;

    background: white;

    border:
        1px solid
        rgba(148,163,184,0.18);

    border-bottom-left-radius: 5px;

    box-shadow:
        0 5px 15px
        rgba(15,23,42,0.05);
}

.ai-message.user .ai-bubble {
    color: white;

    background:
        linear-gradient(
            135deg,
            #4f46e5,
            #7c3aed
        );

    border-bottom-right-radius: 5px;
}

/* =========================================================
   TYPING
========================================================= */

.ai-typing {
    display: none;

    align-items: center;

    gap: 4px;

    width: fit-content;

    margin-bottom: 12px;

    padding: 10px 13px;

    border-radius: 14px;

    background: white;

    border:
        1px solid
        rgba(148,163,184,0.18);
}

.ai-typing.active {
    display: flex;
}

.ai-typing span {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #6366f1;

    animation:
        typingDot 1s infinite ease-in-out;
}

.ai-typing span:nth-child(2) {
    animation-delay: 0.15s;
}

.ai-typing span:nth-child(3) {
    animation-delay: 0.30s;
}

/* =========================================================
   QUICK QUESTIONS
========================================================= */

.ai-quick {
    padding: 11px 14px;

    border-top:
        1px solid
        rgba(148,163,184,0.12);

    background: white;
}

.ai-quick-title {
    margin-bottom: 8px;

    color: #64748b;

    font-size: 10px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.6px;
}

.ai-quick-list {
    display: flex;

    gap: 7px;

    overflow-x: auto;

    padding-bottom: 2px;
}

.ai-quick-list button {
    flex-shrink: 0;

    padding: 7px 10px;

    border:
        1px solid
        #e2e8f0;

    border-radius: 999px;

    cursor: pointer;

    color: #475569;

    background:
        #f8fafc;

