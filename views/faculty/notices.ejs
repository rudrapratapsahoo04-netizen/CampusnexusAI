<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* =========================================================
           RAW ASSIGNMENTS
        ========================================================== */

        const rawAssignments =
            <%- JSON.stringify(
                safeAssignments
            ) %>;


        const assignments =
            rawAssignments
                .map(function (assignment) {

                    return {

                        department:
                            String(
                                assignment.department || ""
                            )
                            .trim()
                            .toLowerCase(),

                        program:
                            String(
                                assignment.program || ""
                            )
                            .trim()
                            .toLowerCase(),

                        semester:
                            Number(
                                assignment.semester
                            ),

                        section:
                            String(
                                assignment.section || ""
                            )
                            .trim()
                            .toUpperCase(),

                        courseCode:
                            String(
                                assignment.courseCode || ""
                            )
                            .trim()
                            .toUpperCase(),

                        courseName:
                            String(
                                assignment.courseName || ""
                            )
                            .trim()

                    };

                })
                .filter(function (assignment) {

                    return (
                        assignment.department &&
                        assignment.program &&
                        Number.isInteger(
                            assignment.semester
                        ) &&
                        assignment.section &&
                        assignment.courseCode
                    );

                });



        /* =========================================================
           ELEMENTS
        ========================================================== */

        const department =
            document.getElementById(
                "department"
            );

        const program =
            document.getElementById(
                "program"
            );

        const semester =
            document.getElementById(
                "semester"
            );

        const section =
            document.getElementById(
                "section"
            );

        const courseCode =
            document.getElementById(
                "courseCode"
            );

        const courseName =
            document.getElementById(
                "courseName"
            );

        const selectionSummary =
            document.getElementById(
                "selectionSummary"
            );

        const selectionText =
            document.getElementById(
                "selectionText"
            );

        const noticeType =
            document.getElementById(
                "noticeType"
            );

        const facultyLeaveBox =
            document.getElementById(
                "facultyLeaveBox"
            );

        const facultyLeave =
            document.getElementById(
                "facultyLeave"
            );

        const leavePreview =
            document.getElementById(
                "leavePreview"
            );

        const rescheduleBox =
            document.getElementById(
                "rescheduleBox"
            );

        const noticeForm =
            document.getElementById(
                "noticeForm"
            );

        const noticeTitle =
            document.getElementById(
                "noticeTitle"
            );

        const noticeDescription =
            document.getElementById(
                "noticeDescription"
            );

        const descriptionCount =
            document.getElementById(
                "descriptionCount"
            );

        const studentNoticePreview =
            document.getElementById(
                "studentNoticePreview"
            );

        const previewTitle =
            document.getElementById(
                "previewTitle"
            );

        const previewDescription =
            document.getElementById(
                "previewDescription"
            );

        const previewTarget =
            document.getElementById(
                "previewTarget"
            );

        const previewLeave =
            document.getElementById(
                "previewLeave"
            );



        /* =========================================================
           HELPERS
        ========================================================== */

        function resetSelect(
            select,
            placeholder
        ) {

            select.innerHTML = "";

            const option =
                document.createElement(
                    "option"
                );

            option.value = "";

            option.textContent =
                placeholder;

            select.appendChild(
                option
            );

            select.disabled = true;

        }


        function uniqueValues(
            array
        ) {

            return [
                ...new Set(array)
            ];

        }


        function addOption(
            select,
            value,
            label
        ) {

            const option =
                document.createElement(
                    "option"
                );

            option.value =
                value;

            option.textContent =
                label;

            select.appendChild(
                option
            );

        }


        function formatDate(
            value
        ) {

            if (!value) {
                return "-";
            }

            return new Date(value)
                .toLocaleDateString(
                    "en-IN",
                    {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    }
                );

        }


        function calculateDays(
            start,
            end
        ) {

            if (!start || !end) {
                return 0;
            }

            const startDate =
                new Date(start);

            const endDate =
                new Date(end);

            startDate.setHours(
                0, 0, 0, 0
            );

            endDate.setHours(
                0, 0, 0, 0
            );

            return (
                Math.floor(
                    (
                        endDate.getTime() -
                        startDate.getTime()
                    ) /
                    (
                        1000 *
                        60 *
                        60 *
                        24
                    )
                ) + 1
            );

        }



        /* =========================================================
           LOAD DEPARTMENTS
        ========================================================== */

        function loadDepartments() {

            resetSelect(
                department,
                "Select Department"
            );

            resetSelect(
                program,
                "Select Program"
            );

            resetSelect(
                semester,
                "Select Semester"
            );

            resetSelect(
                section,
                "Select Section"
            );

            resetSelect(
                courseCode,
                "Select Course"
            );


            const departments =
                uniqueValues(
                    assignments.map(
                        function (item) {
                            return item.department;
                        }
                    )
                )
                .sort();


            departments.forEach(
                function (item) {

                    addOption(
                        department,
                        item,
                        item.toUpperCase()
                    );

                }
            );


            if (
                departments.length
            ) {

                department.disabled =
                    false;

            }

        }



        /* =========================================================
           DEPARTMENT
        ========================================================== */

        department.addEventListener(
            "change",
            function () {

                const selectedDepartment =
                    this.value
                        .trim()
                        .toLowerCase();


                resetSelect(
                    program,
                    "Select Program"
                );

                resetSelect(
                    semester,
                    "Select Semester"
                );

                resetSelect(
                    section,
                    "Select Section"
                );

                resetSelect(
                    courseCode,
                    "Select Course"
                );


                hideSelectionSummary();


                if (
                    !selectedDepartment
                ) {
                    return;
                }


                const programs =
                    uniqueValues(
                        assignments
                            .filter(
                                function (item) {

                                    return (
                                        item.department ===
                                        selectedDepartment
                                    );

                                }
                            )
                            .map(
                                function (item) {

                                    return item.program;

                                }
                            )
                    )
                    .sort();


                programs.forEach(
                    function (item) {

                        addOption(
                            program,
                            item,
                            item.toUpperCase()
                        );

                    }
                );


                if (
                    programs.length
                ) {

                    program.disabled =
                        false;

                }

                updatePreviewTarget();

            }
        );



        /* =========================================================
           PROGRAM
        ========================================================== */

        program.addEventListener(
            "change",
            function () {

                const selectedDepartment =
                    department.value
                        .trim()
                        .toLowerCase();

                const selectedProgram =
                    this.value
                        .trim()
                        .toLowerCase();


                resetSelect(
                    semester,
                    "Select Semester"
                );

                resetSelect(
                    section,
                    "Select Section"
                );

                resetSelect(
                    courseCode,
                    "Select Course"
                );


                hideSelectionSummary();


                if (
                    !selectedDepartment ||
                    !selectedProgram
                ) {

                    return;

                }


                const semesters =
                    uniqueValues(
                        assignments
                            .filter(
                                function (item) {

                                    return (
                                        item.department ===
                                            selectedDepartment &&
                                        item.program ===
                                            selectedProgram
                                    );

                                }
                            )
                            .map(
                                function (item) {

                                    return item.semester;

                                }
                            )
                    )
                    .sort(
                        function (a, b) {
                            return a - b;
                        }
                    );


                semesters.forEach(
                    function (item) {

                        addOption(
                            semester,
                            item,
                            "Semester " + item
                        );

                    }
                );


                if (
                    semesters.length
                ) {

                    semester.disabled =
                        false;

                }

                updatePreviewTarget();

            }
        );



        /* =========================================================
           SEMESTER
        ========================================================== */

        semester.addEventListener(
            "change",
            function () {

                const selectedDepartment =
                    department.value
                        .trim()
                        .toLowerCase();

                const selectedProgram =
                    program.value
                        .trim()
                        .toLowerCase();

                const selectedSemester =
                    Number(this.value);


                resetSelect(
                    section,
                    "Select Section"
                );

                resetSelect(
                    courseCode,
                    "Select Course"
                );


                hideSelectionSummary();


                if (
                    !selectedDepartment ||
                    !selectedProgram ||
                    !selectedSemester
                ) {

                    return;

                }


                const sections =
                    uniqueValues(
                        assignments
                            .filter(
                                function (item) {

                                    return (
                                        item.department ===
                                            selectedDepartment &&
                                        item.program ===
                                            selectedProgram &&
                                        item.semester ===
                                            selectedSemester
                                    );

                                }
                            )
                            .map(
                                function (item) {

                                    return item.section;

                                }
                            )
                    )
                    .sort();


                sections.forEach(
                    function (item) {

                        addOption(
                            section,
                            item,
                            "Section " + item
                        );

                    }
                );


                if (
                    sections.length
                ) {

                    section.disabled =
                        false;

                }

                updatePreviewTarget();

            }
        );



        /* =========================================================
           SECTION
        ========================================================== */

        section.addEventListener(
            "change",
            function () {

                const selectedDepartment =
                    department.value
                        .trim()
                        .toLowerCase();

                const selectedProgram =
                    program.value
                        .trim()
                        .toLowerCase();

                const selectedSemester =
                    Number(
                        semester.value
                    );

                const selectedSection =
                    this.value
                        .trim()
                        .toUpperCase();


                resetSelect(
                    courseCode,
                    "Select Course"
                );


                hideSelectionSummary();


                if (
                    !selectedDepartment ||
                    !selectedProgram ||
                    !selectedSemester ||
                    !selectedSection
                ) {

                    return;

                }


                const courses =
                    assignments.filter(
                        function (item) {

                            return (
                                item.department ===
                                    selectedDepartment &&

                                item.program ===
                                    selectedProgram &&

                                item.semester ===
                                    selectedSemester &&

                                item.section ===
                                    selectedSection
                            );

                        }
                    );


                const uniqueCourses = [];


                courses.forEach(
                    function (item) {

                        const exists =
                            uniqueCourses.some(
                                function (course) {

                                    return (
                                        course.courseCode ===
                                        item.courseCode
                                    );

                                }
                            );


                        if (!exists) {

                            uniqueCourses.push(
                                item
                            );

                        }

                    }
                );


                uniqueCourses.sort(
                    function (a, b) {

                        return a.courseCode
                            .localeCompare(
                                b.courseCode
                            );

                    }
                );


                uniqueCourses.forEach(
                    function (item) {

                        addOption(
                            courseCode,
                            item.courseCode,
                            item.courseCode +
                            " - " +
                            item.courseName
                        );

                    }
                );


                if (
                    uniqueCourses.length
                ) {

                    courseCode.disabled =
                        false;

                }

                updatePreviewTarget();

            }
        );



        /* =========================================================
           COURSE
        ========================================================== */

        courseCode.addEventListener(
            "change",
            function () {

                const selectedCode =
                    this.value
                        .trim()
                        .toUpperCase();


                const selectedCourse =
                    assignments.find(
                        function (item) {

                            return (

                                item.department ===
                                    department.value
                                        .trim()
                                        .toLowerCase() &&

                                item.program ===
                                    program.value
                                        .trim()
                                        .toLowerCase() &&

                                item.semester ===
                                    Number(
                                        semester.value
                                    ) &&

                                item.section ===
                                    section.value
                                        .trim()
                                        .toUpperCase() &&

                                item.courseCode ===
                                    selectedCode

                            );

                        }
                    );


                if (
                    selectedCourse
                ) {

                    courseName.value =
                        selectedCourse.courseName;


                    showSelectionSummary(
                        selectedCourse
                    );

                } else {

                    courseName.value =
                        "";

                    hideSelectionSummary();

                }


                updatePreviewTarget();

            }
        );



        /* =========================================================
           SELECTION SUMMARY
        ========================================================== */

        function showSelectionSummary(
            course
        ) {

            selectionSummary.classList.remove(
                "d-none"
            );


            selectionText.textContent =

                department.value.toUpperCase() +
                " → " +

                program.value.toUpperCase() +
                " → Semester " +

                semester.value +
                " → Section " +

                section.value.toUpperCase() +
                " → " +

                course.courseCode +
                " - " +

                course.courseName;

        }


        function hideSelectionSummary() {

            selectionSummary.classList.add(
                "d-none"
            );

            selectionText.textContent =
                "";

            courseName.value =
                "";

        }



        /* =========================================================
           LEAVE CHANGE
        ========================================================== */

        facultyLeave.addEventListener(
            "change",
            function () {

                const selectedOption =
                    this.options[
                        this.selectedIndex
                    ];


                if (
                    !this.value ||
                    !selectedOption
                ) {

                    leavePreview.classList.add(
                        "d-none"
                    );

                    previewLeave.classList.add(
                        "d-none"
                    );

                    return;

                }


                const start =
                    selectedOption.dataset.start;

                const end =
                    selectedOption.dataset.end;

                const type =
                    selectedOption.dataset.type ||
                    "Faculty Leave";


                const days =
                    calculateDays(
                        start,
                        end
                    );


                document.getElementById(
                    "leavePreviewType"
                ).textContent =
                    type;


                document.getElementById(
                    "leavePreviewStart"
                ).textContent =
                    formatDate(start);


                document.getElementById(
                    "leavePreviewEnd"
                ).textContent =
                    formatDate(end);


                document.getElementById(
                    "leavePreviewDays"
                ).textContent =
                    days;


                document.getElementById(
                    "leaveStudentMessage"
                ).textContent =

                    "Students will be informed that the faculty member " +
                    "will be on " +
                    type +
                    " from " +
                    formatDate(start) +
                    " to " +
                    formatDate(end) +
                    " (" +
                    days +
                    " day" +
                    (days === 1 ? "" : "s") +
                    ").";


                leavePreview.classList.remove(
                    "d-none"
                );


                previewLeave.innerHTML =

                    "<strong>" +
                    type +
                    "</strong>" +

                    " · " +
                    formatDate(start) +

                    " → " +
                    formatDate(end) +

                    " · " +
                    days +

                    " day" +
                    (days === 1 ? "" : "s");


                previewLeave.classList.remove(
                    "d-none"
                );

            }
        );



        /* =========================================================
           NOTICE TYPE
        ========================================================== */

        noticeType.addEventListener(
            "change",
            function () {

                facultyLeaveBox.classList.add(
                    "d-none"
                );

                rescheduleBox.classList.add(
                    "d-none"
                );


                if (
                    this.value ===
                    "faculty_leave"
                ) {

                    facultyLeaveBox.classList.remove(
                        "d-none"
                    );

                }


                if (
                    this.value ===
                    "class_rescheduled"
                ) {

                    rescheduleBox.classList.remove(
                        "d-none"
                    );

                }


                updatePreview();

            }
        );



        /* =========================================================
           LIVE DESCRIPTION COUNTER
        ========================================================== */

        noticeDescription.addEventListener(
            "input",
            function () {

                descriptionCount.textContent =
                    this.value.length;

                updatePreview();

            }
        );



        noticeTitle.addEventListener(
            "input",
            updatePreview
        );



        /* =========================================================
           PREVIEW TARGET
        ========================================================== */

        function updatePreviewTarget() {

            const dept =
                department.value;

            const prog =
                program.value;

            const sem =
                semester.value;

            const sec =
                section.value;

            const course =
                courseCode.value;


            if (
                dept &&
                prog &&
                sem &&
                sec &&
                course
            ) {

                previewTarget.textContent =

                    dept.toUpperCase() +
                    " → " +
                    prog.toUpperCase() +
                    " → Semester " +
                    sem +
                    " → Section " +
                    sec.toUpperCase() +
                    " → " +
                    course;

            } else {

                previewTarget.textContent =
                    "Select target class above.";

            }

        }



        /* =========================================================
           STUDENT PREVIEW
        ========================================================== */

        function updatePreview() {

            if (
                noticeType.value ||
                noticeTitle.value ||
                noticeDescription.value
            ) {

                studentNoticePreview.classList.remove(
                    "d-none"
                );

            } else {

                studentNoticePreview.classList.add(
                    "d-none"
                );

            }


            previewTitle.textContent =
                noticeTitle.value ||
                "Your notice title";


            previewDescription.textContent =
                noticeDescription.value ||
                "Your notice message will appear here.";


            updatePreviewTarget();

        }



        /* =========================================================
           FORM VALIDATION
        ========================================================== */

        noticeForm.addEventListener(
            "submit",
            function (event) {

                if (
                    !department.value ||
                    !program.value ||
                    !semester.value ||
                    !section.value ||
                    !courseCode.value
                ) {

                    event.preventDefault();

                    alert(
                        "Please select Department, Program, Semester, Section and Course."
                    );

                    return;

                }


                if (
                    !noticeType.value
                ) {

                    event.preventDefault();

                    alert(
                        "Please select notice type."
                    );

                    return;

                }


                if (
                    noticeType.value ===
                    "faculty_leave"
                ) {

                    if (
                        !facultyLeave.value
                    ) {

                        event.preventDefault();

                        alert(
                            "Please select an approved faculty leave."
                        );

                        return;

                    }

                }


                if (
                    noticeType.value ===
                    "class_rescheduled"
                ) {

                    const date =
                        document.querySelector(
                            "[name='rescheduledDate']"
                        );

                    const start =
                        document.querySelector(
                            "[name='rescheduledStartTime']"
                        );

                    const end =
                        document.querySelector(
                            "[name='rescheduledEndTime']"
                        );


                    if (
                        !date.value ||
                        !start.value ||
                        !end.value
                    ) {

                        event.preventDefault();

                        alert(
                            "Please provide rescheduled date and time."
                        );

                        return;

                    }


                    if (
                        start.value >=
                        end.value
                    ) {

                        event.preventDefault();

                        alert(
                            "End time must be after start time."
                        );

                        return;

                    }

                }


                const publishBtn =
                    document.getElementById(
                        "publishBtn"
                    );


                publishBtn.disabled =
                    true;


                publishBtn.innerHTML =

                    '<span class="spinner-border spinner-border-sm me-2"></span>' +
                    'Publishing...';

            }
        );



        /* =========================================================
           INITIAL
        ========================================================== */

        loadDepartments();

        updatePreviewTarget();

    }
);

</script>
