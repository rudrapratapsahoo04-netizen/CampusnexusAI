<%= layout("layouts/boilerplate") -%>
<%
const safeAssignments = Array.isArray(assignments)
    ? assignments
    : [];

const safeLeaves = Array.isArray(approvedLeaves)
    ? approvedLeaves
    : [];

const safeNotices = Array.isArray(notices)
    ? notices
    : [];


/* =========================================================
   HELPERS
========================================================= */

function formatDate(date) {

    if (!date) {
        return "-";
    }

    return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric"
    });
}


function calculateLeaveDays(startDate, endDate) {

    if (!startDate || !endDate) {
        return 0;
    }

    const start = new Date(startDate);
    const end = new Date(endDate);

    start.setHours(0, 0, 0, 0);
    end.setHours(0, 0, 0, 0);

    const difference =
        end.getTime() - start.getTime();

    return (
        Math.floor(
            difference / (1000 * 60 * 60 * 24)
        ) + 1
    );
}


function formatNoticeType(type) {

    if (!type) {
        return "Notice";
    }

    return type
        .replaceAll("_", " ")
        .replace(/\b\w/g, function (c) {
            return c.toUpperCase();
        });
}

%>


<div class="container-fluid py-4 faculty-notice-page">


    <!-- =========================================================
         HERO
    ========================================================== -->

    <div class="notice-hero mb-4">

        <div class="hero-decoration hero-decoration-one"></div>
        <div class="hero-decoration hero-decoration-two"></div>

        <div class="hero-content">

            <div class="hero-icon">
                <i class="bi bi-megaphone-fill"></i>
            </div>

            <div>

                <div class="hero-eyebrow">
                    FACULTY COMMUNICATION
                </div>

                <h1 class="fw-bold mb-2">
                    Faculty Notices
                </h1>

                <p class="mb-0 hero-description">
                    Share important academic updates, leave information,
                    class changes and announcements with your assigned students.
                </p>

            </div>

        </div>


        <div class="hero-bottom">

            <div class="assignment-badge">

                <i class="bi bi-shield-check"></i>

                <span>
                    Only your assigned academic areas
                </span>

            </div>


            <div class="hero-stat">

                <strong>
                    <%= safeAssignments.length %>
                </strong>

                <span>
                    Active Assignment<%= safeAssignments.length === 1 ? "" : "s" %>
                </span>

            </div>

        </div>

    </div>



    <!-- =========================================================
         ALERTS
    ========================================================== -->

    <% if (typeof success !== "undefined" && success) { %>

        <div class="alert alert-success modern-alert shadow-sm">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                <%= success %>
            </span>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert">
            </button>

        </div>

    <% } %>


    <% if (typeof error !== "undefined" && error) { %>

        <div class="alert alert-danger modern-alert shadow-sm">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                <%= error %>
            </span>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert">
            </button>

        </div>

    <% } %>



    <!-- =========================================================
         NO ASSIGNMENTS
    ========================================================== -->

    <% if (safeAssignments.length === 0) { %>

        <div class="empty-assignment-card">

            <div class="empty-icon">

                <i class="bi bi-journal-x"></i>

            </div>

            <div class="empty-badge">
                ASSIGNMENT REQUIRED
            </div>

            <h3>
                No Active Faculty Assignments
            </h3>

            <p>
                You currently do not have any active course,
                semester or section assignments.
            </p>

            <div class="assignment-help">

                <i class="bi bi-info-circle-fill"></i>

                <span>
                    Please contact the administrator and ask them to
                    assign your department, program, semester, section
                    and course.
                </span>

            </div>

        </div>

    <% } else { %>



    <!-- =========================================================
         MAIN GRID
    ========================================================== -->

    <div class="row g-4">


        <!-- =====================================================
             LEFT — CREATE NOTICE
        ====================================================== -->

        <div class="col-xl-5">

            <div class="glass-card publish-card">

                <div class="card-header-modern">

                    <div>

                        <span class="section-label">
                            CREATE
                        </span>

                        <h3 class="mb-1">
                            Publish New Notice
                        </h3>

                        <p class="header-description mb-0">
                            Send an update to your assigned students.
                        </p>

                    </div>

                    <div class="header-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>

                </div>



                <form
                    method="POST"
                    action="/faculty/notices/publish"
                    id="noticeForm"
                    novalidate>


                    <!-- =================================================
                         NOTICE TYPE
                    ================================================== -->

                    <div class="form-group-modern">

                        <label>
                            Notice Type
                            <span>*</span>
                        </label>

                        <select
                            class="form-select modern-input"
                            name="noticeType"
                            id="noticeType"
                            required>

                            <option value="">
                                Select notice type
                            </option>

                            <option value="faculty_leave">
                                Faculty Leave
                            </option>

                            <option value="class_cancelled">
                                Class Cancelled
                            </option>

                            <option value="class_rescheduled">
                                Class Rescheduled
                            </option>

                            <option value="academic">
                                Academic Notice
                            </option>

                            <option value="assignment">
                                Assignment
                            </option>

                            <option value="other">
                                Other
                            </option>

                        </select>

                    </div>



                    <!-- =================================================
                         TITLE
                    ================================================== -->

                    <div class="form-group-modern">

                        <label>
                            Notice Title
                            <span>*</span>
                        </label>

                        <input
                            type="text"
                            name="title"
                            id="noticeTitle"
                            class="form-control modern-input"
                            placeholder="e.g. Faculty Leave — Classes Suspended"
                            maxlength="200"
                            required>

                    </div>



                    <!-- =================================================
                         NOTICE DATE
                    ================================================== -->

                    <div class="form-group-modern">

                        <label>
                            Notice Date
                        </label>

                        <input
                            type="date"
                            name="noticeDate"
                            id="noticeDate"
                            class="form-control modern-input">

                    </div>



                    <!-- =================================================
                         DESCRIPTION
                    ================================================== -->

                    <div class="form-group-modern">

                        <label>
                            Message for Students
                            <span>*</span>
                        </label>

                        <textarea
                            name="description"
                            id="noticeDescription"
                            class="form-control modern-input"
                            rows="5"
                            maxlength="5000"
                            placeholder="Write the complete message students should know..."
                            required></textarea>

                        <div class="character-counter">
                            <span id="descriptionCount">
                                0
                            </span>
                            / 5000
                        </div>

                    </div>



                    <!-- =================================================
                         TARGET CLASS
                    ================================================== -->

                    <div class="target-box">

                        <div class="target-header">

                            <div>

                                <span class="section-label">
                                    TARGET STUDENTS
                                </span>

                                <h5 class="mb-1">
                                    Select Academic Area
                                </h5>

                                <small>
                                    Students will receive the notice
                                    according to this exact class.
                                </small>

                            </div>

                            <i class="bi bi-diagram-3-fill"></i>

                        </div>



                        <!-- DEPARTMENT -->

                        <div class="form-group-modern">

                            <label>
                                Department
                                <span>*</span>
                            </label>

                            <select
                                name="department"
                                id="department"
                                class="form-select modern-input"
                                required>

                                <option value="">
                                    Select Department
                                </option>

                            </select>

                        </div>



                        <!-- PROGRAM -->

                        <div class="form-group-modern">

                            <label>
                                Program
                                <span>*</span>
                            </label>

                            <select
                                name="program"
                                id="program"
                                class="form-select modern-input"
                                disabled
                                required>

                                <option value="">
                                    Select Program
                                </option>

                            </select>

                        </div>



                        <!-- SEMESTER -->

                        <div class="form-group-modern">

                            <label>
                                Semester
                                <span>*</span>
                            </label>

                            <select
                                name="semester"
                                id="semester"
                                class="form-select modern-input"
                                disabled
                                required>

                                <option value="">
                                    Select Semester
                                </option>

                            </select>

                        </div>



                        <!-- SECTION -->

                        <div class="form-group-modern">

                            <label>
                                Section
                                <span>*</span>
                            </label>

                            <select
                                name="section"
                                id="section"
                                class="form-select modern-input"
                                disabled
                                required>

                                <option value="">
                                    Select Section
                                </option>

                            </select>

                        </div>



                        <!-- COURSE -->

                        <div class="form-group-modern">

                            <label>
                                Course
                                <span>*</span>
                            </label>

                            <select
                                name="courseCode"
                                id="courseCode"
                                class="form-select modern-input"
                                disabled
                                required>

                                <option value="">
                                    Select Course
                                </option>

                            </select>

                            <input
                                type="hidden"
                                name="courseName"
                                id="courseName">

                        </div>



                        <!-- TARGET SUMMARY -->

                        <div
                            id="selectionSummary"
                            class="selection-summary d-none">

                            <div class="summary-icon">

                                <i class="bi bi-check-circle-fill"></i>

                            </div>

                            <div>

                                <small>
                                    NOTICE WILL BE SENT TO
                                </small>

                                <strong id="selectionText">
                                </strong>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         FACULTY LEAVE
                    ================================================== -->

                    <div
                        id="facultyLeaveBox"
                        class="conditional-box leave-box d-none">


                        <div class="conditional-title">

                            <div class="conditional-icon">
                                <i class="bi bi-calendar-heart"></i>
                            </div>

                            <div>

                                <strong>
                                    Faculty Leave Details
                                </strong>

                                <small>
                                    Students will see this information
                                    in a clear leave notice.
                                </small>

                            </div>

                        </div>



                        <label class="form-label-custom">
                            Select Approved Leave
                        </label>

                        <select
                            name="facultyLeave"
                            id="facultyLeave"
                            class="form-select modern-input">

                            <option value="">
                                Select approved leave
                            </option>

                            <% safeLeaves.forEach(leave => { %>

                                <option
                                    value="<%= leave._id %>"
                                    data-start="<%= leave.startDate %>"
                                    data-end="<%= leave.endDate %>"
                                    data-type="<%= leave.leaveType || '' %>">

                                    <%= leave.leaveType
                                        ? leave.leaveType
                                        : "Leave"
                                    %>

                                    —
                                    <%= formatDate(leave.startDate) %>
                                    to
                                    <%= formatDate(leave.endDate) %>

                                </option>

                            <% }) %>

                        </select>



                        <!-- LEAVE PREVIEW -->

                        <div
                            id="leavePreview"
                            class="leave-preview d-none">

                            <div class="leave-preview-header">

                                <div class="leave-preview-icon">
                                    <i class="bi bi-calendar2-week"></i>
                                </div>

                                <div>

                                    <small>
                                        LEAVE SUMMARY
                                    </small>

                                    <strong id="leavePreviewType">
                                        -
                                    </strong>

                                </div>

                            </div>


                            <div class="leave-info-grid">

                                <div class="leave-info-item">

                                    <span>
                                        <i class="bi bi-calendar-event"></i>
                                        From
                                    </span>

                                    <strong id="leavePreviewStart">
                                        -
                                    </strong>

                                </div>


                                <div class="leave-info-item">

                                    <span>
                                        <i class="bi bi-calendar-check"></i>
                                        To
                                    </span>

                                    <strong id="leavePreviewEnd">
                                        -
                                    </strong>

                                </div>


                                <div class="leave-info-item leave-days-item">

                                    <span>
                                        <i class="bi bi-hourglass-split"></i>
                                        Duration
                                    </span>

                                    <strong>
                                        <span id="leavePreviewDays">
                                            0
                                        </span>
                                        day(s)
                                    </strong>

                                </div>

                            </div>


                            <div class="leave-student-message">

                                <i class="bi bi-info-circle-fill"></i>

                                <span id="leaveStudentMessage">
                                    Students will be informed about
                                    your leave period.
                                </span>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         RESCHEDULE
                    ================================================== -->

                    <div
                        id="rescheduleBox"
                        class="conditional-box d-none">

                        <div class="conditional-title">

                            <div class="conditional-icon">
                                <i class="bi bi-calendar-event"></i>
                            </div>

                            <div>

                                <strong>
                                    New Class Schedule
                                </strong>

                                <small>
                                    Tell students when the class
                                    will be conducted.
                                </small>

                            </div>

                        </div>


                        <div class="row g-3">

                            <div class="col-12">

                                <label class="form-label-custom">
                                    New Date
                                </label>

                                <input
                                    type="date"
                                    name="rescheduledDate"
                                    class="form-control modern-input">

                            </div>


                            <div class="col-md-6">

                                <label class="form-label-custom">
                                    Start Time
                                </label>

                                <input
                                    type="time"
                                    name="rescheduledStartTime"
                                    class="form-control modern-input">

                            </div>


                            <div class="col-md-6">

                                <label class="form-label-custom">
                                    End Time
                                </label>

                                <input
                                    type="time"
                                    name="rescheduledEndTime"
                                    class="form-control modern-input">

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         STUDENT PREVIEW
                    ================================================== -->

                    <div
                        id="studentNoticePreview"
                        class="student-preview d-none">

                        <div class="preview-header">

                            <span>
                                <i class="bi bi-eye"></i>
                                STUDENT PREVIEW
                            </span>

                            <small>
                                Approximate view
                            </small>

                        </div>


                        <div class="preview-card">

                            <div class="preview-badge">
                                NOTICE
                            </div>

                            <h5 id="previewTitle">
                                Your notice title
                            </h5>

                            <p id="previewDescription">
                                Your notice message will appear here.
                            </p>

                            <div
                                id="previewLeave"
                                class="preview-leave d-none">

                            </div>

                            <div
                                id="previewTarget"
                                class="preview-target">

                                Select target class above.

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         SUBMIT
                    ================================================== -->

                    <button
                        type="submit"
                        class="btn publish-btn w-100"
                        id="publishBtn">

                        <i class="bi bi-send-fill me-2"></i>

                        Publish Notice

                    </button>

                </form>

            </div>

        </div>



        <!-- =====================================================
             RIGHT — NOTICE HISTORY
        ====================================================== -->

        <div class="col-xl-7">

            <div class="glass-card history-card">

                <div class="card-header-modern">

                    <div>

                        <span class="section-label">
                            HISTORY
                        </span>

                        <h3 class="mb-1">
                            Published Notices
                        </h3>

                        <p class="header-description mb-0">
                            Track the notices you have shared.
                        </p>

                    </div>


                    <div class="notice-count">

                        <strong>
                            <%= safeNotices.length %>
                        </strong>

                    </div>

                </div>



                <% if (safeNotices.length === 0) { %>

                    <div class="empty-notices">

                        <div class="empty-icon small">

                            <i class="bi bi-megaphone"></i>

                        </div>

                        <h5>
                            No Notices Published
                        </h5>

                        <p>
                            Your published notices will appear here.
                        </p>

                    </div>

                <% } else { %>


                    <div class="notice-list">

                        <% safeNotices.forEach(notice => { %>

                            <div class="notice-item">


                                <!-- NOTICE HEADER -->

                                <div class="notice-item-top">

                                    <div>

                                        <span class="notice-type-badge">

                                            <%= formatNoticeType(
                                                notice.noticeType
                                            ) %>

                                        </span>

                                        <h5 class="mt-2 mb-1">
                                            <%= notice.title %>
                                        </h5>

                                    </div>


                                    <span
                                        class="<%= notice.isActive
                                            ? 'status-active'
                                            : 'status-inactive'
                                        %>">

                                        <i class="bi
                                            <%= notice.isActive
                                                ? 'bi-check-circle-fill'
                                                : 'bi-x-circle-fill'
                                            %>">
                                        </i>

                                        <%= notice.isActive
                                            ? "Active"
                                            : "Removed"
                                        %>

                                    </span>

                                </div>



                                <!-- DESCRIPTION -->

                                <p class="notice-description">
                                    <%= notice.description %>
                                </p>



                                <!-- =================================================
                                     LEAVE INFORMATION
                                ================================================== -->

                                <% if (
                                    notice.noticeType === "faculty_leave" &&
                                    notice.facultyLeave
                                ) { %>

                                    <%
                                    const leaveData =
                                        notice.facultyLeave;

                                    const leaveStart =
                                        leaveData.startDate;

                                    const leaveEnd =
                                        leaveData.endDate;

                                    const leaveDays =
                                        calculateLeaveDays(
                                            leaveStart,
                                            leaveEnd
                                        );
                                    %>


                                    <div class="published-leave-card">

                                        <div class="published-leave-icon">

                                            <i class="bi bi-calendar2-heart"></i>

                                        </div>


                                        <div class="published-leave-content">

                                            <span class="published-label">
                                                FACULTY LEAVE
                                            </span>

                                            <strong>
                                                <%= leaveData.leaveType || "Leave" %>
                                            </strong>


                                            <div class="published-leave-dates">

                                                <span>
                                                    <i class="bi bi-calendar-event"></i>
                                                    <%= formatDate(leaveStart) %>
                                                </span>

                                                <i class="bi bi-arrow-right"></i>

                                                <span>
                                                    <i class="bi bi-calendar-check"></i>
                                                    <%= formatDate(leaveEnd) %>
                                                </span>

                                                <span class="duration-pill">

                                                    <i class="bi bi-hourglass-split"></i>

                                                    <%= leaveDays %>
                                                    day<%= leaveDays === 1 ? "" : "s" %>

                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                <% } %>



                                <!-- =================================================
                                     TARGET
                                ================================================== -->

                                <div class="notice-meta-grid">

                                    <div>

                                        <i class="bi bi-building"></i>

                                        <span>
                                            <%= notice.department || "-" %>
                                        </span>

                                    </div>


                                    <div>

                                        <i class="bi bi-mortarboard"></i>

                                        <span>
                                            <%= notice.program || "-" %>
                                        </span>

                                    </div>


                                    <div>

                                        <i class="bi bi-layers"></i>

                                        <span>
                                            Semester
                                            <%= notice.semester || "-" %>
                                        </span>

                                    </div>


                                    <div>

                                        <i class="bi bi-people"></i>

                                        <span>
                                            Section
                                            <%= notice.section || "-" %>
                                        </span>

                                    </div>


                                    <div>

                                        <i class="bi bi-book"></i>

                                        <span>
                                            <%= notice.courseCode || "-" %>
                                        </span>

                                    </div>


                                    <div>

                                        <i class="bi bi-clock"></i>

                                        <span>
                                            <%= notice.publishedAt
                                                ? new Date(
                                                    notice.publishedAt
                                                ).toLocaleString(
                                                    "en-IN"
                                                )
                                                : "-"
                                            %>
                                        </span>

                                    </div>

                                </div>



                                <!-- =================================================
                                     RESCHEDULE INFORMATION
                                ================================================== -->

                                <% if (
                                    notice.noticeType ===
                                    "class_rescheduled"
                                ) { %>

                                    <div class="extra-notice-info">

                                        <strong>
                                            <i class="bi bi-calendar-event me-1"></i>
                                            Rescheduled Class
                                        </strong>

                                        <div class="reschedule-display">

                                            <span>
                                                <%= notice.rescheduledDate
                                                    ? formatDate(
                                                        notice.rescheduledDate
                                                    )
                                                    : "-"
                                                %>
                                            </span>

                                            <span>
                                                <%= notice.rescheduledStartTime || "-" %>
                                                -
                                                <%= notice.rescheduledEndTime || "-" %>
                                            </span>

                                        </div>

                                    </div>

                                <% } %>



                                <!-- =================================================
                                     REMOVE
                                ================================================== -->

                                <% if (notice.isActive) { %>

                                    <form
                                        method="POST"
                                        action="/faculty/notices/<%= notice._id %>/deactivate"
                                        class="mt-3">

                                        <button
                                            type="submit"
                                            class="btn btn-outline-danger btn-sm remove-btn"
                                            onclick="return confirm('Remove this notice? Students will no longer see it as an active notice.')">

                                            <i class="bi bi-trash3 me-1"></i>

                                            Remove Notice

                                        </button>

                                    </form>

                                <% } %>


                            </div>

                        <% }) %>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

    <% } %>

</div>



<!-- =============================================================
     STYLES
============================================================= -->

<style>

:root {

    --notice-primary: #4f46e5;
    --notice-primary-dark: #3730a3;
    --notice-secondary: #7c3aed;

    --notice-success: #059669;
    --notice-danger: #dc2626;

    --notice-text: #111827;
    --notice-muted: #6b7280;

    --notice-border: #e5e7eb;
    --notice-bg: #f8fafc;

}


.faculty-notice-page {
    max-width: 1700px;
    margin: auto;
}


/* =========================================================
   HERO
========================================================= */

.notice-hero {

    position: relative;

    overflow: hidden;

    border-radius: 26px;

    padding: 34px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #312e81 0%,
            #4f46e5 48%,
            #7c3aed 100%
        );

    box-shadow:
        0 22px 55px
        rgba(79,70,229,.20);

}


.hero-decoration {

    position: absolute;

    border-radius: 50%;

    background:
        rgba(255,255,255,.08);

    pointer-events: none;

}


.hero-decoration-one {

    width: 280px;
    height: 280px;

    right: -80px;
    top: -130px;

}


.hero-decoration-two {

    width: 170px;
    height: 170px;

    right: 220px;
    bottom: -120px;

}


.hero-content {

    position: relative;

    z-index: 2;

    display: flex;

    align-items: center;

    gap: 18px;

}


.hero-icon {

    width: 68px;
    height: 68px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 20px;

    background:
        rgba(255,255,255,.15);

    border:
        1px solid
        rgba(255,255,255,.18);

    font-size: 29px;

    flex-shrink: 0;

}


.hero-eyebrow {

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 1.8px;

    opacity: .75;

    margin-bottom: 4px;

}


.hero-description {

    max-width: 720px;

    opacity: .88;

}


.hero-bottom {

    position: relative;

    z-index: 2;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    margin-top: 25px;

}


.assignment-badge {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 9px 14px;

    border-radius: 999px;

