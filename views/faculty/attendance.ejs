<% layout("layouts/boilerplate") -%>

<%
    const attendanceFilters =
        (typeof filters !== "undefined" && filters)
            ? filters
            : {
                department: "",
                program: "",
                semester: "",
                section: "",
                courseCode: "",
                month: new Date().getMonth() + 1,
                year: new Date().getFullYear()
            };

    const attendanceSummary =
        (typeof summary !== "undefined" && summary)
            ? summary
            : {
                totalStudents: 0,
                totalClasses: 0,
                totalPresent: 0,
                totalAbsent: 0,
                overallPercentage: 0
            };

    const facultyCourses =
        (typeof assignedCourses !== "undefined" &&
            Array.isArray(assignedCourses))
            ? assignedCourses
            : [];

    const attendanceRecords =
        (typeof attendance !== "undefined" &&
            Array.isArray(attendance))
            ? attendance
            : [];
%>

<div class="container-fluid py-4">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-check me-2"></i>
                Student Attendance
            </h2>

            <p class="text-muted mb-0">
                Manage and monitor attendance for your assigned students.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a
                href="/faculty/dashboard"
                class="btn btn-outline-secondary"
            >
                <i class="bi bi-arrow-left me-1"></i>
                Dashboard
            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- FILTER CARD -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center">

                <div class="bg-primary-subtle text-primary rounded-circle p-2 me-2">
                    <i class="bi bi-funnel"></i>
                </div>

                <div>
                    <h5 class="mb-0 fw-semibold">
                        Attendance Filters
                    </h5>

                    <small class="text-muted">
                        Select the academic group and month.
                    </small>
                </div>

            </div>

        </div>


        <div class="card-body">

            <form
                action="/faculty/attendance"
                method="GET"
            >

                <div class="row g-3">

                    <!-- Department -->

                    <div class="col-md-6 col-lg-4">

                        <label
                            for="department"
                            class="form-label fw-semibold"
                        >
                            Department
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="department"
                            name="department"
                            value="<%= attendanceFilters.department || '' %>"
                            placeholder="Department"
                        >

                    </div>


                    <!-- Program -->

                    <div class="col-md-6 col-lg-4">

                        <label
                            for="program"
                            class="form-label fw-semibold"
                        >
                            Program
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="program"
                            name="program"
                            value="<%= attendanceFilters.program || '' %>"
                            placeholder="Program"
                        >

                    </div>


                    <!-- Semester -->

                    <div class="col-md-6 col-lg-4">

                        <label
                            for="semester"
                            class="form-label fw-semibold"
                        >
                            Semester
                        </label>

                        <select
                            class="form-select"
                            id="semester"
                            name="semester"
                        >

                            <option value="">
                                All Semesters
                            </option>

                            <% for (let semester = 1; semester <= 8; semester++) { %>

                                <option
                                    value="<%= semester %>"
                                    <%= Number(attendanceFilters.semester) === semester ? "selected" : "" %>
                                >
                                    Semester <%= semester %>
                                </option>

                            <% } %>

                        </select>

                    </div>


                    <!-- Section -->

                    <div class="col-md-6 col-lg-4">

                        <label
                            for="section"
                            class="form-label fw-semibold"
                        >
                            Section
                        </label>

                        <input
                            type="text"
                            class="form-control text-uppercase"
                            id="section"
                            name="section"
                            value="<%= attendanceFilters.section || '' %>"
                            placeholder="Section"
                        >

                    </div>


                    <!-- Course Code -->

                    <div class="col-md-6 col-lg-4">

                        <label
                            for="courseCode"
                            class="form-label fw-semibold"
                        >
                            Course Code
                        </label>

                        <input
                            type="text"
                            class="form-control text-uppercase"
                            id="courseCode"
                            name="courseCode"
                            value="<%= attendanceFilters.courseCode || '' %>"
                            placeholder="Course Code"
                        >

                    </div>


                    <!-- Month -->

                    <div class="col-md-6 col-lg-2">

                        <label
                            for="month"
                            class="form-label fw-semibold"
                        >
                            Month
                        </label>

                        <select
                            class="form-select"
                            id="month"
                            name="month"
                        >

                            <% const months = [
                                "January",
                                "February",
                                "March",
                                "April",
                                "May",
                                "June",
                                "July",
                                "August",
                                "September",
                                "October",
                                "November",
                                "December"
                            ]; %>

                            <% months.forEach((monthName, index) => { %>

                                <option
                                    value="<%= index + 1 %>"
                                    <%= Number(attendanceFilters.month) === index + 1 ? "selected" : "" %>
                                >
                                    <%= monthName %>
                                </option>

                            <% }) %>

                        </select>

                    </div>


                    <!-- Year -->

                    <div class="col-md-6 col-lg-2">

                        <label
                            for="year"
                            class="form-label fw-semibold"
                        >
                            Year
                        </label>

                        <select
                            class="form-select"
                            id="year"
                            name="year"
                        >

                            <%
                                const currentYear =
                                    new Date().getFullYear();

                                for (
                                    let year = currentYear - 2;
                                    year <= currentYear + 1;
                                    year++
                                ) {
                            %>

                                <option
                                    value="<%= year %>"
                                    <%= Number(attendanceFilters.year) === year ? "selected" : "" %>
                                >
                                    <%= year %>
                                </option>

                            <% } %>

                        </select>

                    </div>


                    <!-- Buttons -->

                    <div class="col-12">

                        <div class="d-flex flex-wrap gap-2">

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                <i class="bi bi-search me-1"></i>
                                Apply Filters
                            </button>

                            <a
                                href="/faculty/attendance"
                                class="btn btn-outline-secondary"
                            >
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Reset
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Students -->

        <div class="col-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Total Students
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">
                                <%= attendanceSummary.totalStudents || 0 %>
                            </h3>

                        </div>

                        <div class="bg-primary-subtle text-primary rounded-circle p-3">
                            <i class="bi bi-people fs-5"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Classes -->

        <div class="col-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Total Classes
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">
                                <%= attendanceSummary.totalClasses || 0 %>
                            </h3>

                        </div>

                        <div class="bg-info-subtle text-info rounded-circle p-3">
                            <i class="bi bi-calendar3 fs-5"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Present -->

        <div class="col-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Present
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">
                                <%= attendanceSummary.totalPresent || 0 %>
                            </h3>

                        </div>

                        <div class="bg-success-subtle text-success rounded-circle p-3">
                            <i class="bi bi-check-circle fs-5"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Overall Percentage -->

        <div class="col-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <small class="text-muted">
                                Overall Attendance
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">

                                <%= Number(
                                    attendanceSummary.overallPercentage || 0
                                ).toFixed(2) %>%

                            </h3>

                        </div>

                        <div class="bg-warning-subtle text-warning rounded-circle p-3">
                            <i class="bi bi-percent fs-5"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ASSIGNED COURSES -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-book me-2"></i>

                Assigned Courses

            </h5>

        </div>


        <div class="card-body">

            <% if (facultyCourses.length > 0) { %>

                <div class="row g-3">

                    <% facultyCourses.forEach((course) => { %>

                        <div class="col-md-6 col-xl-4">

                            <div class="border rounded p-3 h-100">

                                <div class="d-flex justify-content-between align-items-start">

                                    <div>

                                        <div class="fw-semibold">
                                            <%= course.courseName || "Course" %>
                                        </div>

                                        <small class="text-muted">
                                            <%= course.courseCode || "N/A" %>
                                        </small>

                                    </div>

                                    <span class="badge bg-primary-subtle text-primary">
                                        Assigned
                                    </span>

                                </div>

                                <% if (course.department || course.program) { %>

                                    <div class="small text-muted mt-2">

                                        <% if (course.department) { %>
                                            <span>
                                                <%= course.department %>
                                            </span>
                                        <% } %>

                                        <% if (course.program) { %>
                                            <span>
                                                • <%= course.program %>
                                            </span>
                                        <% } %>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } else { %>

                <div class="text-center py-4 text-muted">

                    <i class="bi bi-book fs-1 d-block mb-2"></i>

                    <p class="mb-0">
                        No assigned courses found.
                    </p>

                </div>

            <% } %>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- ATTENDANCE TABLE -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                <div>

                    <h5 class="mb-1 fw-semibold">

                        <i class="bi bi-table me-2"></i>

                        Attendance Records

                    </h5>

                    <small class="text-muted">

                        Showing attendance for the selected filters.

                    </small>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <% if (attendanceRecords.length > 0) { %>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    #
                                </th>

                                <th>
                                    Student
                                </th>

                                <th>
                                    Student ID
                                </th>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Classes
                                </th>

                                <th>
                                    Present
                                </th>

                                <th>
                                    Absent
                                </th>

                                <th>
                                    Percentage
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <% attendanceRecords.forEach((record, index) => { %>

                                <%
                                    const totalClasses =
                                        Number(record.totalClasses) || 0;

                                    const presentClasses =
                                        Number(record.presentClasses) || 0;

                                    const absentClasses =
                                        Math.max(
                                            totalClasses - presentClasses,
                                            0
                                        );

                                    const percentage =
                                        typeof record.percentage !== "undefined"
                                            ? Number(record.percentage) || 0
                                            : (
                                                totalClasses > 0
                                                    ? (presentClasses / totalClasses) * 100
                                                    : 0
                                            );
                                %>

                                <tr>

                                    <td class="ps-4">
                                        <%= index + 1 %>
                                    </td>


                                    <td>

                                        <div class="fw-semibold">

                                            <%= record.studentName
                                                || record.student?.name
                                                || "N/A" %>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="text-muted">

                                            <%= record.studentId
                                                || record.student?.studentId
                                                || "N/A" %>

                                        </span>

                                    </td>


                                    <td>

                                        <div class="fw-semibold">

                                            <%= record.courseName
                                                || record.course?.courseName
                                                || "N/A" %>

                                        </div>

                                        <small class="text-muted">

                                            <%= record.courseCode
                                                || record.course?.courseCode
                                                || "" %>

                                        </small>

                                    </td>


                                    <td>

                                        <%= totalClasses %>

                                    </td>


                                    <td>

                                        <span class="badge bg-success-subtle text-success">

                                            <%= presentClasses %>

                                        </span>

                                    </td>


                                    <td>

                                        <span class="badge bg-danger-subtle text-danger">

                                            <%= absentClasses %>

                                        </span>

                                    </td>


                                    <td>

                                        <%
                                            let percentageClass =
                                                "bg-danger-subtle text-danger";

                                            if (percentage >= 75) {
                                                percentageClass =
                                                    "bg-success-subtle text-success";
                                            } else if (percentage >= 60) {
                                                percentageClass =
                                                    "bg-warning-subtle text-warning";
                                            }
                                        %>

                                        <span class="badge <%= percentageClass %>">

                                            <%= percentage.toFixed(2) %>%

                                        </span>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } else { %>

                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-calendar-x fs-1 text-muted"></i>

                    </div>

                    <h5 class="fw-semibold">
                        No Attendance Records Found
                    </h5>

                    <p class="text-muted mb-0">

                        Try changing the department, program, semester,
                        section, course or month filters.

                    </p>

                </div>

            <% } %>

        </div>

    </div>

</div>