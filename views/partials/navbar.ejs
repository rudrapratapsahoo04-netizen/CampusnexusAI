<nav class="navbar navbar-expand-lg campus-navbar sticky-top">

    <div class="container">

        <!-- ==========================================
             BRAND
        =========================================== -->
        <a
            class="navbar-brand campus-brand"
            href="/"
        >
            <img
                src="/images/logo3.png"
                alt="CampusNexus AI Logo"
                class="campus-logo"
            >

            <span class="campus-brand-text">
                <%= appName %>
            </span>
        </a>


        <!-- ==========================================
             MOBILE TOGGLE
        =========================================== -->
        <button
            class="navbar-toggler campus-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>


        <!-- ==========================================
             NAVIGATION
        =========================================== -->
        <div
            class="collapse navbar-collapse"
            id="mainNavbar"
        >

            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">

                <!-- HOME -->
                <li class="nav-item">
                    <a
                        class="nav-link campus-nav-link"
                        href="/"
                    >
                        <i class="bi bi-house-door me-1"></i>
                        Home
                    </a>
                </li>


                <!-- FEATURES -->
                <li class="nav-item">
                    <a
                        class="nav-link campus-nav-link"
                        href="/#features"
                    >
                        <i class="bi bi-grid-1x2 me-1"></i>
                        Features
                    </a>
                </li>


                <!-- ABOUT -->
                <li class="nav-item">
                    <a
                        class="nav-link campus-nav-link"
                        href="/#about"
                    >
                        <i class="bi bi-info-circle me-1"></i>
                        About
                    </a>
                </li>

            </ul>


            <!-- ==========================================
                 RIGHT SIDE
            =========================================== -->
            <div class="d-flex align-items-center gap-2 campus-actions">

                <% if (!currentUser) { %>

                    <!-- LOGIN -->
                    <a
                        href="/auth/login"
                        class="btn campus-login-btn"
                    >
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Login
                    </a>


                    <!-- REGISTER -->
                    <a
                        href="/auth/register"
                        class="btn campus-register-btn"
                    >
                        <i class="bi bi-person-plus me-1"></i>
                        Register
                    </a>


                <% } else { %>

                    <!-- USER -->
                    <span class="campus-user">

                        <span class="campus-user-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>

                        <span class="campus-user-name">
                            <%= currentUser.name %>
                        </span>

                    </span>


                    <!-- STUDENT -->
                    <% if (currentUser.role === "student") { %>

                        <a
                            href="/student/dashboard"
                            class="btn campus-dashboard-btn student-dashboard"
                        >
                            <i class="bi bi-speedometer2 me-1"></i>
                            Dashboard
                        </a>

                    <% } %>


                    <!-- FACULTY -->
                    <% if (currentUser.role === "faculty") { %>

                        <a
                            href="/faculty/dashboard"
                            class="btn campus-dashboard-btn faculty-dashboard"
                        >
                            <i class="bi bi-speedometer2 me-1"></i>
                            Dashboard
                        </a>

                    <% } %>


                    <!-- ADMIN -->
                    <% if (currentUser.role === "admin") { %>

                        <a
                            href="/admin/dashboard"
                            class="btn campus-dashboard-btn admin-dashboard"
                        >
                            <i class="bi bi-speedometer2 me-1"></i>
                            Dashboard
                        </a>

                    <% } %>


                    <!-- LOGOUT -->
                    <form
                        action="/auth/logout"
                        method="POST"
                        class="d-inline campus-logout-form"
                    >

                        <button
                            type="submit"
                            class="btn campus-logout-btn"
                        >
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout
                        </button>

                    </form>

                <% } %>

            </div>

        </div>

    </div>

</nav>


<style>

