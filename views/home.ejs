<script>

document.addEventListener("DOMContentLoaded", function () {

    const chatButton =
        document.getElementById("cnChatButton");

    const chatBox =
        document.getElementById("cnChatBox");

    const chatClose =
        document.getElementById("cnChatClose");

    const chatForm =
        document.getElementById("cnChatForm");

    const chatInput =
        document.getElementById("cnChatInput");

    const chatMessages =
        document.getElementById("cnChatMessages");

    const suggestions =
        document.querySelectorAll(
            ".cn-chat-suggestion"
        );


    /* =====================================================
       OPEN CHAT
    ===================================================== */

    function openChat() {

        chatBox.classList.add("cn-chat-open");

        chatBox.setAttribute(
            "aria-hidden",
            "false"
        );

        setTimeout(function () {

            chatInput.focus();

        }, 100);

    }


    /* =====================================================
       CLOSE CHAT
    ===================================================== */

    function closeChat() {

        chatBox.classList.remove(
            "cn-chat-open"
        );

        chatBox.setAttribute(
            "aria-hidden",
            "true"
        );

    }


    chatButton.addEventListener(
        "click",
        function () {

            if (
                chatBox.classList.contains(
                    "cn-chat-open"
                )
            ) {

                closeChat();

            } else {

                openChat();

            }

        }
    );


    chatClose.addEventListener(
        "click",
        closeChat
    );


    /* =====================================================
       ADD MESSAGE
    ===================================================== */

    function addMessage(
        message,
        type
    ) {

        const wrapper =
            document.createElement("div");

        wrapper.className =
            "cn-chat-message " + type;


        const bubble =
            document.createElement("div");

        bubble.className =
            "cn-chat-bubble";


        /*
         * textContent is intentionally used here.
         * This prevents user input from being treated
         * as HTML.
         */

        bubble.textContent =
            message;


        wrapper.appendChild(
            bubble
        );

        chatMessages.appendChild(
            wrapper
        );


        chatMessages.scrollTop =
            chatMessages.scrollHeight;

    }


    /* =====================================================
       NORMALIZE QUESTION
    ===================================================== */

    function normalizeQuestion(
        question
    ) {

        return question
            .toLowerCase()
            .trim()
            .replace(
                /[?!.,]/g,
                " "
            )
            .replace(
                /\s+/g,
                " "
            );

    }


    /* =====================================================
       LOCAL PREDEFINED KNOWLEDGE
    ===================================================== */

    function getLocalAnswer(
        question
    ) {

        const q =
            normalizeQuestion(
                question
            );


        /* ---------------------------------------------
           CAMPUSNEXUS
        --------------------------------------------- */

        if (
            q.includes("what is campusnexus") ||
            q.includes("what s campusnexus") ||
            q.includes("campusnexus kya hai") ||
            q.includes("campusnexus ke bare") ||
            q.includes("campusnexus ke baare") ||
            q.includes("campusnexus ke bare me") ||
            q.includes("campusnexus ke baare mein") ||
            q.includes("campusnexus ke bare mein")
        ) {

            return (
                "CampusNexus is a university campus "
                + "management platform that brings "
                + "students, faculty and university "
                + "services together in one place."
            );

        }


        /* ---------------------------------------------
           FEATURES
        --------------------------------------------- */

        if (
            q.includes("features") ||
            q.includes("feature") ||
            q.includes("what can campusnexus do") ||
            q.includes("campusnexus kya karta hai") ||
            q.includes("campusnexus me kya hai") ||
            q.includes("campusnexus mein kya hai")
        ) {

            return (
                "CampusNexus provides features such as "
                + "student management, timetable management, "
                + "attendance, digital services, campus services "
                + "and a local campus assistant."
            );

        }

        /* ---------------------------------------------
           STUDENTS
        --------------------------------------------- */

        if (
            q.includes("student") &&
            (
                q.includes("use") ||
                q.includes("management") ||
                q.includes("service")
            )
        ) {

            return (
                "Students can use CampusNexus for available "
                + "academic and campus services such as "
                + "attendance, timetable information, "
                + "digital services and other student-related "
                + "features provided by the platform."
            );

        }


        /* ---------------------------------------------
           FACULTY
        --------------------------------------------- */

        if (
            q.includes("faculty") ||
            q.includes("teacher") ||
            q.includes("professor")
        ) {

            return (
                "Faculty members can use CampusNexus for "
                + "available faculty features such as "
                + "attendance management, timetable-related "
                + "services and other faculty dashboard features."
            );

        }


        /* ---------------------------------------------
           TIMETABLE
        --------------------------------------------- */

        if (
            q.includes("timetable") ||
            q.includes("time table") ||
            q.includes("schedule") ||
            q.includes("class schedule")
        ) {

            return (
                "CampusNexus supports timetable management "
                + "based on university academic structures "
                + "such as department, program, semester "
                + "and section. show before register first then login "
            );

        }


        /* ---------------------------------------------
           ATTENDANCE
        --------------------------------------------- */

        if (
            q.includes("attendance") ||
            q.includes("present") ||
            q.includes("absent")
        ) {

            return (
                "CampusNexus includes attendance services. "
                + "Faculty can manage attendance, while "
                + "students can monitor their available "
                + "attendance information from the platform."
