            q === "hello" ||
            q === "hey" ||
            q.includes("namaste") ||
            q.includes("namaskar")
        ) {

            return (
                "Hello! 👋 I can help you with general "
                + "CampusNexus information and platform features."
            );

        }


        /* ---------------------------------------------
           THANK YOU
        --------------------------------------------- */

        if (
    q === "thanks" ||
    q === "thank you" ||
    q === "thankyou" ||
    q.includes("thank you very much") ||
    q.includes("shukriya") ||
    q.includes("dhanyavad")
) {

    return (
        "You're welcome! 😊 I'm here to help you understand CampusNexus."
