    /* =====================================================
       SEND QUESTION
    ===================================================== */

    function sendQuestion(
        question
    ) {

        const cleanQuestion =
            question.trim();


        if (!cleanQuestion) {
            return;
        }


        addMessage(
            cleanQuestion,
            "user"
        );


        const answer =
            getLocalAnswer(
                cleanQuestion
            );


        /*
         * Small delay only for natural UI feeling.
         * No API call is made.
         */

        setTimeout(
            function () {

                addMessage(
                    answer,
                    "bot"
                );

            },
            250
        );

    }


    /* =====================================================
       FORM SUBMIT
    ===================================================== */

    chatForm.addEventListener(
        "submit",
        function (event) {

            event.preventDefault();


            const question =
                chatInput.value.trim();


            if (!question) {
                return;
            }


            chatInput.value = "";


            sendQuestion(
                question
            );

        }
    );


    /* =====================================================
       SUGGESTION BUTTONS
    ===================================================== */

    suggestions.forEach(
        function (button) {

            button.addEventListener(
                "click",
                function () {

                    const question =
                        button.dataset.question;


                    if (!question) {
                        return;
                    }


                    sendQuestion(
                        question
                    );

                }
            );

        }
    );


    /* =====================================================
       ENTER KEY
    ===================================================== */

    chatInput.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Enter"
            ) {

                event.preventDefault();

                chatForm.dispatchEvent(
                    new Event("submit")
                );

            }

        }
    );

});

