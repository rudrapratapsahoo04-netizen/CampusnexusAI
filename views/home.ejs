) {

    return (
        "Goodbye! 👋 Feel free to come back whenever you want to know "
        + "more about CampusNexus."
    );

}

if (
    q.includes("campusnexus kis type ki university ke liye hai") ||
    q.includes("kis university ke liye bana hai") ||
    q.includes("kis type ke campus ke liye hai") ||
