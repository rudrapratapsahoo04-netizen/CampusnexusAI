<% layout("layouts/boilerplate") %>

<style>

/* =========================================================
   CAMPUSNEXUS HOME PAGE
   LOCAL PREDEFINED CHATBOT
========================================================= */

:root {
    --cn-blue: #2563eb;
    --cn-indigo: #4f46e5;
    --cn-purple: #7c3aed;
    --cn-pink: #ec4899;
    --cn-cyan: #06b6d4;
    --cn-green: #10b981;

    --cn-dark: #07152f;
    --cn-dark-2: #0b1f42;
    --cn-text: #0f172a;
    --cn-muted: #64748b;
    --cn-white: #ffffff;
}

html {
    scroll-behavior: smooth;
}

body {
    overflow-x: hidden;
}

.cn-section {
    position: relative;
    overflow: hidden;
}

/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes cnFadeLeft {
    from {
        opacity: 0;
        transform: translateX(-60px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes cnFadeRight {
    from {
        opacity: 0;
        transform: translateX(60px) scale(.95);
    }

    to {
        opacity: 1;
        transform: translateX(0) scale(1);
    }
}

@keyframes cnFloat {
    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-15px);
    }
}

@keyframes cnFloatSlow {
    0%,
    100% {
        transform: translate(0, 0);
    }

    50% {
        transform: translate(15px, -20px);
    }
}

@keyframes cnPulse {
    0% {
        transform: scale(1);
        opacity: .7;
    }

    50% {
        transform: scale(1.08);
        opacity: 1;
    }

    100% {
        transform: scale(1);
        opacity: .7;
    }
}

@keyframes cnShine {
    from {
        transform: translateX(-120%);
    }

    to {
        transform: translateX(120%);
    }
}

@keyframes cnChatOpen {
    from {
        opacity: 0;
        transform: translateY(20px) scale(.95);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* =========================================================
   HERO
========================================================= */

.cn-hero {
    min-height: 88vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 10% 20%,
            rgba(37, 99, 235, .15),
            transparent 30%
        ),
        radial-gradient(
            circle at 85% 20%,
            rgba(124, 58, 237, .16),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #f8fbff 0%,
            #eef4ff 50%,
            #f8f5ff 100%
        );
}

.cn-hero::before {
    content: "";

    position: absolute;

    width: 450px;
    height: 450px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            rgba(37, 99, 235, .08),
            rgba(236, 72, 153, .08)
        );

    top: -220px;
    left: -180px;

    animation:
        cnFloatSlow
        8s
        ease-in-out
        infinite;
}

.cn-hero::after {
    content: "";

    position: absolute;

    width: 320px;
    height: 320px;

    border-radius: 50%;

    background:
        rgba(6, 182, 212, .08);

    right: -120px;
    bottom: -120px;

    animation:
        cnFloatSlow
        10s
        ease-in-out
        infinite reverse;
}

.cn-hero-content {
    position: relative;
    z-index: 5;

    animation:
        cnFadeLeft
        .9s
        ease
        both;
}

.cn-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 9px 15px;

    border-radius: 50px;

    color: #1d4ed8;

    background:
        rgba(255, 255, 255, .85);

    border:
        1px solid
        rgba(37, 99, 235, .15);

    box-shadow:
        0 8px 25px
        rgba(37, 99, 235, .08);

    font-weight: 600;
}

.cn-hero-title {
    font-size: clamp(
        2.7rem,
        5vw,
        4.7rem
    );

    line-height: 1.04;

    letter-spacing: -2px;

    color: var(--cn-text);

    font-weight: 800;
}

.cn-gradient-text {
    background:
        linear-gradient(
            90deg,
            #2563eb,
            #4f46e5,
            #7c3aed,
            #ec4899
        );

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
}

.cn-hero-description {
    max-width: 650px;

    color: #475569;

    font-size: 1.08rem;

    line-height: 1.8;
}

.cn-primary-btn {
    position: relative;
    overflow: hidden;

    border: none;

    color: white;

    padding: 13px 23px;

    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #4f46e5,
            #7c3aed
        );

    box-shadow:
        0 12px 30px
        rgba(79, 70, 229, .28);

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}

.cn-primary-btn:hover {
    color: white;

    transform: translateY(-4px);

    box-shadow:
        0 18px 40px
        rgba(79, 70, 229, .38);
}

.cn-primary-btn::after {
    content: "";

    position: absolute;

    width: 70px;
    height: 100%;

    top: 0;
    left: -100px;

    background:
        rgba(255, 255, 255, .25);

    transform:
        skewX(-20deg);

    animation:
        cnShine
        4s
        infinite;
}

/* =========================================================
   HERO IMAGE
========================================================= */

.cn-hero-visual {
    position: relative;
    z-index: 4;

    animation:
        cnFadeRight
        1s
        .2s
        ease
        both;
}

.cn-campus-image {
    width: 100%;
    max-width: 650px;

    display: block;

    border-radius: 30px;

    object-fit: cover;

    box-shadow:
        0 35px 80px
        rgba(15, 23, 42, .18);

    border:
        8px solid
        rgba(255, 255, 255, .72);

    animation:
        cnFloat
        6s
        ease-in-out
        infinite;
}

.cn-floating-card {
    position: absolute;
    z-index: 5;

    padding: 14px 17px;

    border-radius: 17px;

    background:
        rgba(255, 255, 255, .94);

    backdrop-filter:
        blur(12px);

    box-shadow:
        0 15px 40px
        rgba(15, 23, 42, .13);

    border:
        1px solid
        rgba(255, 255, 255, .8);
}

.cn-ai-card {
    top: 4%;
    right: -4%;

    animation:
        cnFloat
        4s
        ease-in-out
        infinite;
}

.cn-campus-card {
    bottom: 4%;
    left: -5%;

    animation:
        cnFloat
        5s
        ease-in-out
        infinite
        reverse;
}

.cn-floating-icon {
    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #7c3aed
        );
}

/* =========================================================
   TRUST
========================================================= */

.cn-trust {
    display: flex;

    align-items: center;

    gap: 12px;

    margin-top: 28px;

    color: #64748b;

    font-size: .9rem;
}

.cn-avatar-stack {
    display: flex;
}

.cn-avatar-stack span {
    width: 34px;
    height: 34px;

    display: flex;

    align-items: center;
    justify-content: center;

    margin-left: -8px;

    border-radius: 50%;

    color: white;

    font-size: .75rem;

    font-weight: 700;

    border: 3px solid white;
}

.cn-avatar-stack span:first-child {
    margin-left: 0;
    background: #2563eb;
}

.cn-avatar-stack span:nth-child(2) {
    background: #7c3aed;
}

.cn-avatar-stack span:nth-child(3) {
    background: #ec4899;
}

.cn-avatar-stack span:nth-child(4) {
    background: #10b981;
}

/* =========================================================
   FEATURES
========================================================= */

.cn-features {
    position: relative;

    padding: 105px 0;

    color: white;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 5% 10%,
            rgba(37, 99, 235, .28),
            transparent 25%
        ),
        radial-gradient(
            circle at 90% 15%,
            rgba(124, 58, 237, .28),
            transparent 25%
        ),
        radial-gradient(
            circle at 80% 90%,
            rgba(6, 182, 212, .18),
            transparent 25%
        ),
        linear-gradient(
            135deg,
            #06132d,
            #0b1f42,
            #10164a
        );
}

.cn-features::before {
    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    border-radius: 50%;

    background:
        rgba(79, 70, 229, .16);

    left: -150px;
    bottom: -100px;

    filter: blur(30px);

    animation:
        cnPulse
        7s
        infinite;
}

.cn-features::after {
    content: "";

    position: absolute;

    width: 250px;
    height: 250px;

    border-radius: 50%;

    background:
        rgba(236, 72, 153, .12);

    right: -100px;
    top: 35%;

    filter: blur(35px);

    animation:
        cnPulse
        8s
        infinite
        reverse;
}

.cn-section-heading {
    position: relative;
    z-index: 2;

    text-align: center;
}

.cn-section-label {
    display: inline-block;

    padding: 7px 14px;

    border-radius: 50px;

    font-size: .75rem;

    letter-spacing: 2px;

    color: #93c5fd;

    background:
        rgba(37, 99, 235, .14);

    border:
        1px solid
        rgba(96, 165, 250, .28);
}

.cn-feature-title {
    font-size:
        clamp(2rem, 4vw, 3.2rem);

    font-weight: 800;

    margin-top: 15px;
}

.cn-feature-title span {
    background:
        linear-gradient(
            90deg,
            #60a5fa,
            #a78bfa,
            #f0abfc
        );

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
}

.cn-feature-card {
    position: relative;

    z-index: 2;

    height: 100%;

    padding: 28px;

    border-radius: 22px;

    background:
        linear-gradient(
            145deg,
            rgba(255, 255, 255, .09),
            rgba(255, 255, 255, .035)
        );

    border:
        1px solid
        rgba(148, 163, 184, .22);

    backdrop-filter:
        blur(14px);

    box-shadow:
        0 15px 45px
        rgba(0, 0, 0, .18);

    transition:
        transform .35s ease,
        border-color .35s ease,
        box-shadow .35s ease;
}

.cn-feature-card:hover {
    transform:
        translateY(-10px);

    border-color:
        rgba(96, 165, 250, .6);

    box-shadow:
        0 25px 55px
        rgba(0, 0, 0, .28);
}

.cn-feature-icon {
    width: 58px;
    height: 58px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 17px;

    color: white;

    font-size: 25px;

    margin-bottom: 22px;

    box-shadow:
        0 12px 25px
        rgba(0, 0, 0, .20);
}

.cn-feature-card:nth-child(1) .cn-feature-icon {
    background:
        linear-gradient(
            135deg,
            #2563eb,
            #6366f1
        );
}

.cn-feature-card:nth-child(2) .cn-feature-icon {
    background:
        linear-gradient(
            135deg,
            #ec4899,
            #f43f5e
        );
}

.cn-feature-card:nth-child(3) .cn-feature-icon {
    background:
        linear-gradient(
            135deg,
            #10b981,
            #06b6d4
        );
}

.cn-feature-card:nth-child(4) .cn-feature-icon {
    background:
        linear-gradient(
            135deg,
            #f59e0b,
            #f97316
        );
}

.cn-feature-card:nth-child(5) .cn-feature-icon {
    background:
        linear-gradient(
            135deg,
            #06b6d4,
            #2563eb
        );
}

.cn-feature-card:nth-child(6) .cn-feature-icon {
    background:
        linear-gradient(
            135deg,
            #7c3aed,
            #ec4899
        );
}

.cn-feature-card h5 {
    color: white;
    font-weight: 700;
}

.cn-feature-card p {
    color: #b8c5dc;
    line-height: 1.7;
}

.cn-feature-arrow {
    position: absolute;

    right: 22px;
    bottom: 22px;

    width: 36px;
    height: 36px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    color: white;

    background:
        rgba(99, 102, 241, .35);

    transition:
        transform .3s ease,
        background .3s ease;
}

.cn-feature-card:hover .cn-feature-arrow {
    transform:
        translateX(5px);

    background:
        rgba(99, 102, 241, .7);
}

/* =========================================================
   ABOUT
========================================================= */

.cn-about {
    padding: 100px 0;

    position: relative;

    background:
        linear-gradient(
            135deg,
            #f8fbff,
            #ffffff
        );
}

.cn-about-title {
    font-size:
        clamp(2rem, 4vw, 3.2rem);

    font-weight: 800;

    color: #0f172a;
}

.cn-about-title span {
    background:
        linear-gradient(
            90deg,
            #2563eb,
            #7c3aed
        );

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
}

.cn-about-text {
    color: #64748b;
    line-height: 1.8;
}

.cn-hierarchy {
    padding: 28px;

    border-radius: 28px;

    background:
        rgba(255, 255, 255, .9);

    border:
        1px solid
        #e2e8f0;

    box-shadow:
        0 25px 60px
        rgba(15, 23, 42, .08);
}

.cn-hierarchy-item {
    display: flex;

    align-items: center;

    gap: 14px;

    padding: 14px 16px;

    border-radius: 16px;

    background: white;

    border:
        1px solid
        #e5e7eb;

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}

.cn-hierarchy-item:hover {
    transform:
        translateX(7px);

    box-shadow:
        0 10px 25px
        rgba(15, 23, 42, .08);
}

.cn-hierarchy-icon {
    width: 43px;
    height: 43px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 12px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #7c3aed
        );
}

.cn-hierarchy-line {
    height: 22px;

    width: 2px;

    margin-left: 36px;

    background:
        linear-gradient(
            180deg,
            #2563eb,
            #7c3aed
        );

    opacity: .35;
}

/* =========================================================
   LOCAL CHATBOT
========================================================= */

.cn-chat-button {
    position: fixed;

    right: 25px;
    bottom: 25px;

    width: 64px;
    height: 64px;

    border: none;

    border-radius: 50%;

    display: flex;

    align-items: center;
    justify-content: center;

    color: white;

    font-size: 25px;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #7c3aed
        );

    box-shadow:
        0 15px 35px
        rgba(37, 99, 235, .35);

    cursor: pointer;

    z-index: 9999;

    transition:
        transform .25s ease,
        box-shadow .25s ease;
}

.cn-chat-button:hover {
    transform:
        translateY(-4px)
        scale(1.05);

    box-shadow:
        0 20px 45px
        rgba(37, 99, 235, .45);
}

.cn-chat-button .cn-online-dot {
    position: absolute;

    right: 2px;
    top: 2px;

    width: 13px;
    height: 13px;

    border-radius: 50%;

    background: #10b981;

    border: 2px solid white;
}

.cn-chat-box {
    position: fixed;

    right: 25px;
    bottom: 100px;

    width: 370px;
    max-width: calc(100vw - 30px);

    height: 520px;

    background: white;

    border-radius: 22px;

    box-shadow:
        0 25px 70px
        rgba(15, 23, 42, .25);

    border:
        1px solid
        #e2e8f0;

    overflow: hidden;

    display: none;

    flex-direction: column;

    z-index: 9998;
}

.cn-chat-box.cn-chat-open {
    display: flex;

    animation:
        cnChatOpen
        .25s
        ease
        both;
}

.cn-chat-header {
    padding: 17px 18px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #4f46e5,
            #7c3aed
        );

    display: flex;

    align-items: center;

    justify-content: space-between;
}

.cn-chat-title {
    display: flex;

    align-items: center;

    gap: 12px;
}

.cn-chat-avatar {
    width: 42px;
    height: 42px;

    border-radius: 13px;

    display: flex;

    align-items: center;
    justify-content: center;

    background:
        rgba(255,255,255,.18);

    font-size: 20px;
}

.cn-chat-header small {
    opacity: .8;
}

.cn-chat-close {
    border: none;

    background: transparent;

    color: white;

    font-size: 20px;

    cursor: pointer;
}

.cn-chat-messages {
    flex: 1;

    overflow-y: auto;

    padding: 18px;

    background:
        #f8fafc;
}

.cn-chat-message {
    display: flex;

    margin-bottom: 12px;
}

.cn-chat-message.bot {
    justify-content: flex-start;
}

.cn-chat-message.user {
    justify-content: flex-end;
}

.cn-chat-bubble {
    max-width: 82%;

    padding: 11px 14px;

    border-radius: 16px;

    font-size: .92rem;

    line-height: 1.55;
}

.cn-chat-message.bot .cn-chat-bubble {
    color: #334155;

    background: white;

    border:
        1px solid
        #e2e8f0;

    border-top-left-radius: 5px;
}

.cn-chat-message.user .cn-chat-bubble {
    color: white;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #4f46e5
        );

    border-top-right-radius: 5px;
}

.cn-chat-suggestions {
    padding: 10px 14px;

    display: flex;

    gap: 7px;

    overflow-x: auto;

    background: white;

    border-top:
        1px solid
        #e2e8f0;
}

.cn-chat-suggestion {
    flex-shrink: 0;

    border:
        1px solid
        #cbd5e1;

    background: white;

    color: #475569;

    border-radius: 50px;

    padding: 6px 11px;

    font-size: .75rem;

    cursor: pointer;

    transition:
        background .2s ease,
        color .2s ease;
}

.cn-chat-suggestion:hover {
    background: #eff6ff;
    color: #2563eb;
}

.logoai{
    width: 40px;
    height: 40px;
    border-radius: 50%;
}

.cn-chat-input-area {
    display: flex;

    align-items: center;

    gap: 8px;

    padding: 12px;

    background: white;

    border-top:
        1px solid
        #e2e8f0;
}

.mainailogo{
    width: 60px;
    height: 60px;
    border-radius: 50%;
}

.cn-chat-input {
    flex: 1;

    border:
        1px solid
        #cbd5e1;

    outline: none;

    border-radius: 13px;

    padding: 10px 13px;

    font-size: .9rem;
}

.cn-chat-input:focus {
    border-color: #2563eb;

    box-shadow:
        0 0 0 3px
        rgba(37, 99, 235, .08);
}

.cn-chat-send {
    width: 42px;
    height: 42px;

    border: none;

    border-radius: 12px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #2563eb,
            #7c3aed
        );

    cursor: pointer;
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 991px) {

    .cn-hero {
        padding: 80px 0;
    }

    .cn-hero-visual {
        margin-top: 55px;
    }

    .cn-floating-card {
        display: none;
    }
}

@media (max-width: 575px) {

    .cn-hero {
        padding: 60px 0;
    }

    .cn-hero-title {
        font-size: 2.35rem;
        letter-spacing: -1px;
    }

    .cn-hero-description {
        font-size: 1rem;
    }

    .cn-features {
        padding: 75px 0;
    }

    .cn-about {
        padding: 70px 0;
    }

    .cn-campus-image {
        border-radius: 20px;
        border-width: 5px;
    }

    .cn-chat-button {
        right: 18px;
        bottom: 18px;
    }

    .cn-chat-box {
        right: 15px;
        bottom: 90px;

        width: calc(100vw - 30px);

        height: 500px;
    }
}

</style>


<!-- =========================================================
     HERO
========================================================= -->

<section class="cn-hero cn-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="cn-hero-content">



                    <h1 class="cn-hero-title mt-4">

                        One Campus.

                        <br>

                        <span class="cn-gradient-text">
                            One Intelligent Platform.
                        </span>

                    </h1>

                    <p class="cn-hero-description mt-4">

                        CampusNexus brings students, faculty and
                        university administration together through
                        one modern campus management platform.

                    </p>

                    <div class="d-flex flex-wrap gap-3 mt-4">

                        <a
                            href="#features"
                            class="btn cn-primary-btn btn-lg"
                        >
                            Explore Platform
                            <i class="bi bi-arrow-right ms-2"></i>
                        </a>

                        <a
                            href="#about"
                            class="btn btn-outline-dark btn-lg px-4"
                        >
                            Learn More
                        </a>

                    </div>

                    <div class="cn-trust">

                        <div class="cn-avatar-stack">

                            <span>A</span>
